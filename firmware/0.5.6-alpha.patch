+/* Three complementary one-pole splits at 11.025 kHz. At unity their
+ * four components sum to the input sample exactly. */
+static const int eq_gain[16]={1453,1631,1830,2053,2303,2584,2900,3254,3651,4096,4596,5157,5786,6492,7284,8173};
+static int32_t eq_state[LAYER_COUNT][2][3];
+static int32_t layer_eq(unsigned layer,unsigned channel,int32_t input,uint32_t controls)
+{
+    const int coefficients[]={2740,10548,24576};
+    int32_t *state=eq_state[layer][channel];
+    int32_t lower=0;
+    int64_t sum=0;
+    for(unsigned band=0;band<3;++band){
+        state[band]+=(int32_t)(((int64_t)(input-state[band])*coefficients[band])>>15);
+        sum+=(int64_t)(state[band]-lower)*eq_gain[(controls>>(8*band))&15];
+        lower=state[band];
+    }
+    sum+=(int64_t)(input-lower)*eq_gain[(controls>>24)&15];
+    return (int32_t)(sum>>12);
+}
