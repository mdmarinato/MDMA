diff --git a/firmware/src/storage.c b/firmware/src/storage.c
new file mode 100644
index 0000000..1b13e63
--- /dev/null
+++ b/firmware/src/storage.c
@@ -0,0 +1,146 @@
+#include "storage.h"
+#include <stddef.h>
+#if !defined(MDMA_STORAGE_UNITY)
+#include <string.h>
+#endif
+
+#define MAGIC 0x534D444Du  /* "MDMS" */
+#define COMMIT_WORD 0xC0FFEE01u
+
+static uint32_t crc_update(uint32_t crc, const void *data, uint32_t len) {
+  const uint8_t *bytes = data;
+  for (uint32_t i = 0; i < len; i++) {
+    crc ^= bytes[i];
+    for (int k = 0; k < 8; k++) crc = crc & 1u ? 0xEDB88320u ^ (crc >> 1) : crc >> 1;
+  }
+  return crc;
+}
+
+uint32_t mdma_crc32(const void *data, uint32_t len) {
+  return ~crc_update(0xFFFFFFFFu, data, len);
+}
+
+static uint32_t slot_addr(const MdmaStore *s, uint8_t kind, uint8_t copy) {
+  return s->flash.base + (kind * MDMA_STORE_COPIES + copy) * s->flash.slot_bytes;
+}
+static void put32(uint8_t *p, uint32_t v) { for (int i = 0; i < 4; i++) p[i] = (uint8_t)(v >> (8 * i)); }
+static uint32_t get32(const uint8_t *p) { return p[0] | p[1] << 8 | p[2] << 16 | (uint32_t)p[3] << 24; }
+
+uint32_t mdma_store_capacity(const MdmaStore *s) {
+  return s->flash.slot_bytes - MDMA_STORE_HEADER - MDMA_STORE_COMMIT;
+}
+
+/* Returns the slot's sequence number, or 0 when the slot is not a valid copy. */
+static uint32_t check_slot(MdmaStore *s, uint8_t kind, uint8_t copy, uint32_t *len_out) {
+  uint8_t head[MDMA_STORE_HEADER], tail[4], payload[MDMA_STORE_PAGE];
+  const uint32_t addr = slot_addr(s, kind, copy);
+  if (!s->flash.read(s->flash.ctx, addr, head, sizeof head)) return 0;
+  if (get32(head) != MAGIC || (get32(head + 4) & 0xFFFFu) != MDMA_STORE_FORMAT ||
+      (get32(head + 4) >> 16) != kind) return 0;
+  const uint32_t seq = get32(head + 8), len = get32(head + 12), crc = get32(head + 16);
+  if (!seq || len > mdma_store_capacity(s)) return 0;
+  if (!s->flash.read(s->flash.ctx, addr + s->flash.slot_bytes - MDMA_STORE_COMMIT, tail, 4) ||
+      get32(tail) != COMMIT_WORD) return 0;
+  uint32_t computed = 0xFFFFFFFFu;
+  for (uint32_t offset = 0; offset < len;) {
+    const uint32_t left = len - offset;
+    const uint32_t chunk = left < sizeof payload ? left : sizeof payload;
+    if (!s->flash.read(s->flash.ctx, addr + MDMA_STORE_HEADER + offset, payload, chunk)) return 0;
+    computed = crc_update(computed, payload, chunk);
+    offset += chunk;
+  }
+  if (~computed != crc) return 0;
+  if (len_out) *len_out = len;
+  return seq;
+}
+
+bool mdma_store_init(MdmaStore *s, const MdmaFlash *flash) {
+  if (!flash || !flash->read || !flash->write || !flash->erase ||
+      flash->slot_bytes <= MDMA_STORE_HEADER + MDMA_STORE_COMMIT ||
+      flash->slot_bytes > MDMA_STORE_MAX_SLOT) return false;
+  memset(s, 0, sizeof *s);
+  s->flash = *flash;
+  s->next_seq = 1;
+  for (uint8_t kind = 0; kind < MDMA_STORE_KINDS; kind++)
+    for (uint8_t copy = 0; copy < MDMA_STORE_COPIES; copy++) {
+      const uint32_t seq = check_slot(s, kind, copy, NULL);
+      if (seq >= s->next_seq) s->next_seq = seq + 1;
+    }
+  return true;
+}
+
+bool mdma_store_request(MdmaStore *s, uint8_t kind, const void *data, uint32_t len) {
+  if (kind >= MDMA_STORE_KINDS || len > mdma_store_capacity(s) || (len && !data)) return false;
+  if (s->phase != S_IDLE && s->phase != S_ERASE) return false;  /* program in flight */
+  if (s->phase == S_ERASE && s->kind != kind) return false;
+  memcpy(s->stage, data, len);
+  s->stage_len = len;
+  s->kind = kind;
+  s->phase = S_ERASE;
+  return true;
+}
+
+bool mdma_store_pending(const MdmaStore *s) { return s->phase != S_IDLE; }
+
+MdmaStoreStep mdma_store_service(MdmaStore *s, bool quiet) {
+  if (s->phase == S_IDLE) return MDMA_STORE_IDLE;
+  if (!quiet) return MDMA_STORE_WAITING;
+  if (s->phase == S_ERASE) {
+    const uint32_t a = check_slot(s, s->kind, 0, NULL), b = check_slot(s, s->kind, 1, NULL);
+    /* Overwrite an invalid copy first, otherwise the older one; never the newest. */
+    s->copy = !a ? 0 : !b ? 1 : a < b ? 0 : 1;
+    s->seq = (a > b ? a : b) + 1;
+    if (s->seq < s->next_seq) s->seq = s->next_seq;
+    if (!s->flash.erase(s->flash.ctx, slot_addr(s, s->kind, s->copy))) {s->phase = S_IDLE; return MDMA_STORE_FAILED;}
+    s->offset = 0;
+    s->phase = S_PROGRAM;
+    return MDMA_STORE_BUSY;
+  }
+  const uint32_t addr = slot_addr(s, s->kind, s->copy);
+  if (s->phase == S_PROGRAM) {
+    /* The header goes with the first page; the payload follows page by page. */
+    uint8_t chunk[MDMA_STORE_PAGE];
+    uint32_t total = MDMA_STORE_HEADER + s->stage_len, n = total - s->offset;
+    if (n > MDMA_STORE_PAGE) n = MDMA_STORE_PAGE;
+    for (uint32_t i = 0; i < n; i++) {
+      const uint32_t at = s->offset + i;
+      if (at < MDMA_STORE_HEADER) {
+        uint8_t head[MDMA_STORE_HEADER];
+        put32(head, MAGIC);
+        put32(head + 4, MDMA_STORE_FORMAT | (uint32_t)s->kind << 16);
+        put32(head + 8, s->seq);
+        put32(head + 12, s->stage_len);
+        put32(head + 16, mdma_crc32(s->stage, s->stage_len));
+        chunk[i] = head[at];
+      } else chunk[i] = s->stage[at - MDMA_STORE_HEADER];
+    }
+    if (!s->flash.write(s->flash.ctx, addr + s->offset, chunk, n)) {s->phase = S_IDLE; return MDMA_STORE_FAILED;}
+    s->offset += n;
+    if (s->offset >= total) s->phase = S_COMMIT;
+    return MDMA_STORE_BUSY;
+  }
+  uint8_t word[4];
+  put32(word, COMMIT_WORD);
+  s->phase = S_IDLE;  /* commit is last; nothing runs after it */
+  if (!s->flash.write(s->flash.ctx, addr + s->flash.slot_bytes - MDMA_STORE_COMMIT, word, 4)) return MDMA_STORE_FAILED;
+  s->next_seq = s->seq + 1;
+  return MDMA_STORE_DONE;
+}
+
+bool mdma_store_load(MdmaStore *s, uint8_t kind, void *out, uint32_t cap, uint32_t *len) {
+  if (kind >= MDMA_STORE_KINDS) return false;
+  uint32_t la = 0, lb = 0;
+  const uint32_t a = check_slot(s, kind, 0, &la), b = check_slot(s, kind, 1, &lb);
+  if (!a && !b) return false;
+  const uint8_t copy = a > b ? 0 : 1;
+  const uint32_t n = copy ? lb : la;
+  if (n > cap) return false;
+  if (!s->flash.read(s->flash.ctx, slot_addr(s, kind, copy) + MDMA_STORE_HEADER, out, n)) return false;
+  if (len) *len = n;
+  return true;
+}
+
+bool mdma_store_valid(MdmaStore *s, uint8_t kind) {
+  return kind < MDMA_STORE_KINDS &&
+    (check_slot(s, kind, 0, NULL) || check_slot(s, kind, 1, NULL));
+}
diff --git a/firmware/src/storage.h b/firmware/src/storage.h
new file mode 100644
index 0000000..3731472
--- /dev/null
+++ b/firmware/src/storage.h
@@ -0,0 +1,66 @@
+/*
+ * MDMA storage: autosave and SAVE return points on FM-1 flash.
+ *
+ * Each kind (0 = autosave, 1..4 = SAVE points) owns two physical slots (A/B).
+ * A write goes to the older slot: erase, header + payload, commit word last.
+ * A slot is valid only if magic, commit word and payload CRC32 all match, so a
+ * power cut at any point leaves the previous copy intact.
+ *
+ * Writing never happens inside the audio path. mdma_store_request() only
+ * stages the payload; mdma_store_service() advances one bounded step (erase,
+ * one program page, or commit) and only when the caller reports quiet audio.
+ */
+#ifndef MDMA_STORAGE_H
+#define MDMA_STORAGE_H
+#include <stdbool.h>
+#include <stdint.h>
+
+#define MDMA_STORE_KINDS 5u         /* autosave + 4 return points */
+#define MDMA_STORE_COPIES 2u
+#define MDMA_STORE_PAGE 256u        /* program granularity per service call */
+#define MDMA_STORE_HEADER 20u
+#define MDMA_STORE_COMMIT 4u
+#define MDMA_STORE_MAX_SLOT 8192u   /* staging buffer size bound */
+#define MDMA_STORE_FORMAT 1u
+
+typedef struct {
+  bool (*read)(void *ctx, uint32_t addr, void *data, uint32_t len);
+  bool (*write)(void *ctx, uint32_t addr, const void *data, uint32_t len);
+  bool (*erase)(void *ctx, uint32_t addr);  /* erases one slot_bytes region */
+  void *ctx;
+  uint32_t base;        /* first byte of the storage region */
+  uint32_t slot_bytes;  /* multiple of the erase sector, <= MDMA_STORE_MAX_SLOT */
+} MdmaFlash;
+
+typedef enum {
+  MDMA_STORE_IDLE = 0,
+  MDMA_STORE_WAITING,   /* a request is pending and audio is not quiet */
+  MDMA_STORE_BUSY,      /* one step done, more to go */
+  MDMA_STORE_DONE,      /* committed on this call */
+  MDMA_STORE_FAILED
+} MdmaStoreStep;
+
+typedef struct {
+  MdmaFlash flash;
+  uint32_t next_seq;
+  uint8_t stage[MDMA_STORE_MAX_SLOT];
+  uint32_t stage_len;
+  uint8_t kind;
+  uint8_t copy;
+  uint32_t seq;
+  uint32_t offset;
+  enum {S_IDLE, S_ERASE, S_PROGRAM, S_COMMIT} phase;
+} MdmaStore;
+
+uint32_t mdma_crc32(const void *data, uint32_t len);
+bool mdma_store_init(MdmaStore *store, const MdmaFlash *flash);
+/* Stage a payload for kind. Replaces a request that has not started erasing. */
+bool mdma_store_request(MdmaStore *store, uint8_t kind, const void *data, uint32_t len);
+bool mdma_store_pending(const MdmaStore *store);
+MdmaStoreStep mdma_store_service(MdmaStore *store, bool quiet);
+/* Copy the newest valid payload of kind into out. Returns false if none. */
+bool mdma_store_load(MdmaStore *store, uint8_t kind, void *out, uint32_t cap, uint32_t *len);
+bool mdma_store_valid(MdmaStore *store, uint8_t kind);
+uint32_t mdma_store_capacity(const MdmaStore *store);
+
+#endif
diff --git a/tools/build.py b/tools/build.py
