diff --git a/firmware/src/mdma_lead.c b/firmware/src/mdma_lead.c
new file mode 100644
index 0000000..c21088b
--- /dev/null
+++ b/firmware/src/mdma_lead.c
@@ -0,0 +1,296 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* stable-v0.5 HAND/GHOST: polyBLEP saws, RBJ low-pass and exponential glide. */
+typedef struct { int32_t b0, a1, a2; } LeadCoefficients;
+#include "mdma_lead_tables.h"
+
+enum { LEAD_ONE = 1 << 24, LEAD_SILENCE = 1678, GHOST_CONTROL_FRAMES = 480 };
+
+typedef struct {
+    uint32_t phase[3], increment[3];
+    int32_t pitch, cutoff, gain, z1, z2;
+    int32_t target_pitch, target_cutoff;
+    uint32_t pitch_remainder, cutoff_remainder, gain_remainder;
+    LeadCoefficients filter;
+    int32_t linear_target, linear_step, linear_error, linear_fraction;
+    unsigned update, linear_remaining, linear_length;
+    bool bandpass;
+} LeadVoice;
+
+static LeadVoice lead_ghost = {.pitch = 21426141, .cutoff = 800 * 256};
+static LeadVoice lead_hand = {.pitch = 21426141, .cutoff = 800 * 256};
+enum { LEAD_EDIT_CUTOFF, LEAD_EDIT_RES, LEAD_EDIT_GLIDE, LEAD_EDIT_RATE, LEAD_EDIT_COUNT };
+static volatile uint32_t lead_edits; /* four signed detents, then four mode bits */
+static uint32_t lead_modes;
+static int32_t lead_edit_state[LEAD_EDIT_COUNT];
+static uint32_t lead_edit_gains[LEAD_EDIT_COUNT] = {65536u,65536u,65536u,65536u};
+static uint32_t lead_glide_ghost = 81157u, lead_glide_hand = 347771u;
+static unsigned lead_edit_frames, ghost_frames, ghost_degree;
+static unsigned lead_step, lead_alien_mix = 32768u;
+static unsigned ghost_sync_slot = ~0u;
+static uint64_t ghost_time_q24;
+static uint32_t ghost_time_remainder;
+static volatile uint32_t ghost_auto_q15 = 16384u;
+static volatile int32_t lead_macro_offset; /* relative to the live automatic brightness, as in stable */
+static int32_t lead_profile_brightness = -1;
+static uint32_t lead_profile_speed;
+static bool lead_alien;
+static uint32_t lead_hand_pitch, lead_hand_previous_pitch;
+static bool lead_hand_previous_gate;
+static int32_t lead_hand_brightness;
+
+static int32_t lead_edit_detent(uint32_t packed, unsigned parameter)
+{
+    const int32_t code = (int32_t)(packed >> (parameter * 6u) & 63u);
+    return code >= 32 ? code - 64 : code;
+}
+
+static int32_t lead_sin(uint32_t phase)
+{
+    const unsigned index = phase >> 24;
+    const unsigned fraction = (phase >> 16) & 255u;
+    return lead_sine[index] +
+           ((lead_sine[index + 1] - lead_sine[index]) * (int32_t)fraction >> 8);
+}
+
+static int32_t lead_cutoff(unsigned brightness)
+{
+    if (brightness >= 32768u) return (int32_t)lead_brightness[128];
+    const unsigned index = brightness >> 8, fraction = brightness & 255u;
+    return (int32_t)(lead_brightness[index] +
+                    ((lead_brightness[index + 1] - lead_brightness[index]) * fraction >> 8));
+}
+
+static unsigned lead_scale_degree(unsigned degree, unsigned config)
+{
+    static const uint8_t scale[2][7] = {{0,2,3,5,7,8,10}, {0,2,4,5,7,9,11}};
+    return 33u + 12u * (degree / 7u) + scale[(config >> 4) & 1u][degree % 7u] + (config & 15u);
+}
+
+static unsigned lead_unit_q15(int32_t value)
+{
+    return value < 0 ? 0u : value > 32768 ? 32768u : (unsigned)value;
+}
+
+static uint32_t lead_gain_at(int32_t value)
+{
+    const unsigned position = lead_unit_q15((value + 32768) / 2);
+    const unsigned index = position >> 8;
+    if (index >= 128u) return lead_edit_gain[128];
+    return lead_edit_gain[index] +
+           ((lead_edit_gain[index + 1] - lead_edit_gain[index]) * (position & 255u) >> 8);
+}
+
+static void lead_update_edits(void)
+{
+    if (!lead_edit_frames) {
+        const uint32_t packed = lead_edits;
+        lead_modes = packed >> 24;
+        for (unsigned i = 0; i < LEAD_EDIT_COUNT; ++i) {
