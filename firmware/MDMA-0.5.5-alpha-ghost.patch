+/* SPDX-License-Identifier: GPL-3.0-only */
+/* Sequenced melodic voices. Included after the groove phase and waveform helpers. */
+enum { GROOVE_DRUMS=1, GROOVE_BASS=2, GROOVE_PLUCK=4, GROOVE_LEAD=8,
+       GROOVE_AMB=16, GROOVE_SPARKS=32, GROOVE_ALL=63 };
+
+typedef struct {
+    int8_t pluck[16];
+    uint8_t pluck_density[16], pluck_spacing[16];
+    int8_t lead[16];
+    uint8_t lead_timbre[16], lead_phrase[16], amb_mode[16], amb_bright[16],
+            amb_density[16], amb_reverb[16], sparks_pitch[16], sparks_density[16], sparks_pan[16];
+} MelodyPattern;
+#include "mdma_melody_patterns.h"
+
+typedef struct {
+    uint32_t phase, inc;
+    int32_t amp;
+} MelodyVoice;
+
+static MelodyVoice pluck_voices[2], spark_voice;
+static uint32_t amb_phase[3], amb_inc[3], amb_drift;
+static int32_t amb_amp;
+static unsigned pluck_index, amb_bright, spark_pan;
+static unsigned pluck_delay;
+static MelodyVoice pluck_pending;
+
+static void melody_step(unsigned scene, uint32_t patterns, uint32_t origins, unsigned step,
+                        unsigned position, unsigned step_frames, unsigned enabled)
+{
+    const MelodyPattern *pluck = &melody_patterns[city_pattern_bank(pattern_origin(origins, 2))][scene][(patterns >> 6) & 7u];
+    const MelodyPattern *amb = &melody_patterns[city_pattern_bank(pattern_origin(origins, 4))][scene][(patterns >> 12) & 7u];
+    const MelodyPattern *sparks = &melody_patterns[city_pattern_bank(pattern_origin(origins, 5))][scene][(patterns >> 15) & 7u];
+    if (enabled & GROOVE_PLUCK) {
+        const bool buzios = !pattern_origin(origins, 2) && !((patterns >> 6) & 7u);
+        const int note = buzios ? city_buzios_pluck[position & 31u] : pluck->pluck[step];
+        if (note >= 0) {
+            const unsigned delay = buzios ? 0u : pluck->pluck_spacing[step] * step_frames / 5u;
+            const unsigned pitch = buzios ? lead_scale_degree((unsigned)note, harmonic_controls)
+                : groove_pitch(33u - 9u + (unsigned)note) + 9u;
+            const int32_t volume = buzios ? (position % 8u == 5u ? 1050 : 1400)
+                : 900 + 100 * (pluck->pluck_density[step] & 7u);
+            const MelodyVoice note_voice = {0, groove_inc(pitch), volume};
+            if (delay) { pluck_pending = note_voice; pluck_delay = delay; }
+            else pluck_voices[pluck_index++ & 1u] = note_voice;
+        }
+    }
+    if (enabled & GROOVE_AMB) {
+        static const uint8_t triads[4][3] = {{0,3,7},{0,5,7},{3,7,10},{0,3,10}};
+        for (unsigned i = 0; i < 3; ++i)
+            amb_inc[i] = groove_inc(groove_pitch(24u + triads[amb->amb_mode[step] & 3u][i]));
+        amb_bright = amb->amb_bright[step];
+    }
+    if ((enabled & GROOVE_SPARKS) && sparks->sparks_density[step]) {
+        spark_voice = (MelodyVoice){0, (uint32_t)(((uint64_t)groove_inc(lead_scale_degree(sparks->sparks_pitch[step], harmonic_controls)) * 23831u) >> 16),
+                                   500 + 4 * (int32_t)sparks->sparks_density[step]};
+        spark_pan = sparks->sparks_pan[step] <= 127 ? sparks->sparks_pan[step] : 127;
+    }
+}
+
+static void melody_sample(unsigned enabled, int32_t *left, int32_t *right)
+{
+    if (!(enabled & GROOVE_PLUCK)) pluck_delay = 0;
+    if (pluck_delay && !--pluck_delay) pluck_voices[pluck_index++ & 1u] = pluck_pending;
+    int32_t pl=0,pr=0;
+    for (unsigned i = 0; i < 2; ++i) {
+        MelodyVoice *voice = &pluck_voices[i];
+        if (!voice->amp) continue;
+        voice->phase += voice->inc;
+        const int32_t wave = groove_triangle(voice->phase) +
+                             (groove_triangle(voice->phase * 2u) >> 2);
+        const int32_t sample = (wave * voice->amp) >> 15;
+        pl += i ? sample >> 1 : sample;
+        pr += i ? sample : sample >> 1;
+        voice->amp -= 1 + (voice->amp >> 10);
+    }
+    qa_layer(2,pl,pr,left,right);
+    const int32_t amb_target = enabled & GROOVE_AMB ? 360 + (int32_t)(amb_bright >> 1) : 0;
+    if (amb_amp < amb_target) ++amb_amp;
+    else if (amb_amp > amb_target) --amb_amp;
+    if (amb_amp) {
+        amb_drift += 17000u;
+        const int32_t drift = groove_triangle(amb_drift) >> 6;
+        int32_t notes[3];
+        for (unsigned i = 0; i < 3; ++i) {
+            amb_phase[i] += (uint32_t)((int32_t)amb_inc[i] + drift * (int32_t)i);
+            const int32_t wave = groove_triangle(amb_phase[i]) +
+                ((groove_triangle(amb_phase[i] * 2u) * (int32_t)amb_bright) >> 11);
+            notes[i] = (wave * amb_amp) >> 15;
+        }
+        qa_layer(4,notes[0]+notes[1]+(notes[2]>>1),notes[0]+notes[2]+(notes[1]>>1),left,right);
+    }
+    if (spark_voice.amp) {
+        spark_voice.phase += spark_voice.inc;
+        const int32_t wave = groove_triangle(spark_voice.phase) +
+                             (groove_triangle(spark_voice.phase * 3u) >> 1);
+        const int32_t sample = (wave * spark_voice.amp) >> 15;
+        qa_layer(5,sample*(int32_t)(127u-spark_pan)>>7,sample*(int32_t)spark_pan>>7,left,right);
+        spark_voice.amp -= 1 + (spark_voice.amp >> 8);
+    }
+}
+
+static bool melody_sounding(void)
+{
+    return pluck_voices[0].amp || pluck_voices[1].amp ||
+           amb_amp || spark_voice.amp;
+}
