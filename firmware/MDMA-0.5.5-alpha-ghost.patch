+static void panel_seq(void)
+{
+    const GrooveEdit *edit = &groove_edits[active_city];
+    const unsigned variation = layer_variation[active_city][seq_layer];
+    const unsigned origin = layer_origin[active_city][seq_layer];
+    const uint16_t colour = layer_ink[seq_layer];
+    panel_header(scene_names[edit->scene], scene_ink[edit->scene]);
+    panel_variation_pixels(8, 64, variation, colour);
+    char context[18] = "> V1";
+    context[3] = (char)('1' + variation);
+    if (seq_layer) {
+        memcpy(context + 4, " / ", 3);
+        memcpy(context + 7, layer_label[seq_layer], panel_text_length(layer_label[seq_layer]) + 1);
+    }
+    panel_text(62, 68, 1, C_WHITE, ALIGN_LEFT, context);
+    if (seq_layer) return;
+
+    panel_fill_banner(232, 68, ALIGN_RIGHT);
+    const unsigned slot = edit->scene + 4u * variation;
+    const GroovePattern *groove = &groove_patterns[city_pattern_bank(origin)][edit->scene][variation];
+    for (unsigned lane = 0; lane < 6; ++lane) {
+        const uint16_t mask = groove->hit[lane] ^ drum_edit_mask(active_city, lane, slot);
+        const int y = 78 + 23 * lane;
+        panel_row(y, 21, lane == drum_lane, colour);
+        panel_text(14, y + 12, 1, lane == drum_lane ? C_WHITE : PANEL_OFF, ALIGN_LEFT, drum_names[lane]);
+        for (unsigned step = 0; step < 16; ++step)
+            cv_rect(49 + 1115 * step / 100, y + 4, 8, 10, mask & (1u << step) ? PANEL_HIT : PANEL_DIM);
+        if (visible_playhead < 16u)
+            cv_rect(49 + 1115 * visible_playhead / 100, y + 15, 8, 2, colour);
+    }
+}
+
+static void panel_scl(void)
+{
+    static const unsigned scale_mask[2] = {
+        (1u<<0)|(1u<<2)|(1u<<3)|(1u<<5)|(1u<<7)|(1u<<8)|(1u<<10),
+        (1u<<0)|(1u<<2)|(1u<<4)|(1u<<5)|(1u<<7)|(1u<<9)|(1u<<11)
+    };
+    const unsigned root = city_tonic[active_city], major = city_major[active_city];
+    const uint16_t colour = panel_city_colour(active_city);
+    panel_header("ROOT NOTE", colour);
+    char heading[20];
+    const unsigned prefix = panel_text_length(note_names[root]);
+    memcpy(heading, note_names[root], prefix);
+    memcpy(heading + prefix, major ? " NATURAL MAJOR" : " NATURAL MINOR", 15);
+    panel_text(120, 124, 2, colour, ALIGN_CENTER, heading);
+    for (unsigned i = 0; i < 12; ++i) {
+        const int x = 9 + 224 * i / 12;
+        const bool in_scale = scale_mask[major] & (1u << ((i + 12u - root) % 12u));
+        cv_rect(x, 140, 16, 26, i == root ? C_WHITE : in_scale ? colour : PANEL_DIM);
+        panel_text(x + 8, 181, 1, i == root ? C_WHITE : PANEL_OFF, ALIGN_CENTER, note_names[i]);
+    }
+}
+
+static void panel_dial(int x, int y, unsigned value, uint16_t colour)
+{
+    int px = 0, py = 0;
+    const unsigned end = (value * 32u + 63u) / 127u;
+    for (unsigned i = 0; i <= 32; ++i) {
+        const uint32_t angle = 0x60000000u + i * 0x06000000u;
+        const int dx = (lead_sin(angle + 0x40000000u) * 10) >> 15;
+        const int dy = (lead_sin(angle) * 10) >> 15;
+        if (i) cv_line(x + px, y + py, x + dx, y + dy,
+                       ((i <= 16u && i > end) || (i > 16u && i <= end)) ? colour : PANEL_DIM);
+        px = dx;
+        py = dy;
+        if (i == end) cv_rect(x + 2 * dx / 3, y + 2 * dy / 3, 2, 2, colour);
+    }
+}
+
+static void panel_edit(void)
+{
+    const unsigned layer = selected_layer;
+    const uint16_t colour = layer_ink[layer];
+    const GrooveEdit *edit = &groove_edits[active_city];
+    char title[18] = "EDIT > ";
+    memcpy(title + 7, layer_label[layer], panel_text_length(layer_label[layer]) + 1u);
+    panel_header(title, colour);
+    const unsigned count = panel_edit_count(layer);
+    if (!count) {
+        panel_row(60, 32, false, colour);
+        panel_text(14, 80, 1, PANEL_OFF, ALIGN_LEFT, "USE HOME FOR MIX CONTROLS");
+    }
+    for (unsigned i = 0; i < count; ++i) {
+        const int y = 60 + 37 * (int)i;
+        const bool selected = i == edit_row;
+        static const char *const lead_names[] = {"CUTOFF", "RES", "GLIDE", "GHOST RATE"};
+        static const char *const lead_types[][2] = {
+            {"LOW PASS", "BAND PASS"}, {"CLASSIC", "SOFT"}, {"SMOOTH", "LINEAR"}, {"FREE", "SYNC"}
+        };
+        const uint32_t lead = *panel_lead_edits();
+        const char *label = layer == 3 ? lead_names[i] : i == 0 ? "LEVEL" : "CUTOFF";
+        const char *mode = layer == 3 ? lead_types[i][(lead >> (24u + i)) & 1u]
+            : i == 1 ? "LOW PASS" : "GAIN";
+        const unsigned value = layer == 3 ? (unsigned)(lead_edit_detent(lead, i) + 20) * 127u / 40u
+            : (layer == 0 ? edit->drum : i == 0 ? edit->bass : edit->tone) * 127u / 100u;
+        panel_row(y, 32, selected, colour);
+        panel_text(14, y + 20, 1, selected ? colour : C_WHITE, ALIGN_LEFT, label);
+        panel_text(190, y + 20, 1, selected ? colour : PANEL_OFF, ALIGN_RIGHT, mode);
+        panel_dial(216, y + 16, value, colour);
+    }
+    if (fill_active) panel_fill_banner(8, 220, ALIGN_LEFT);
+    panel_footer(220, true);
+}
+
+static void panel_global(void)
+{
+    static const char *const names[] = {"BPM RELEASE","SWING EVERYTHING","BASS MODE","LEAD MODE",
+        "GENERATE RANDOM CITY","DELETE CURRENT CITY","FACTORY RESET","CLOCK"};
+    static const char *const sources[] = {"INTERNAL","USB","TRS"};
+    const uint16_t colour = panel_city_colour(active_city);
+    panel_header("GLOBAL STTNGS", colour);
+    if (global_confirmation) {
+        const bool notice = global_confirmation <= GLO_DIALOG_FACTORY;
+        const char *prompt = global_confirmation == GLO_DIALOG_LIMIT ? "8 CITIES MAX" :
+            global_confirmation == GLO_DIALOG_FACTORY ? "CANNOT DELETE FACTORY CITY" :
+            global_confirmation == GLO_CREATE + 1u ? "GENERATE RANDOM CITY?" :
+            global_confirmation == GLO_DELETE + 1u ? "DELETE CURRENT CITY?" :
+            reset_all_cities ? "RESET ALL CITIES?" : "RESET CURRENT CITY?";
+        panel_row(82, 104, true, colour);
+        panel_text(120, 124, 1, colour, ALIGN_CENTER, prompt);
+        if (global_confirmation == GLO_DELETE + 1u)
+            panel_text(120, 144, 1, C_WHITE, ALIGN_CENTER, panel_city_name(active_city));
+        if (global_confirmation == GLO_DIALOG_LIMIT)
+            panel_text(120, 144, 1, C_WHITE, ALIGN_CENTER, "DELETE ONE TO GENERATE");
+        panel_text(120, 164, 1, C_WHITE, ALIGN_CENTER, notice ? "OCT- BACK" : "OCT+ CONFIRM * OCT- CANCEL");
+        return;
+    }
+    char swing[6];
+    char *percent = panel_uint(swing, city_swing[active_city]);
+    *percent++ = '%';
+    *percent = 0;
+    const char *const values[] = {tempo_manual[active_city] ? "MANUAL" : "AUTO", swing,
+        city_bass_alien[active_city] ? "ALIEN" : "HOLD", city_lead_alien[active_city] ? "ALIEN" : "HOLD",
+        "", "", reset_all_cities ? "ALL CITIES" : "CURRENT CITY", sources[qa_source]};
+    for (unsigned i = 0; i < GLO_COUNT; ++i) {
+        const int y = 46 + 23 * (int)i;
+        const bool selected = global_row == i;
+        panel_row(y, 20, selected, colour);
+        if (selected) panel_text(14, y + 14, 1, colour, ALIGN_LEFT, ">");
+        panel_text(24, y + 14, 1, selected ? colour : C_WHITE, ALIGN_LEFT, names[i]);
+        panel_text(226, y + 14, 1, selected ? colour : PANEL_OFF, ALIGN_RIGHT, values[i]);
+    }
+}
+
+static void panel_save(void)
+{
+    const uint16_t colour = panel_city_colour(active_city);
+    panel_header("SAVE", colour);
+    if (save_confirm || qa_save_pending) {
+        panel_row(82, 104, true, colour);
+        panel_text(120, 124, 1, colour, ALIGN_CENTER, save_confirm ? "SAVE ALL CITIES?" : "SAVING");
+        panel_text(120, 144, 1, C_WHITE, ALIGN_CENTER, save_confirm ? "SAVE TO DEVICE" : "WAITING FOR SILENCE");
+        if (save_confirm) panel_text(120, 164, 1, C_WHITE, ALIGN_CENTER, "OCT+ CONFIRM * OCT- CANCEL");
+    } else {
+        panel_row(52, 20, false, colour);
+        panel_text(14, 66, 1, C_WHITE, ALIGN_LEFT, "SCOPE");
+        panel_text(226, 66, 1, colour, ALIGN_RIGHT, "ALL CITIES");
+        panel_row(77, 20, true, colour);
+        panel_text(14, 91, 1, colour, ALIGN_LEFT, "> SAVE TO DEVICE");
+    }
+    if (panel_notice) panel_text(120, 220, 1, colour, ALIGN_CENTER, panel_notice);
+}
+
+static void panel_set_notice(const char *text)
+{
+    panel_notice = text;
+    panel_notice_until = fm1_ms + 4000;
+    if (page == PAGE_SAVE) panel_dirty = true;
+}
+
+static unsigned panel_peak_width(unsigned layer)
+{
+    static const uint8_t gain[] = {5,25,16,80,30,12};
+    if (!(qa_ready_mask & (1u << layer))) return 0;
+    const unsigned level = panel_pcm_peaks[layer] * gain[layer] * 55u / 327680u;
+    return level > 55u ? 55u : level;
+}
+
+static unsigned panel_seq_playhead(void)
+{
+    const unsigned pos = panel_drum_position;
+    const unsigned slot = groove_edits[active_city].scene + 4u * layer_variation[active_city][0];
+    return (groove_enabled & GROOVE_DRUMS) && !seq_layer && pos >> 4 == slot ? pos & 15u : 16u;
+}
+
+static void panel_live(void)
+{
+    if (page == PAGE_HOME || page == PAGE_FX) {
+        for (unsigned i = 0; i < LAYER_COUNT; ++i) {
+            const unsigned layer = layer_order[i], width = panel_peak_width(layer);
+            if (width == visible_levels[layer]) continue;
+            visible_levels[layer] = width;
+            cv_begin(55, 6, PANEL_DIM);
+            cv_rect(0, 0, width, 6, layer_ink[layer]);
+            cv_blit(171, 68 + 22 * i);
+        }
+    } else if (page == PAGE_SEQ && !seq_layer) {
+        const unsigned head = panel_seq_playhead();
+        if (head == visible_playhead) return;
+        for (unsigned lane = 0; lane < 6; ++lane) {
+            const unsigned y = 93 + 23 * lane;
+            if (visible_playhead < 16u) {
+                cv_begin(8, 2, PANEL_ROW);
+                cv_blit(49 + 1115 * visible_playhead / 100, y);
+            }
+            if (head < 16u) {
+                cv_begin(8, 2, layer_ink[0]);
+                cv_blit(49 + 1115 * head / 100, y);
+            }
+        }
+        visible_playhead = head;
+    }
+}
+
+static void panel_render(void)
+{
+    static unsigned last_fill, last_bpm, last_master, last_transport;
+    static uint32_t full_at;
+    static bool initial_draw = true, last_saving;
+    const unsigned fill = fill_active ? 2u : fill_queued ? 1u : 0u;
+    const unsigned bpm = qa_source && qa_running ? qa_external_bpm : 0;
+    const unsigned master = panel_master_level();
+    const unsigned transport = qa_running;
+    const bool live_due = fm1_ms - panel_live_at >= 40u;
+    if (panel_notice && !qa_save_pending && (int32_t)(fm1_ms - panel_notice_until) >= 0) {
+        panel_notice = 0;
+        if (page == PAGE_SAVE) panel_dirty = true;
+    }
+    if (fill != last_fill || bpm != last_bpm || transport != last_transport ||
+        (page == PAGE_SAVE && qa_save_pending != last_saving))
+        panel_dirty = true;
+    const bool refresh_header = live_due && master != last_master;
+    if (!panel_dirty && !refresh_header) {
+        if (live_due) {
+            panel_live_at = fm1_ms;
+            panel_live();
+        }
+        return;
+    }
+
+    const bool header_only = !panel_dirty;
+    if (!initial_draw && !header_only && fm1_ms - full_at < 25u) return;
+    initial_draw = false;
+    if (!header_only) {
+        full_at = fm1_ms;
+    }
+    panel_dirty = false;
+    last_fill = fill;
+    last_bpm = bpm;
+    last_master = master;
+    last_transport = transport;
+    last_saving = qa_save_pending;
+    panel_live_at = fm1_ms;
+    if (!header_only) {
+        for (unsigned layer = 0; layer < LAYER_COUNT; ++layer)
+            visible_levels[layer] = panel_peak_width(layer);
+        visible_playhead = panel_seq_playhead();
+    }
+
+    const unsigned rows = header_only ? 38u : 240u;
+    cv_begin(240, rows, PANEL_BG);
+    panel_box(0, 0, 240, 240, panel_city_colour(active_city));
+    switch (page) {
+    case PAGE_HOME: case PAGE_FX: panel_home(); break;
+    case PAGE_STAGE: panel_stage(); break;
+    case PAGE_SEQ: panel_seq(); break;
+    case PAGE_EDIT: panel_edit(); break;
+    case PAGE_GLO: panel_global(); break;
+    case PAGE_SAVE: panel_save(); break;
+    case PAGE_SCL: panel_scl(); break;
+    }
+    for (unsigned row = 0; row < rows; row += 40u)
+        lcd_blit(0, row, 240, rows - row < 40u ? rows - row : 40u, cv_px + 240u * row);
+}
