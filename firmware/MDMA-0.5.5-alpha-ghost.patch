+    {"CANUDOS", 667148, 133, 2, 11, 56589, 23891, 21307320, {-3, -3, 2, -5}},
+    {"TROIA", 737397, 126, 11, 11, 64907, 18663, 24564614, {-1, -2, -2, -4}},
+    {"CHORNOBIL", 807646, 128, 7, 11, 57257, 17841, 17270585, {3, -2, -4, 3}},
+    {"KOSOVO", 877895, 133, 2, 13, 34108, 18962, 12891651, {-5, -1, 0, 2}},
+    {"PANGEIA", 948144, 127, 0, 12, 20217, 22882, 20758549, {1, 0, -2, 0}},
+    {"LEOPOLDINA", 1018393, 125, 7, 8, 52507, 14008, 16232668, {-4, 4, 1, -4}},
+    {"S`O PAULO", 1088642, 129, 10, 7, 46715, 19103, 15975765, {4, 4, 2, -3}},
+};
+static const int8_t city_alien_bass[32] = {0, -1, -1, 0, -1, -1, 2, 4, -1, -1, 0, -1, -1, -1, 4, -1, 0, -1, -1, 0, -1, -1, 2, 4, -1, -1, 0, -1, -1, -1, 2, -1};
+#define CITY_ALIEN_SLIDES 0x800080u
+static const uint8_t city_hold_bass[] = {0, 2, 4, 2};
+#define CITY_HOLD_LENGTH 32u
+static const int8_t city_buzios_pluck[32] = {-1, -1, 0, -1, -1, 2, -1, -1, 4, -1, -1, -1, -1, 7, -1, -1, -1, -1, 7, -1, -1, 4, -1, -1, 2, -1, -1, -1, -1, 0, -1, -1};
diff --git a/firmware/src/mdma_groove.c b/firmware/src/mdma_groove.c
