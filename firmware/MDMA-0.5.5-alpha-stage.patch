+/* SPDX-License-Identifier: GPL-3.0-only */
+const fs = require('node:fs');
+const vm = require('node:vm');
+
+const html = fs.readFileSync(process.argv[2], 'utf8');
+const engine = html.match(/<script[^>]+id="eng"[^>]*>([\s\S]*?)<\/script>/)[1];
+const marker = '  return E;';
+if (!engine.includes(marker)) throw new Error('Gerador da stable-v0.5 não encontrado');
+const moduleBox = {exports: {}};
+const source = engine.replace(marker, `
+  E.patternFactory = { names: GENERATED_NAMES, alienBass: ALIEN_BASS, pluckIntro: buziosPluck,
+    profile(kit){applyKit(kit);return this.capture()},
+    capture(){return {D:{...D},P:{...P},edits:JSON.parse(JSON.stringify(editTargets))}},
+    holdBass: HD, holdLength: defaults.hlm,
+    factory(scene, variation, kit, layer) {
+      // The INTRO percussion also reads P.seed through buildOld().
+      P.seed = defaults.seed;
+      return buildFull(scene, variation, kit, layer, P.seed);
+    },
+    generated(name, seed) {
+      generatedCities = [{ name, seed }];
+      loadCity(3);
+      return {
+        bpm: P.bpm, tonic: P.key, swing: P.swing,
+        profile:this.capture(),lead: MC.lead.slice(), edits: editTargets.lead.slice()
+      };
+    },
+    pattern(scene, variation, layer) {
+      P.bank = scene;
+      const name = generatorOrder[layer];
+      P.vari[name] = variation;
+      return patternFor(name);
+    }
+  };
+  return E;`);
+vm.runInThisContext('(function(module){' + source + '\n})')(moduleBox);
+const moduleBoxInstance=moduleBox.exports(44100).patternFactory;
+const {factory, names, generated, pattern, alienBass, pluckIntro, holdBass, holdLength} = moduleBoxInstance;
+const recipes = names.map((name, i) => {
+  const recipeSeed = 34907 + 70249 * i;
+  return {name, seed: recipeSeed, ...generated.call(moduleBoxInstance,name, recipeSeed)};
+});
+const rows = ['kick', 'hat', 'open', 'clap', 'perc', 'noise'];
+const mask = values => values.reduce((bits, value, step) => bits | (value ? 1 << step : 0), 0);
+const literal = values => '{' + values.join(', ') + '}';
+const table = (name, type, row) => {
+  const cities = Array.from({length: 3 + recipes.length}, (_, city) => {
+    const recipe = recipes[city - 3];
+    if (recipe) generated.call(moduleBoxInstance,recipe.name, recipe.seed);
+    const scenes = Array.from({length: 4}, (_, scene) => {
+      const variations = Array.from({length: 8}, (_, variation) =>
+        '            ' + row(layer => recipe ? pattern(scene, variation, layer)
+          : factory(scene, variation, [0, 2, 1][city], layer)));
+      return '        {\n' + variations.join(',\n') + '\n        }';
+    });
+    return '    {\n' + scenes.join(',\n') + '\n    }';
+  });
+  return 'static const ' + type + ' ' + name + '[' + cities.length + '][4][8] = {\n' + cities.join(',\n') + '\n};\n';
+};
+const header = '/* Generated from stable-v0.5.html by tools/mdma_patterns.cjs. */\n';
+const drums = table('groove_patterns', 'GroovePattern', get => {
+  const drum = get(0), bass = get(1);
+  const notes = bass.bass_notes.map((note, i) => note < 0 ? note : note + bass.bass_octave[i] * 12);
+  return literal([literal(rows.map(row => mask(drum[row]))), literal(notes),
+    mask(bass.bass_accent), mask(bass.bass_slide)]);
+});
+const melody = table('melody_patterns', 'MelodyPattern', get => {
+  const pluck = get(2), lead = get(3), amb = get(4), sparks = get(5);
+  return literal([pluck.pluck_notes, pluck.pluck_density, pluck.pluck_spacing, lead.lead_notes, lead.lead_timbre,
+    lead.lead_phrase, amb.amb_mode, amb.amb_br, amb.amb_density, amb.amb_reverb, sparks.spk_pitch, sparks.spk_density, sparks.spk_pan].map(literal));
+});
+fs.writeFileSync('firmware/src/mdma_groove_patterns.h', header + drums);
+fs.writeFileSync('firmware/src/mdma_melody_patterns.h', header + melody);
+
+const colours = ['BBE46E','38BFFF','EAC568','FF704F','A69CFF','74D192','E8DF9F','FF80A7',
+  'E986EA','DEA368','FFB35C','DBF54B','80A4E7','4ADDCC','CBA3DB','B6CCD9'];
+const transliterate = name => name === 'ЧОРНОБИЛЬ' ? 'CHORNOBIL'
+  : name.replace('Á', '~').replace('Ô', '^').replace('Ã', '`');
+const recipeC = recipes.map(({name, seed, bpm, tonic, swing, lead, edits}, i) => {
+  const rgb = colours[i].match(/../g).map(n => parseInt(n, 16));
+  const colour = ((rgb[0] >> 3) << 11) | ((rgb[1] >> 2) << 5) | (rgb[2] >> 3);
+  return '    ' + literal([JSON.stringify(transliterate(name)), seed, bpm, tonic, swing, colour,
+    Math.round(32768 * lead[0]), Math.round(2**24 * .3 * 10**lead[2]),
+    literal(edits.map(v => Math.round(v * 20)))]) + ',';
+});
+const bassNotes = Array.from({length: 32}, (_, step) => alienBass[step]?.[0] ?? -1);
+const slides = bassNotes.reduce((bits, _, step) => bits + (alienBass[step]?.[1] ? 2**step : 0), 0);
+const pluckNotes = Array.from({length: 32}, (_, step) => pluckIntro[step] ?? -1);
+fs.writeFileSync('firmware/src/mdma_city_recipes.h', header +
+  'static const CityRecipe city_recipes[] = {\n' + recipeC.join('\n') + '\n};\n' +
+  'static const int8_t city_alien_bass[32] = ' + literal(bassNotes) + ';\n' +
+  '#define CITY_ALIEN_SLIDES 0x' + slides.toString(16) + 'u\n' +
+  'static const uint8_t city_hold_bass[] = ' + literal(holdBass) + ';\n' +
+  '#define CITY_HOLD_LENGTH ' + holdLength + 'u\n' +
+  'static const int8_t city_buzios_pluck[32] = ' + literal(pluckNotes) + ';\n');
+
+const profiles=[...[0,2,1].map(kit=>moduleBoxInstance.profile(kit)),...recipes.map(r=>r.profile)];
+const controls=['plBr','plQ','plDen','spkBr','spkQ','spkDen','ambBr','ambQ','ambDep','bAcid','ldSend','plSend','ambRv','spkSend','sendR','sendD','drv'];
+const params=['cut','res','env','dec','master','rvLp','rvLvl','dlLvl','dlFb','acidLvl'];
+fs.writeFileSync('firmware/src/mdma_timbres.h',header+
+ 'typedef struct { int32_t '+[...controls,...params].join(',')+'; uint32_t edits[6]; } CityTimbre;\n'+
+ 'static const CityTimbre city_timbres[] = {\n'+profiles.map(({D,P,edits})=>literal([
+ ...controls.map(k=>Math.round(65536*D[k])),...params.map(k=>Math.round(65536*P[k])),
+ literal(['drums','bass','pluck','lead','amb','sparks'].map(l=>edits[l].reduce((w,v,i)=>w|((Math.round(v*20)&63)<<(6*i)),0)))
+ ])).join(',\n')+'\n};\n');
