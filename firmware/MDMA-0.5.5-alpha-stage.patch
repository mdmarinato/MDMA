diff --git a/firmware/src/mdma_melody.c b/firmware/src/mdma_melody.c
new file mode 100644
index 0000000..3702021
--- /dev/null
+++ b/firmware/src/mdma_melody.c
@@ -0,0 +1,80 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* Sequenced melodic voices. Included after the groove phase and waveform helpers. */
+enum { GROOVE_DRUMS=1, GROOVE_BASS=2, GROOVE_PLUCK=4, GROOVE_LEAD=8,
+       GROOVE_AMB=16, GROOVE_SPARKS=32, GROOVE_ALL=63 };
+
+typedef struct {
+    int8_t pluck[16];
+    uint8_t pluck_density[16], pluck_spacing[16];
+    int8_t lead[16];
+    uint8_t lead_timbre[16], lead_phrase[16], amb_mode[16], amb_bright[16],
+            amb_density[16], amb_reverb[16], sparks_pitch[16], sparks_density[16], sparks_pan[16];
+} MelodyPattern;
+#include "mdma_melody_patterns.h"
+
+static unsigned pluck_delay,hit_frame;
+static struct {unsigned inc,len,vel,profile;} pending_pluck;
+
+static void melody_step(unsigned scene, uint32_t patterns, uint32_t origins, unsigned step,
+                        unsigned position, unsigned step_frames, unsigned enabled)
+{
+    const MelodyPattern *pluck = &melody_patterns[city_pattern_bank(pattern_origin(origins, 2))][scene][(patterns >> 6) & 7u];
+
+    const MelodyPattern *sparks = &melody_patterns[city_pattern_bank(pattern_origin(origins, 5))][scene][(patterns >> 15) & 7u];
+    if (enabled & GROOVE_PLUCK) {
+        const bool buzios = !pattern_origin(origins, 2) && !((patterns >> 6) & 7u);
+        const int note = buzios ? city_buzios_pluck[position & 31u] : pluck->pluck[step];
+        if (note >= 0) {
+            const unsigned delay = buzios ? 0u : pluck->pluck_spacing[step] * step_frames / 5u;
+            const unsigned pitch = buzios ? lead_scale_degree((unsigned)note, harmonic_controls)
+                : groove_pitch(33u - 9u + (unsigned)note) + 9u;
+            const unsigned density=pluck->pluck_density[step];
+            unsigned anchor=0;
+            while(anchor<16 && pluck->pluck[anchor]<0) ++anchor;
+            const unsigned profile=voice_bank[2];
+            if(buzios || melody_random()<(unsigned)city_timbres[profile].plDen*(55u+density*22u)/100u || step==anchor){
+                pending_pluck.inc=groove_inc(pitch);
+                pending_pluck.len=buzios?7938:6174+1985*density+melody_random()*5292u/65536u;
+                pending_pluck.vel=buzios?(position%8u==5u?540:720):550+120*density;
+                pending_pluck.profile=profile;
+                pluck_delay=delay+1;
+            }
+        }
+    }
+    const unsigned profile=voice_bank[5];
+    if((enabled&GROOVE_SPARKS) && sparks->sparks_density[step] &&
+       melody_random()<sparks->sparks_density[step]*(unsigned)city_timbres[profile].spkDen/127u){
+        const unsigned inc=voice_scale(groove_inc(lead_scale_degree(sparks->sparks_pitch[step],harmonic_controls)),23831);
+        hit_start(true,inc,4410+melody_random()*13230u/65536u,650,sparks->sparks_pan[step],profile);
+    }
+}
+
+static void melody_sample(unsigned enabled, int32_t *left, int32_t *right)
+{
+    if (!(enabled & GROOVE_PLUCK)) pluck_delay=0;
+    if(pluck_delay && !--pluck_delay)
+        hit_start(false,pending_pluck.inc,pending_pluck.len,pending_pluck.vel,64,pending_pluck.profile);
+    ++hit_frame;
+    int32_t pl=0,sl=0,sr=0;
+    for(unsigned i=0;i<8;++i) if(plucks[i].len) pl+=hit_sample(&plucks[i],false,hit_frame);
+    for(unsigned i=0;i<6;++i) if(sparks_pool[i].len){
+        HitVoice *v=&sparks_pool[i];
+        const int32_t x=hit_sample(v,true,hit_frame);
+        uint32_t phase=v->pan*8454660u;
+        sl+=x*lead_sin(phase+0x40000000u)>>15;
+        sr+=x*lead_sin(phase)>>15;
+    }
+    qa_layer(2,pl,pl,left,right);
+    qa_layer(5,sl,sr,left,right);
+    drone_active=0;
+    int32_t amb=0;
+    const unsigned base=groove_inc(21u+(harmonic_controls&15u));
+    for(unsigned k=0;k<3;++k) amb+=drone_run(k,enabled&GROOVE_AMB,base);
+    amb+=drone_run(3,manual_amb_inc!=0,manual_amb_inc?manual_amb_inc:drones[3].pitch);
+    qa_layer(4,amb,amb,left,right);
+}
+
+static bool melody_sounding(void)
+{
+    return hit_count || drone_active || manual_amb_inc;
+}
