+
+static void panel_circle(int x, int y, int radius, uint16_t line, uint16_t fill, int level)
+{
+    for (int dy = -radius; dy <= radius; ++dy)
+        for (int dx = -radius; dx <= radius; ++dx) {
+            const int square = dx * dx + dy * dy;
+            if (square > radius * radius) continue;
+            if (square >= (radius - 1) * (radius - 1)) cv_pset(x + dx, y + dy, line);
+            else if (radius - dy < level) cv_pset(x + dx, y + dy, fill);
+        }
+}
+
+typedef struct { int x, y, width, height; } PanelRect;
+
+static int panel_overlap(PanelRect a, PanelRect b)
+{
+    const int x0 = a.x > b.x ? a.x : b.x, y0 = a.y > b.y ? a.y : b.y;
+    const int x1 = a.x + a.width < b.x + b.width ? a.x + a.width : b.x + b.width;
+    const int y1 = a.y + a.height < b.y + b.height ? a.y + a.height : b.y + b.height;
+    return x1 > x0 && y1 > y0 ? (x1 - x0) * (y1 - y0) : 0;
+}
