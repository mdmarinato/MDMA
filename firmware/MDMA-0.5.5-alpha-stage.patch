+static const uint16_t layer_ink[] = {RGB(255,138,0), RGB(155,48,255), RGB(244,255,0),
+                                     RGB(255,43,214), RGB(0,229,255), RGB(46,107,255)};
+static const uint16_t scene_ink[] = {RGB(140,255,0), RGB(255,196,0), RGB(255,92,138), RGB(106,92,255)};
+static const char *const scene_names[] = {"INTRO","GROOVE","TENSION","PEAK"};
+static const char *const note_names[] = {"A","A#","B","C","C#","D","D#","E","F","F#","G","G#"};
