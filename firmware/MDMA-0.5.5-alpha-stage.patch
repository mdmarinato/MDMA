+static const char *panel_city_name(unsigned city)
+{
+    const CityRecipe *recipe = city_get_recipe(city);
+    return recipe ? recipe->name : lcd_cities[city < FACTORY_COUNT ? city : 0];
+}
+
+static uint16_t panel_city_colour(unsigned city)
+{
+    const CityRecipe *recipe = city_get_recipe(city);
+    return recipe ? recipe->colour : city_ink[city < FACTORY_COUNT ? city : 0];
+}
+
+static const char *const drum_names[] = {"KICK","HAT","OPEN","CLAP","PERC","NOISE"};
+static const char *panel_notice;
+static uint32_t panel_notice_until;
+static unsigned visible_levels[LAYER_COUNT], visible_playhead = 16u;
+static uint32_t panel_live_at;
+
+
+enum { ALIGN_LEFT, ALIGN_CENTER, ALIGN_RIGHT };
+
+static unsigned panel_text_length(const char *text)
+{
+    unsigned size = 0;
+    while (text[size]) ++size;
+    return size;
+}
+
+static int panel_text(int x, int baseline, unsigned scale, uint16_t colour, unsigned align, const char *text)
+{
+    const unsigned length = panel_text_length(text);
+    if (!length) return x;
+    const int width = (int)((length * 6u - 1u) * scale);
+    if (align == ALIGN_RIGHT) x -= width;
+    if (align == ALIGN_CENTER) x -= width / 2;
+    const int y = baseline - 7 * (int)scale + 1;
+    for (; *text; ++text, x += 6 * (int)scale) {
+        const unsigned letter = (uint8_t)*text;
+        const unsigned base = letter == '~' || letter == '`' ? 'A' : letter == '^' ? 'O' : letter;
+        const uint8_t *bits = lcd_glyphs[(base >= 32 && base <= 126 ? base : '?') - 32];
+        for (unsigned column = 0; column < 5; ++column)
+            for (unsigned row = 0; row < 7; ++row)
+                if ((bits[column] >> row) & 1u)
+                    cv_rect(x + (int)(column * scale), y + (int)(row * scale), scale, scale, colour);
+        if (letter == '@' || letter == '~' || letter == '^' || letter == '`') {
+            cv_rect(x + (int)scale, y - (int)scale, scale, scale, colour);
+            cv_rect(x + 2 * (int)scale, y - 2 * (int)scale, scale, scale, colour);
+            if (letter == '^') cv_rect(x + 3 * (int)scale, y - (int)scale, scale, scale, colour);
+            if (letter == '`') cv_rect(x + 3 * (int)scale, y - 2 * (int)scale, scale, scale, colour);
+        }
+    }
+    return x;
+}
+
+static void panel_box(int x, int y, int width, int height, uint16_t colour)
+{
+    cv_rect(x, y, width, 1, colour);
+    cv_rect(x, y + height - 1, width, 1, colour);
+    cv_rect(x, y + 1, 1, height - 2, colour);
+    cv_rect(x + width - 1, y + 1, 1, height - 2, colour);
+}
+
+static void panel_row(int y, int height, bool selected, uint16_t colour)
+{
+    cv_rect(8, y, 224, height, PANEL_ROW);
+    if (selected) panel_box(8, y, 224, height, colour);
+}
+
+static char *panel_uint(char *out, unsigned value)
+{
+    char digits[10];
+    unsigned count = 0;
+    do {
+        digits[count++] = (char)('0' + value % 10u);
+        value /= 10u;
+    } while (value);
+    while (count) *out++ = digits[--count];
+    *out = 0;
+    return out;
+}
+
+static unsigned panel_master_level(void)
+{
+    const unsigned step = ((unsigned)master_q12 + 16u) >> 5;
+    return step > 128u ? 128u : step;
+}
+
+static void panel_header(const char *title, uint16_t colour)
+{
+    const uint16_t city = panel_city_colour(active_city);
+    const unsigned bpm = qa_source && qa_running ? qa_external_bpm : groove_edits[active_city].bpm;
+    char tempo[12] = "BPM ";
+    panel_uint(tempo + 4, bpm);
+    const char *note = note_names[city_tonic[active_city]];
+    char key[12] = "TOM ";
+    char *suffix = key + 4;
+    while (*note) *suffix++ = *note++;
+    memcpy(suffix, city_major[active_city] ? " MAJ" : " MIN", 5);
+    char master[17] = "MASTER ";
+    const unsigned level = panel_master_level();
+    if (level) {
+        const unsigned db = (unsigned)-panel_master_db[level];
+        char *start = master + 7;
+        if (db) *start++ = '-';
+        char *end = panel_uint(start, db / 10u);
+        *end++ = '.';
+        *end++ = (char)('0' + db % 10u);
+        memcpy(end, " DB", 4);
+    } else {
+        memcpy(master + 7, "MUTE", 5);
+    }
+
+    cv_rect(8, 1, 224, 3, city);
+    panel_text(8, 20, panel_text_length(title) > 13 ? 1 : 2, colour, ALIGN_LEFT, title);
+    cv_rect(9, 25, 7, 5, city);
+    cv_rect(11, 30, 3, 2, city);
+    cv_pset(12, 32, city);
+    cv_rect(12, 26, 2, 2, PANEL_BG);
+    panel_text(21, 32, 1, city, ALIGN_LEFT, panel_city_name(active_city));
+    panel_text(232, 14, 1, C_WHITE, ALIGN_RIGHT, tempo);
+    panel_text(232, 25, 1, C_WHITE, ALIGN_RIGHT, key);
+    panel_text(232, 36, 1, C_WHITE, ALIGN_RIGHT, master);
+}
+
+static void panel_footer(int y, bool right)
+{
+    const unsigned origin = layer_origin[active_city][selected_layer];
+    const bool borrowed = origin != active_city;
+    const char *name = layer_label[selected_layer];
+    const int width = (int)((panel_text_length(name) + 2u + (borrowed ? panel_text_length(panel_city_name(origin)) + 3u : 0u)) * 6u - 1u);
+    int x = right ? 232 - width : 8;
+    x = panel_text(x, y, 1, layer_ink[selected_layer], ALIGN_LEFT, "> ");
+    x = panel_text(x, y, 1, layer_ink[selected_layer], ALIGN_LEFT, name);
+    if (borrowed) {
+        x = panel_text(x, y, 1, layer_ink[selected_layer], ALIGN_LEFT, right ? " - " : " * ");
+        panel_text(x, y, 1, panel_city_colour(origin), ALIGN_LEFT, panel_city_name(origin));
+    }
+}
+
+static void panel_cards(void)
+{
+    const bool fx = page == PAGE_FX;
+    const uint8_t *values = fx ? panel_fx[active_city][selected_layer] : panel_mix[active_city][selected_layer];
+    const char *const *names = fx ? fx_label : mix_label;
+    const uint16_t colour = layer_ink[selected_layer];
+    for (unsigned i = 0; i < 4; ++i) {
+        const int x = 8 + 56 * (int)i;
+        const bool off = (fx || i == MIX_VOL) && values[i] == 0;
+        cv_rect(x, 211, 54, 24, PANEL_ROW);
+        panel_box(x, 211, 54, 24, off ? PANEL_DIM : colour);
+        char label[8] = {0};
+        memcpy(label, names[i], 3);
+        if (off) memcpy(label + 3, " OFF", 5);
+        panel_text(x + 27, 222, 1, off ? PANEL_OFF : colour, ALIGN_CENTER, label);
+        if (off) continue;
+        const int start = fx || i == MIX_VOL ? 0 : 22;
+        const int end = (44 * values[i] + 63) / 127;
+        cv_rect(x + 5, 227, 44, 3, PANEL_DIM);
+        cv_rect(x + 5 + (start < end ? start : end), 227, start < end ? end - start : start - end, 3, colour);
+        if (start) cv_rect(x + 5 + start, 226, 1, 5, PANEL_OFF);
+        cv_rect(x + 5 + (end == 44 ? 43 : end), 226, 1, 5, colour);
+    }
+}
+
+static void panel_fill_banner(int x, int y, unsigned align)
+{
+    const char *label = fill_active ? "FILL IN" : fill_queued ? "FILL NEXT" : 0;
+    if (label) panel_text(x, y, 1, layer_ink[0], align, label);
+}
+
+static void panel_home(void)
+{
+    const unsigned scene = groove_edits[active_city].scene;
+    const unsigned variation = layer_variation[active_city][selected_layer];
+    const uint16_t selected_ink = layer_ink[selected_layer];
+    panel_header(scene_names[scene], scene_ink[scene]);
+    panel_fill_banner(115, 32, ALIGN_CENTER);
+    for (unsigned i = 0; i < 8; ++i) {
+        const int x = 8 + 28 * (int)i;
+        const char numeral[] = {(char)('1' + i), 0};
+        cv_rect(x, 42, 26, 14, variation == i ? selected_ink : PANEL_ROW);
+        panel_text(x + 13, 52, 1, variation == i ? C_BLACK : selected_ink, ALIGN_CENTER, numeral);
+    }
+    for (unsigned i = 0; i < LAYER_COUNT; ++i) {
+        const unsigned layer = layer_order[i];
+        const int y = 61 + 22 * (int)i;
+        const uint16_t colour = layer_ink[layer];
+        const bool selected = layer == selected_layer, on = qa_ready_mask & (1u << layer);
+        panel_row(y, 20, selected, colour);
+        if (selected) panel_text(13, y + 14, 1, colour, ALIGN_LEFT, ">");
+        panel_text(23, y + 14, 1, on || selected ? C_WHITE : PANEL_OFF, ALIGN_LEFT, layer_label[layer]);
+        for (unsigned j = 0; j < 8; ++j) {
+            const bool current = j == layer_variation[active_city][layer];
+            cv_rect(76 + 11 * j, y + 7, 8, 6, current ? (on || selected ? colour : PANEL_OFF) : PANEL_DIM);
+        }
+        cv_rect(171, y + 7, 55, 6, PANEL_DIM);
+        cv_rect(171, y + 7, visible_levels[layer], 6, colour);
+    }
+    panel_footer(204, false);
+    panel_cards();
