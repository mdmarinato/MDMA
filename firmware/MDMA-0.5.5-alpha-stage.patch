--- /dev/null
+++ b/firmware/src/mdma_voice.c
@@ -0,0 +1,129 @@
+/* Shared fixed-point envelope and RBJ filter math. Levels use Q15, frequencies Hz. */
+typedef struct {int32_t a1,a2,b0,b1,b2,z1,z2;} VoiceFilter;
+static uint32_t voice_exp(int32_t exponent)
+{
+    const unsigned frac=(unsigned)exponent&65535u, index=frac>>8;
+    const uint32_t mant=octave_ratio[index]+((octave_ratio[index+1]-octave_ratio[index])*(frac&255u)>>8);
+    const int oct=exponent>>16;
+    return oct>=0 ? mant<<(unsigned)oct : mant>>(unsigned)-oct;
+}
+static int32_t voice_log(unsigned x)
+{
+    const unsigned power=31u-(unsigned)__builtin_clz(x);
+    const unsigned frac=((x<<(31u-power))>>15)&65535u, idx=frac>>8;
+    return (int32_t)((power<<16)+log_fraction[idx]+((log_fraction[idx+1]-log_fraction[idx])*(frac&255u)>>8));
+}
+static void voice_filter_set(VoiceFilter *f,unsigned type,unsigned hz,unsigned inv_q)
+{
+    if(hz<10) hz=10;
+    if(hz>21000) hz=21000;
+    const uint32_t angle=hz*97392u;
+    const int32_t sn=lead_sin(angle>>1);
+    const int32_t low=(sn*sn)>>2, one=1<<28;
+    const int32_t alpha=(int32_t)((int64_t)lead_sin(angle)*inv_q>>15); /* Q16 */
+    const int32_t rec=(int32_t)((1u<<30)/(65536u+(unsigned)alpha))<<14;
+    const int32_t normalized=(int32_t)((int64_t)alpha*rec>>16);
+    f->a1=lead_biquad_multiply(4*low-2*one,rec);
+    f->a2=rec-normalized;
+    f->b0=type==2?normalized:lead_biquad_multiply(type==1?one-low:low,rec);
+    f->b1=type==2?0:type==1?-2*f->b0:2*f->b0;
+    f->b2=type==2?-f->b0:f->b0;
+}
+static int32_t voice_filter(VoiceFilter *f,int32_t x)
+{
+    const int32_t in=x*256;
+    const int32_t y=lead_biquad_multiply(in,f->b0)+f->z1;
+    f->z1=lead_biquad_multiply(in,f->b1)-lead_biquad_multiply(y,f->a1)+f->z2;
+    f->z2=lead_biquad_multiply(in,f->b2)-lead_biquad_multiply(y,f->a2);
+    return y>>8;
+}
+static unsigned voice_gain[LAYER_COUNT][4], voice_mode[LAYER_COUNT];
+static void voice_edits(unsigned city)
+{
+    static uint32_t last[LAYER_COUNT];
+    for(unsigned l=0;l<LAYER_COUNT;++l){
+        const uint32_t packed=city_voice_edit[city][l];
+        if(last[l]==packed && voice_gain[l][0]) continue;
+        last[l]=packed;
+        voice_mode[l]=packed>>24;
+        for(unsigned k=0;k<4;++k)
+            voice_gain[l][k]=voice_exp(lead_edit_detent(packed,k)*65536/10);
+    }
+}
+static uint32_t melody_rng=0x9E3779B9u;
+static unsigned melody_random(void){
+    melody_rng^=melody_rng<<13;melody_rng^=melody_rng>>17;melody_rng^=melody_rng<<5;
+    return melody_rng>>16;
+}
+static unsigned voice_scale(unsigned value,unsigned gain){
+    return (unsigned)(((uint64_t)value*gain)>>16);
+}
+static unsigned voice_inv_q(unsigned q100,unsigned gain,bool soft,bool band)
+{
+    unsigned resonance=voice_scale(q100,gain);
+    if(soft) resonance=resonance*6/10;
+    return band ? 3276800u/(resonance?resonance:1u) : voice_exp(-(int32_t)resonance*109)/2;
+}
+typedef struct {
+    uint32_t phase[2],inc,age,len;
+    int32_t peak,cutLog,gainLog;
+    unsigned pan,bright,q100;
+    VoiceFilter f,hp;
+} HitVoice;
+static HitVoice plucks[8], sparks_pool[6];
+static unsigned hit_count;
+static void hit_start(bool spark,unsigned inc,unsigned length,unsigned velocity,unsigned pan,unsigned profile)
+{
+    HitVoice *pool=spark?sparks_pool:plucks;
+    const unsigned count=spark?6:8;
+    unsigned idx=0;
+    for(unsigned i=0;i<count;++i){
+        if(!pool[i].len){idx=i;break;}
+        if(!spark && pool[i].age>pool[idx].age) idx=i;
+    }
+    HitVoice *v=&pool[idx];
+    if(!v->len) ++hit_count;
+    *v=(HitVoice){.inc=inc,.len=length,.pan=pan};
+    const CityTimbre *t=&city_timbres[profile];
+    v->q100=voice_scale(100,spark?t->spkQ:t->plQ);
+    v->bright=spark?t->spkBr:t->plBr;
+    v->peak=spark?3277+(int32_t)velocity*13107/1000:786+(int32_t)velocity*4588/1000;
+    v->gainLog=voice_log(33)-voice_log((unsigned)v->peak);
+    v->cutLog=voice_log(voice_scale(700+velocity*18/10,v->bright));
+    if(spark){
+        stage_spark_side=-stage_spark_side;
+        stage_spark_len=stage_spark_remaining=length;
+    }
+}
+static int32_t hit_sample(HitVoice *v,bool spark,unsigned frame)
+{
+    const unsigned l=spark?5u:2u, mode=voice_mode[l];
+    unsigned age=v->age>>8, len=v->len;
+    if(age>len+(spark?1323u:2205u)){v->len=0;--hit_count;return 0;}
+    const unsigned u=age>=len?65536u:age*65536u/len;
+    if(!(frame&(spark?3u:7u))){
+        const unsigned hz=spark?(v->inc/97392u)*(65536u+4u*voice_scale((mode&8)?65536u-u:u,voice_gain[l][3]))/65536u:
+            voice_exp(v->cutLog-(int32_t)(((int64_t)(v->cutLog-voice_log(260))*u)>>16)-16*65536);
+        voice_filter_set(&v->f,(mode&1)?2:0,voice_scale(hz,voice_gain[l][0]),
+            voice_inv_q(v->q100,voice_gain[l][1],mode&2,mode&1));
+        if(spark) voice_filter_set(&v->hp,1,hz*3/10,26029);
+    }
+    int32_t wave;
+    if(spark){
+        v->phase[0]+=v->inc;
+        wave=(lead_saw(v->phase[0],v->inc)+(int32_t)melody_random()-32768)/2;
+        wave=voice_filter(&v->hp,voice_filter(&v->f,wave));
+    }else{
+        const unsigned detune=voice_scale(voice_gain[l][3],(mode&8)?157286:65536);
+        v->phase[0]+=v->inc-voice_scale(v->inc,voice_scale(76,detune));
+        v->phase[1]+=v->inc+voice_scale(v->inc,voice_scale(114,detune));
+        wave=(lead_sin(v->phase[0])*52+groove_triangle(v->phase[1])*48)/100;
+        wave=voice_filter(&v->f,wave);
+    }
+    const unsigned attack=spark?88u:265u;
+    const int32_t env=age<attack?v->peak*(int32_t)age/(int32_t)attack:
+        (int32_t)voice_scale((unsigned)v->peak,voice_exp((int32_t)((int64_t)v->gainLog*
+            (age>=len?65536u:(age-attack)*65536u/(len-attack))>>16)));
+    v->age+=((mode&4)?27682406u:16777216u)/voice_gain[l][2];
+    return (int32_t)(((int64_t)wave*env*(spark?v->bright:65536u))>>31);
+}
