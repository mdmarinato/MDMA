index 0000000..617c42b
--- /dev/null
+++ b/firmware/src/mdma_stage.c
@@ -0,0 +1,42 @@
+/* Fixed-point projection of the stable updateStage function. One update per 128 samples. */
+static int stage_limit(int value, int lo, int hi)
+{
+    return value < lo ? lo : value > hi ? hi : value;
+}
+
+static void stage_update(uint32_t beat8, unsigned moving)
+{
+    const uint32_t beat = beat8 * 8u;
+    const int s = lead_sin(beat), c8 = lead_sin(beat8 + 0x40000000u);
+    const int s8 = lead_sin(beat8), half = lead_sin(beat8 * 4u);
+    const int pluck = mix_tanh[(half < 0 ? -half : half) >> 8] * (half < 0 ? -1 : 1);
+    const int ghost = lead_sin((uint32_t)(ghost_time_q24 * 293719u >> 16)) *
+        lead_sin((uint32_t)(ghost_time_q24 * 133509u >> 16) + 1757307100u) >> 15;
+    /* Coordinates in 1/128 control units, rounded at the mixer boundary. */
+    const int dx[] = {s*576/32768, s8*320/32768, pluck*1536/32768,
+                      ghost*1920/32768, c8*2048/32768, stage_spark_side*3200};
+    const int presence = stage_spark_len ? (int)(stage_spark_remaining*100u/stage_spark_len) : 0;
+    const int dy[] = {lead_sin(beat*2u+0x40000000u)*448/32768, c8*896/32768,
+                      (s>0?s:0)*768/32768, ((int)ghost_auto_q15-16384)*1792/32768,
+                      s8*1536/32768, stage_spark_side*presence*1280/100};
+    for (unsigned l=0;l<LAYER_COUNT;++l) {
+        const uint32_t base=mix_controls[l], fx=fx_controls[l];
+        const int pan=base>>8&127, filter=base>>16&127;
+        const int range=stage_limit((filter>64?filter-64:64-filter)*80,0,1280);
+        const int live=moving>>l&1u;
+        const int x=stage_limit(pan*100 + live*dx[l],0,12700);
+        const int y=stage_limit(filter*100 + live*stage_limit(dy[l],-range,range),0,12700);
+        stage_mix[l]=(base&0xff0000ffu) | (uint32_t)((x+50)/100)<<8 | (uint32_t)((y+50)/100)<<16;
+        const int nx=(x-6400)/64, ny=(y-6400)/64;
+        const int ambience=l==3||l==4?100:45, weight=l==5&&live?presence:100;
+        const int mods[]={((55*nx+25*ny)*ambience/100), -55*nx+15*ny,
+                          ((40*ny+20*(live*dx[l]/128))*ambience/100)};
+        uint32_t scaled=fx&0xff000000u;
+        for(unsigned k=0;k<3;++k) {
+            int level=(int)(fx>>(8*k)&127);
+            level=stage_limit(level*(10000+mods[k]*weight/100)/10000,0,127);
+            scaled|=(unsigned)level<<(8*k);
+        }
+        stage_fx[l]=scaled;
+    }
+}
diff --git a/firmware/src/mdma_steps.c b/firmware/src/mdma_steps.c
new file mode 100644
index 0000000..15e1da0
--- /dev/null
+++ b/firmware/src/mdma_steps.c
@@ -0,0 +1,30 @@
+/* Sparse per-step edits. Each non-neutral step occupies six bytes in the existing A/B sector. */
+enum { SHAPE_CAP=16 };
+typedef struct { uint16_t key; int8_t value[4]; } StepShape;
+_Static_assert(sizeof(StepShape)==6,"unexpected step record size");
+static StepShape step_shapes[SHAPE_CAP];
+static struct {bool ready,preview;unsigned city,slot;uint16_t mask[6];} draft;
+static unsigned step_key(unsigned city,unsigned slot,unsigned lane,unsigned step)
+{
+    return 1+(((city*32+slot)*6+lane)*16+step);
+}
+static int shape_index(unsigned key)
+{
+    for(unsigned i=0;i<SHAPE_CAP;++i)if(step_shapes[i].key==key)return (int)i;
+    return -1;
+}
+static bool shape_set(unsigned key,unsigned knob,int delta)
+{
+    int idx=shape_index(key);
+    if(idx<0){idx=shape_index(0);if(idx<0)return false;}
+    StepShape *p=step_shapes+idx;
+    int v=p->value[knob]+delta;
+    p->value[knob]=(int8_t)(v< -10?-10:v>10?10:v);
+    p->key=(p->value[0]||p->value[1]||p->value[2]||p->value[3])?(uint16_t)key:0;
+    return true;
+}
+static bool draft_matches(unsigned city,unsigned slot){return draft.ready && draft.city==city && draft.slot==slot;}
+static uint16_t live_mask(unsigned city,unsigned lane,unsigned slot){
+    if(draft.preview && draft_matches(city,slot))return draft.mask[lane];
+    return drum_edit_mask(city,lane,slot);
+}
