+            int left = x[layer] + offsets[candidate][0], top = y[layer] + offsets[candidate][1];
+            PanelRect r = {left < 11 ? 11 : left > 203 ? 203 : left,
+                           top < 62 ? 62 : top > 186 ? 186 : top, 26, 13};
+            int score = 0;
+            for (unsigned j = 0; j < boxes_used; ++j) score += panel_overlap(r, boxes[j]);
+            for (unsigned j = 0; j < LAYER_COUNT; ++j)
+                score += panel_overlap(r, (PanelRect){x[j]-6,y[j]-6,13,13});
+            if (score < best_score) { best_score = score; best = r; }
+        }
+        boxes[boxes_used++] = best;
+        cv_rect(best.x, best.y, best.width, best.height, PANEL_BG);
+        const bool selected = layer == selected_layer;
+        if (selected) panel_box(best.x, best.y, best.width, best.height, layer_ink[layer]);
