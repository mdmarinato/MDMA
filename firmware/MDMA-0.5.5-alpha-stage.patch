+typedef struct {
+    uint32_t ph[4],clock,fade,lv,pitch;
+    VoiceFilter filter;
+} DroneVoice;
+static DroneVoice drones[4];
+static unsigned drone_active,manual_amb_inc,manual_bass_inc;
+static int32_t drone_run(unsigned which,bool enabled,uint32_t target)
+{
+    DroneVoice *d=&drones[which];
+    const CityTimbre *p=&city_timbres[voice_bank[4]];
+    const unsigned mode=voice_mode[4];
+    const bool hand=which==3, root=which==0||hand;
+    unsigned samples=enabled?(hand?2205:132300):(hand?11025:110250);
+    samples=voice_scale(samples,voice_gain[4][3]);
+    if(mode&8) samples=samples*42/100;
+    unsigned delta=268435456u/samples;
+    if(enabled)d->fade=d->fade>268435456u-delta?268435456u:d->fade+delta;
+    else d->fade=d->fade>delta?d->fade-delta:0;
+    if(!d->fade)return 0;
+    drone_active=1;
+    const unsigned frame=++d->clock;
+    if(!d->pitch||hand)d->pitch=target;
+    else d->pitch+=(int32_t)(target-d->pitch)/17640;
+    const unsigned pitch=d->pitch;
+    static const unsigned level[]={7612662,5096079,4026532,5798206};
+    d->lv+=(level[which]-d->lv)/6615;
+    const unsigned dep=voice_scale(p->ambDep,voice_gain[4][2]);
+    if((frame&7u)==1u){
+        const unsigned phase=frame*(root?10713u:which==1?4870u:8765u);
+        const int32_t wave=(mode&4)?-groove_triangle(phase):lead_sin(phase);
+        const unsigned base=voice_scale(voice_scale(root?270u:which==1?392u:784u,p->ambBr),voice_gain[4][0]);
+        int hz=(int)base+(int32_t)((int64_t)base*wave*dep*45/100>>31);
+        voice_filter_set(&d->filter,which==2?2:mode&1,hz<40?40u:(unsigned)hz,
+            which==2?27307:voice_inv_q(voice_scale(100,p->ambQ),65536,false,false));
+    }
+    int32_t out=0;
+    if(root){
+        for(unsigned k=0;k<3;++k){
+            const unsigned inc=voice_scale(pitch,k==0?65083:k==1?65536:65992);
+            d->ph[k]+=inc;
+            out+=lead_saw(d->ph[k],inc)/10;
+        }
+        d->ph[3]+=pitch;
+        out=voice_filter(&d->filter,out)+lead_sin(d->ph[3])/4;
+    }else if(which==1){
+        static const unsigned ratios[]={97907,131072,197405};
+        for(unsigned k=0;k<3;++k){
+            d->ph[k]+=voice_scale(pitch,ratios[k]);
+            int amplitude=2294+(int32_t)((int64_t)(dep>98304?98304:dep)*lead_sin(frame*(6817u+k*4870u))*4/100>>16);
+            out-=groove_triangle(d->ph[k])*amplitude>>15;
+        }
+        out=voice_filter(&d->filter,out);
+    }else{
+        out=voice_filter(&d->filter,((int32_t)melody_random()-32768)*3/10);
+        out=(int32_t)((int64_t)out*voice_gain[4][1]>>16);
+        if(mode&2)out=out*(21299+(lead_sin(frame*12661u)*11469>>15))>>15;
+    }
+    return (int32_t)(((int64_t)out*(d->fade>>13)*(d->lv>>9))>>30);
+}
diff --git a/firmware/src/mdma_drums.c b/firmware/src/mdma_drums.c
