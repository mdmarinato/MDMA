diff --git a/firmware/src/mdma_keys.c b/firmware/src/mdma_keys.c
new file mode 100644
index 0000000..0239d03
--- /dev/null
+++ b/firmware/src/mdma_keys.c
@@ -0,0 +1,51 @@
+/* The panel and MIDI poll on the main thread. Voices consume events in the audio interrupt. */
+typedef struct {uint8_t layer,key;uint32_t inc;} KeyHit;
+static volatile KeyHit key_hits[32];
+static volatile unsigned key_in,key_out;
+static volatile uint32_t key_gate[6];
+static volatile unsigned key_pending;
+static struct {unsigned id,layer,inc;} key_stack[64];
+static unsigned key_used;
+static void key_release(unsigned id)
+{
+    for(unsigned i=0;i<key_used;++i){
+        if(key_stack[i].id!=id)continue;
+        const unsigned layer=key_stack[i].layer;
+        for(unsigned j=i+1;j<key_used;++j)key_stack[j-1]=key_stack[j];
+        --key_used;
+        unsigned pitch=0;
+        for(unsigned j=key_used;j>0;--j)if(key_stack[j-1].layer==layer){pitch=key_stack[j-1].inc;break;}
+        key_gate[layer]=pitch;
+        return;
+    }
+}
+static void key_press(unsigned id,unsigned layer,unsigned key,unsigned inc)
+{
+    if(layer==0 || layer==2 || layer==5){
+        unsigned next=(key_in+1)&31;
+        if(next==key_out)return;
+        key_hits[key_in]=(KeyHit){layer,key,inc};
+        key_in=next;
+    }else{
+        key_release(id);
+        if(key_used==64)key_release(key_stack[0].id);
+        key_stack[key_used].id=id;key_stack[key_used].layer=layer;key_stack[key_used++].inc=inc;
+        key_gate[layer]=inc;
+    }
+    key_pending=1;
+}
+static void keys_audio(void)
+{
+    while(key_out!=key_in){
+        const KeyHit hit=key_hits[key_out];key_out=(key_out+1)&31;
+        const unsigned bank=city_pattern_bank(layer_origin[active_city][hit.layer]);
+        if(hit.layer==0){
+            drum_hit(hit.key%6,hit.key,0,1000);
+        }else if(hit.layer==2)hit_start(false,hit.inc,14112,1000,64,bank);
+        else hit_start(true,voice_scale(hit.inc,23831),8820,650,64,bank);
+    }
+    manual_amb_inc=key_gate[4]/2;
+    manual_bass_inc=key_gate[1]/2;
+    if(key_gate[3])lead_hand_pitch=key_gate[3];
+    key_pending=0;
+}
