+/* SPDX-License-Identifier: GPL-3.0-only */
+enum { PAGE_HOME, PAGE_FX, PAGE_EDIT, PAGE_SEQ, PAGE_GLO, PAGE_SAVE, PAGE_SCL, PAGE_STAGE, PAGE_MIX };
+static unsigned page, selected_layer = 1;
+static const char *const layer_label[6]={"DRUMS","BASS","PLUCK","LEAD","AMB","SPARKS"};
+
+static const char *const mix_label[] = {"VOL", "PAN", "FLT", "RES"};
+static const char *const fx_label[] = {"REV", "DLY", "PHS", "SAT"};
+static bool panel_dirty = true, save_confirm,mix_calibration;
+static uint32_t knob_previous_ms[4];
+static int knob_sign[4],knob_coast[4];
+static unsigned knob_peak[4],knob_total[4];
+static uint32_t knob_coast_at[4];
+static unsigned knob_context=~0u;
+enum { GLO_RELEASE, GLO_SWING, GLO_BASS, GLO_LEAD, GLO_CREATE, GLO_DELETE, GLO_RESET, GLO_CLOCK, GLO_COUNT };
+enum { GLO_DIALOG_NONE, GLO_DIALOG_LIMIT, GLO_DIALOG_FACTORY };
+static unsigned global_confirmation;
+static bool reset_all_cities;
+static unsigned held_seq_step=16,held_seq_key,held_seq_lane,held_seq_slot,held_seq_city;
+static bool shape_full;
+static uint32_t held_seq_at;
+static unsigned global_row, seq_layer, drum_lane, edit_row;
+static bool edit_held, edit_used;
+static uint32_t edit_at, seq_at, observed_city_switch;
+static bool seq_held, seq_fill_gesture, seq_fired;
+static int tempo_direction, tempo_start;
+static uint32_t tempo_at;
+
+static unsigned city_turn(unsigned city, int32_t direction)
+{
+    static const unsigned order[] = {0, 2, 1, 3, 4, 5, 6, 7};
+    const unsigned index = city < city_count ? order[city] : 0u;
+    const int count = city_count;
+    return order[(index + direction % count + count) % count];
+}
+
+static void panel_city_poll(void)
+{
+    if (queued_city >= CITY_COUNT) return;
+    if (city_switch_serial != observed_city_switch || (!groove_enabled && !qa_running)) {
+        observed_city_switch = city_switch_serial;
+        city_select(playing_city == queued_city ? playing_city : queued_city, true);
+        queued_city = CITY_COUNT;
+        panel_dirty = true;
+    }
+}
+
+static unsigned before_break = GROOVE_ALL;
+static bool all_layers_break;
+
+static void panel_set_layers(unsigned mask)
+{
+    for (unsigned layer = 0; layer < LAYER_COUNT; ++layer)
+        if (!panel_mix[active_city][layer][MIX_VOL]) mask &= ~(1u << layer);
+    qa_ready_mask = mask;
+    if (mask) mix_break=all_layers_break=false;
+    groove_enabled = !qa_source || qa_running ? mask : 0;
+}
+
+static void panel_all_layers(void)
+{
+    if (qa_ready_mask) {
+        before_break = qa_ready_mask;
+        panel_set_layers(0);
+        mix_break=all_layers_break=true;
+    } else {
+        panel_set_layers(before_break);
+        all_layers_break = false;
+        before_break = GROOVE_ALL;
+    }
+}
+
+static void panel_show(void)
+{
+    panel_dirty = true;
+}
+
+static unsigned panel_edit_count(unsigned layer)
+{
+    return layer < LAYER_COUNT ? 4u : 0u;
+}
+
+static volatile uint32_t *panel_voice_edits(void)
+{
+    if(selected_layer!=3) return &city_voice_edit[active_city][selected_layer];
+    return layer_origin[active_city][3] == active_city
+        ? &city_lead_home[active_city] : &city_lead_borrowed[active_city];
+}
+
+static void panel_voice_edit(unsigned parameter, int32_t motion)
+{
+    volatile uint32_t *edits = panel_voice_edits();
+    const unsigned shift = parameter * 6u;
+    const int32_t value = lead_edit_detent(*edits, parameter);
+    const int32_t changed = groove_adjust((uint8_t)(value + 20), motion, 0, 40) - 20;
+    *edits = (*edits & ~(63u << shift)) | (((uint32_t)changed & 63u) << shift);
+}
+
+#include "mdma_lcd.c"
+
+static unsigned panel_cycle(unsigned current, int32_t turn, unsigned count)
+{
+    return (unsigned)((int32_t)current + turn % (int32_t)count + (int32_t)count) % count;
+}
+
+static unsigned panel_layer_turn(unsigned layer, int32_t turn)
+{
+    unsigned i = 0;
+    while (layer_order[i] != layer) ++i;
+    return layer_order[panel_cycle(i, turn, LAYER_COUNT)];
+}
+
+static void panel_select_layer(unsigned layer)
+{
+    if (layer != selected_layer) edit_row = 0;
+    selected_layer = layer;
+}
+
+/* The reference maps the eleven raised keys, left to right, to four
+ * scenes, six layers and ALL LAYERS. Internal layer indices follow MIDI. */
+static int panel_key(unsigned key)
+{
+    static const uint8_t raised[] = {1, 3, 5, 8, 10, 13, 15, 17, 20, 22, 25};
+    for (unsigned i = 0; i < sizeof raised; ++i) {
+        if (raised[i] != key) continue;
+        if (i < 4) {
+            groove_edits[active_city].scene = (uint8_t)i;
+            groove_publish();
+        } else if (i < 10) {
+            if (page != PAGE_SEQ) panel_select_layer(layer_order[i - 4]);
+            if (page != PAGE_EDIT)
+                panel_set_layers(qa_ready_mask ^ (1u << layer_order[i - 4]));
+        } else {
+            panel_all_layers();
+        }
+        panel_show();
+        return 1;
+    }
+    return 0;
+}
+
+static void panel_clock(int direction)
+{
+    const unsigned next = panel_cycle(qa_source, direction, 3);
+    if (next == qa_source) return;
+    qa_source = next;
+    qa_running=groove_enabled=qa_ticks=0;
+    qa_clock_count=qa_beat_count=0;
+    qa_clock_seen=false;
+    ++qa_start_serial;
+    panel_set_layers(qa_ready_mask);
+}
+
+static void panel_reset_city(unsigned city)
+{
+    const CityRecipe *recipe = city_get_recipe(city);
+    static const uint8_t factory_swing[] = {10,14,12};
+    groove_edits[city] = (GrooveEdit){recipe ? recipe->bpm : 132, 0, 0, 80, 80, 50, LEAD_CUTOFF_DEFAULT};
+    city_tonic[city] = recipe ? recipe->tonic : 0;
+    city_major[city] = 0;
+    city_swing[city] = recipe ? recipe->swing : factory_swing[city < FACTORY_COUNT ? city : 0];
+    city_bass_alien[city] = city_lead_alien[city] = 0;
+    tempo_manual[city] = 0;
+    for(unsigned j=0;j<SHAPE_CAP;++j)
+        if(step_shapes[j].key && (step_shapes[j].key-1u)/3072u==city)step_shapes[j]=(StepShape){0};
+    city_ghost_grid[city]=0;
+    city_lead_home[city] = 0;
+    if (recipe)
+        for (unsigned i = 0; i < LEAD_EDIT_COUNT; ++i)
+            city_lead_home[city] |= ((uint32_t)recipe->lead_edits[i] & 63u) << (i * 6u);
+    city_lead_borrowed[city] = city_lead_home[city];
+    city_ghost_time_q12[city] = 0;
+    city_ghost_offset[city] = 0;
+    for (unsigned layer = 0; layer < LAYER_COUNT; ++layer) {
+        city_voice_edit[city][layer]=recipe?city_timbres[city_pattern_bank(city)].edits[layer]:0;
+        layer_origin[city][layer] = (uint8_t)city;
+        layer_variation[city][layer] = 0;
+        panel_mix[city][layer][MIX_VOL] = 102;
+        for (unsigned control = MIX_PAN; control < MIX_CONTROLS; ++control)
+            panel_mix[city][layer][control] = 64;
+    }
+    memset(panel_fx[city], 0, sizeof panel_fx[city]);
+    for (unsigned slot = 0; slot < 32; ++slot) {
+        panel_kick[city][slot] = 0;
+        for (unsigned lane = 0; lane < 5; ++lane) panel_drum[city][lane][slot] = 0;
+    }
+}
+
+static void panel_quiet_city_change(void)
+{
+    queued_city = CITY_COUNT;
+    qa_running = 0;
+    panel_set_layers(0);
+}
+
+static void panel_create_city(void)
+{
+    if (city_count >= CITY_COUNT) return;
+    const unsigned city = city_count;
+    unsigned recipe = (fm1_ticks() ^ fm1_ms) % RECIPE_COUNT + 1u;
+    for (;;) {
+        bool used = false;
+        for (unsigned i = FACTORY_COUNT; i < city_count; ++i) used |= city_recipe[i] == recipe;
+        if (!used) break;
+        recipe = recipe % RECIPE_COUNT + 1u;
+    }
+    panel_quiet_city_change();
+    city_recipe[city] = (uint8_t)recipe;
+    panel_reset_city(city);
+    ++city_count;
+    city_select(city, false);
+    ++lead_recall_serial;
+}
+
+static void panel_delete_city(void)
+{
+    if (active_city < FACTORY_COUNT) return;
+    panel_quiet_city_change();
+    uint8_t state[GROOVE_RECORD];
+    groove_encode(state);
+    const unsigned removed = active_city;
+    const unsigned remaining = city_count - 1u;
+    state[4] = 0;
+    state[5] = (uint8_t)remaining;
+    for (unsigned city = removed; city < remaining; ++city) {
+        uint8_t *row = state + 8u + city * GROOVE_CITY_BYTES;
+        memcpy(row, row + GROOVE_CITY_BYTES, GROOVE_CITY_BYTES);
+    }
+    for (unsigned city = 0; city < remaining; ++city) {
+        uint8_t *row = state + 8u + city * GROOVE_CITY_BYTES;
+        for (unsigned layer = 0; layer < LAYER_COUNT; ++layer) {
+            const unsigned origin = row[105 + layer];
+            row[105 + layer] = (uint8_t)(origin == removed ? city : origin > removed ? origin - 1u : origin);
+        }
+    }
+    for(unsigned i=0;i<SHAPE_CAP;++i){
+        StepShape v=step_shapes[i];
+        unsigned city=(v.key-1u)/3072u;
+        if(v.key && city==removed)v=(StepShape){0};
+        else if(v.key && city>removed)v.key-=3072;
+        memcpy(state+SHAPE_START+i*6,&v,6);
+    }
+    (void)groove_decode(state, sizeof state, true);
+}
+
+static void panel_factory_reset(void)
+{
+    panel_quiet_city_change();
+    if (reset_all_cities) {
+        active_city = 0;
+        city_count = FACTORY_COUNT;
+        for (unsigned city = 0; city < FACTORY_COUNT; ++city) panel_reset_city(city);
+    } else {
+        panel_reset_city(active_city);
+    }
+    lead_cutoff_turn(LEAD_CUTOFF_DEFAULT - lead_cutoff_position);
+    groove_tone = groove_edits[active_city].tone;
+    groove_publish();
+    panel_publish();
+    ++lead_recall_serial;
+}
+
+static void panel_adjust_global(int32_t direction)
+{
+    switch (global_row) {
+    case GLO_RELEASE: tempo_manual[active_city] ^= (unsigned)direction & 1u; break;
+    case GLO_SWING:
+        city_swing[active_city] = groove_adjust(city_swing[active_city], direction, 0, 20);
+        groove_publish();
+        break;
+    case GLO_BASS: city_bass_alien[active_city] ^= (unsigned)direction & 1u; break;
+    case GLO_LEAD: city_lead_alien[active_city] ^= (unsigned)direction & 1u; break;
+    case GLO_CLOCK: panel_clock(direction); break;
+    case GLO_RESET: reset_all_cities ^= (unsigned)direction & 1u; break;
+    default: return;
+    }
+    panel_show();
+}
+
+static void panel_global_press(int32_t direction)
+{
+    const bool action = global_row == GLO_CREATE || global_row == GLO_DELETE || global_row == GLO_RESET;
+    if (global_confirmation && (direction < 0 || global_confirmation <= GLO_DIALOG_FACTORY)) {
+        global_confirmation = 0;
+    } else if (!action) {
+        panel_adjust_global(direction);
+    } else if (direction > 0) {
+        if (global_confirmation == global_row + 1u) {
+            if (global_row == GLO_CREATE) panel_create_city();
+            if (global_row == GLO_DELETE) panel_delete_city();
+            if (global_row == GLO_RESET) panel_factory_reset();
+            global_confirmation = 0;
+            page = PAGE_HOME;
+        } else if (global_row == GLO_CREATE && city_count >= CITY_COUNT) {
+            global_confirmation = GLO_DIALOG_LIMIT;
+        } else if (global_row == GLO_DELETE && active_city < FACTORY_COUNT) {
+            global_confirmation = GLO_DIALOG_FACTORY;
+        } else {
+            global_confirmation = global_row + 1u;
+        }
+    }
+    panel_show();
+}
+
+static unsigned seq_current_slot(void){return groove_edits[active_city].scene+4u*layer_variation[active_city][0];}
+static void panel_draft(unsigned knob,int direction)
+{
+    const unsigned slot=seq_current_slot();
+    if(knob==0){
+        const GroovePattern *p=&groove_patterns[city_pattern_bank(layer_origin[active_city][0])][slot&3][slot>>2];
+        draft.preview=false;draft.ready=false;draft.city=active_city;draft.slot=slot;
+        for(unsigned l=0;l<6;++l){
+            draft.mask[l]=drum_edit_mask(active_city,l,slot);
+            if(l!=1 && l!=4)continue;
+            unsigned hits=p->hit[l]^draft.mask[l],start=(fm1_ticks()>>(l+1))&15u;
+            int on=-1,off=-1;
+            for(unsigned j=0;j<16;++j){unsigned i=(start+j)&15u;
+                if(hits&(1u<<i)){if(on<0)on=(int)i;}else if(off<0)off=(int)i;
+            }
+            if(off>=0){draft.mask[l]^=1u<<off;if(on>=0)draft.mask[l]^=1u<<on;}
+        }
+        draft.ready=true;
+    }else if(draft_matches(active_city,slot)){
+        if(direction<0)draft.ready=draft.preview=false;
+        else if(knob==1)draft.preview=true;
+        else if(knob==2){
+            for(unsigned l=0;l<6;++l){
+                volatile uint16_t *mask=l?&panel_drum[active_city][l-1][slot]:&panel_kick[active_city][slot];
+                *mask=draft.mask[l];
+            }
+            draft.ready=draft.preview=false;
+        }
+    }
+}
+static void panel_seq_release(unsigned key)
+{
+    if(held_seq_step==16||key!=held_seq_key)return;
+    if(page==PAGE_SEQ && active_city==held_seq_city && seq_current_slot()==held_seq_slot && fm1_ms-held_seq_at<275u){
+        unsigned bit=1u<<held_seq_step;
+        if(draft_matches(active_city,held_seq_slot))draft.mask[held_seq_lane]^=bit;
+        else if(held_seq_lane)panel_drum[active_city][held_seq_lane-1][held_seq_slot]^=bit;
+        else panel_kick[active_city][held_seq_slot]^=bit;
+    }
+    held_seq_step=16;panel_show();
+}
+static void panel_scan_knobs(void)
+{
+    const int32_t select=fm1_enc_take(ENC_SELECT);
+    if(select && page==PAGE_SAVE){
+        save_row=panel_cycle(save_row,select,5);save_kind=save_row;save_action=0;save_confirm=false;panel_show();
+    }
+    if (select && page != PAGE_SAVE) {
+        switch (page) {
+        case PAGE_GLO:
+            global_confirmation = 0;
+            global_row = panel_cycle(global_row, select, GLO_COUNT);
+            break;
+        case PAGE_SCL:
+            city_tonic[active_city] = (uint8_t)panel_cycle(city_tonic[active_city], select, 12);
+            groove_publish();
+            break;
+        case PAGE_EDIT:
+            if (edit_held) {
+                edit_used = true;
+                panel_select_layer(panel_layer_turn(selected_layer, select));
+            } else {
+                const unsigned count = panel_edit_count(selected_layer);
+                if (count) edit_row = panel_cycle(edit_row, select, count);
+            }
+            break;
+        case PAGE_SEQ:
+            if (seq_layer == 0) drum_lane = panel_cycle(drum_lane, select, 6);
+            else seq_layer = panel_layer_turn(seq_layer, select);
+            break;
+        default:
+            panel_select_layer(panel_layer_turn(selected_layer, select));
+            break;
+        }
+        panel_show();
+    }
+    const int32_t variation = fm1_enc_take(ENC_ALGORITHM);
+    const int32_t preset = fm1_enc_take(ENC_PRESETS);
+    if(page==PAGE_SAVE && variation && save_kind){save_action=panel_cycle(save_action,variation,3);save_confirm=false;panel_show();}
+    if (page == PAGE_GLO && variation) {
+        global_confirmation = 0;
+        panel_adjust_global(variation);
+    }
+    if ((page == PAGE_GLO || page == PAGE_SAVE) && preset) {
+        city_select(city_turn(active_city, preset), false);
+        global_confirmation = 0;
+        save_confirm = false;
+        panel_show();
+    }
+    if (page != PAGE_GLO && page != PAGE_SAVE) {
+        if (variation && page == PAGE_SCL) {
+            city_major[active_city] ^= (unsigned)variation & 1u;
+            groove_publish();
+            panel_show();
+        } else if (variation && page == PAGE_EDIT) {
+            if (variation & 1) *panel_voice_edits() ^= 1u << (24u + edit_row);
+            panel_show();
+        } else if (variation && page != PAGE_EDIT) {
+            const unsigned layer = page == PAGE_SEQ ? seq_layer : selected_layer;
+            uint8_t *value = &layer_variation[active_city][layer];
+            *value = (uint8_t)((*value + (uint32_t)variation) & 7u);
+            groove_publish();
+            panel_show();
+        }
+        if (preset && edit_held && (page == PAGE_HOME || page == PAGE_STAGE || page == PAGE_MIX || page == PAGE_FX)) {
+            edit_used = true;
+            if (fm1_ms - edit_at >= 120u) {
+                uint8_t *origin = &layer_origin[active_city][selected_layer];
+                const unsigned next = city_turn(*origin, preset);
+                if (selected_layer == 3 && next != *origin)
+                    city_lead_borrowed[active_city] = city_lead_home[next];
+                *origin = (uint8_t)next;
+                groove_publish();
+                panel_show();
+            }
+        } else if (preset) {
+            const unsigned city = city_turn(queued_city < CITY_COUNT ? queued_city : active_city, preset);
+            if (groove_enabled || qa_running)
+                queued_city = city == active_city ? CITY_COUNT : city;
+            else {
+                city_select(city, true);
+                panel_show();
+            }
+        }
+    }
+    unsigned context=page+(selected_layer<<4)+(active_city<<8);
+    if(context!=knob_context){memset(knob_coast,0,sizeof knob_coast);knob_context=context;}
+    for(unsigned knob=0;knob<4;knob++){
+        int32_t motion=fm1_enc_take(ENC_KNOB1+knob);
+        const bool physical=motion!=0;
+        if(!motion && knob_coast[knob] && fm1_ms-knob_coast_at[knob]>=50u){
+            motion=knob_coast[knob]>0?1:-1;knob_coast[knob]-=motion;knob_coast_at[knob]=fm1_ms;
+        }
+        if(!motion)continue;
+        if (page == PAGE_SEQ) {
+            if(held_seq_step<16 && fm1_ms-held_seq_at>=275u && active_city==held_seq_city && seq_current_slot()==held_seq_slot){
+                shape_full=!shape_set(step_key(active_city,held_seq_slot,held_seq_lane,held_seq_step),knob,motion);
+            }else if (knob == 3) seq_layer = panel_layer_turn(seq_layer, motion);
+            else if(seq_layer==0)panel_draft(knob,motion);
+            else continue;
+            panel_show();
+        } else if (page == PAGE_HOME || page == PAGE_STAGE || page == PAGE_MIX || page == PAGE_FX) {
+            uint8_t *value = page == PAGE_FX ? panel_fx[active_city][selected_layer]
+                                             : panel_mix[active_city][selected_layer];
+            const unsigned previous = value[knob];
+            const int32_t detents = motion < -43 ? -43 : motion > 43 ? 43 : motion;
+            const unsigned elapsed=fm1_ms-knob_previous_ms[knob], magnitude=detents<0?-detents:detents;
+            const int sign=detents<0?-1:1;
+            const unsigned speed=magnitude>=5?8:magnitude>=2?3:
+                physical && sign==knob_sign[knob] && elapsed<35?3:1;
+            if(physical){
+                knob_previous_ms[knob]=fm1_ms;knob_sign[knob]=sign;
+                knob_total[knob]+=magnitude;if(magnitude>knob_peak[knob])knob_peak[knob]=magnitude;
+                knob_coast[knob]=speed==8?4*sign:0;knob_coast_at[knob]=fm1_ms;
+            }
+            if(page==PAGE_MIX && mix_calibration){knob_coast[knob]=0;panel_show();continue;}
+            value[knob] = groove_adjust(value[knob], physical?detents*(int32_t)(3*speed):motion,0,127);
+            if (page != PAGE_FX && knob == MIX_VOL) {
+                if (value[knob] == 0) panel_set_layers(qa_ready_mask & ~(1u << selected_layer));
+                else if (value[knob] > previous && !all_layers_break)
+                    panel_set_layers(qa_ready_mask | (1u << selected_layer));
+            }
+            panel_publish();
+            panel_show();
+        } else if (page == PAGE_EDIT && knob < panel_edit_count(selected_layer)) {
+            edit_row = knob;
+            panel_voice_edit(knob,motion);
+            groove_publish();
+            panel_show();
+        } else if (page == PAGE_GLO) {
+            global_confirmation = 0;
+            global_row = knob;
+            panel_adjust_global(motion);
+        } else if (page == PAGE_SCL && knob < 2) {
+            if (knob == 0) city_tonic[active_city] = (uint8_t)panel_cycle(city_tonic[active_city], motion, 12);
+            else city_major[active_city] ^= (unsigned)motion & 1u;
+            groove_publish();
+            panel_show();
+        }
+    }
+}
+
+static bool panel_buttons(uint32_t b, uint32_t released)
+{
+    if (b & (1u << BTN_SAVE)) {
+        page = page == PAGE_SAVE ? PAGE_HOME : PAGE_SAVE;
+        save_row=save_kind=save_action=0;
+        save_confirm = false;
+        tempo_direction = 0;
+        panel_show();
+        return false;
+    }
+    if(page==PAGE_MIX){
+        if(b&(1u<<BTN_REC)){
+            mix_calibration=!mix_calibration;
+            if(mix_calibration){memset(knob_peak,0,sizeof knob_peak);memset(knob_total,0,sizeof knob_total);}
+            panel_show();
+        }
+        if(b&(1u<<BTN_LFO))listen_mask=1u<<selected_layer;
+        if(b&(1u<<BTN_ENV))listen_mask=63u^(1u<<selected_layer);
+    }
+    if(page!=PAGE_MIX || released&((1u<<BTN_LFO)|(1u<<BTN_ENV)))listen_mask=63;
+    if(page==PAGE_EDIT && selected_layer==3 && (b&(1u<<BTN_REC))){
+        city_ghost_grid[active_city]^=1;panel_show();
+    }
+    if (b & (1u << BTN_HOME)) {
+        page = page==PAGE_HOME?PAGE_STAGE:page==PAGE_STAGE?PAGE_MIX:PAGE_HOME;
+        stage_enabled = page == PAGE_STAGE;
+        panel_show();
+    }
+    if (b & (1u << BTN_FX)) {page = page == PAGE_FX ? PAGE_HOME : PAGE_FX; panel_show();}
+    if (b & (1u << BTN_EDIT)) {
+        edit_held = true;
+        edit_used = false;
+        edit_at = fm1_ms;
+    }
+    if (released & (1u << BTN_EDIT)) {
+        if (edit_held && !edit_used) {
+            page = page == PAGE_EDIT ? PAGE_HOME : PAGE_EDIT;
+            panel_show();
+        }
+        edit_held = false;
+    }
+    if (b & (1u << BTN_SEQ)) {
+        seq_held = true;
+        seq_fill_gesture = page == PAGE_HOME;
+        seq_fired = false;
+        seq_at = fm1_ms;
+    }
+    if (seq_held && seq_fill_gesture && !seq_fired &&
+        (page == PAGE_HOME) && fm1_ms - seq_at >= 350u) {
+        if ((groove_enabled & GROOVE_DRUMS) && !fill_active) fill_queued = !fill_queued;
+        seq_fired = true;
+    }
+    if (released & (1u << BTN_SEQ)) {
+        if (seq_held && !seq_fired) {
+            page = page == PAGE_SEQ ? PAGE_HOME : PAGE_SEQ;
+            if(page!=PAGE_SEQ)draft.ready=draft.preview=false;
+            panel_show();
+        }
+        seq_held = false;
+    }
+    if (b & (1u << BTN_GLO)) {
+        page = page == PAGE_GLO ? PAGE_HOME : PAGE_GLO;
+        global_confirmation = 0;
+        panel_show();
+    }
+    const int direction = b & (1u << BTN_OCT_UP) ? 1 :
+                          b & (1u << BTN_OCT_DOWN) ? -1 : 0;
+    if (page == PAGE_SAVE) {
+        if (direction < 0) {
+            save_confirm = false;
+        } else if (direction > 0) {
+            if (save_confirm) {
+                save_confirm = false;
+                panel_show();
+                return true;
+            }
+            save_confirm = true;
+        }
+        if (direction) panel_show();
+        return false;
+    }
+    if (b & (1u << BTN_SEL)) {
+        page = page == PAGE_SCL ? PAGE_HOME : PAGE_SCL;
+        panel_show();
+    }
+    if (b & (1u << BTN_PLAY)) panel_set_layers(qa_ready_mask ^ (GROOVE_DRUMS | GROOVE_BASS));
+    if (b & (1u << BTN_ARP)) panel_set_layers(qa_ready_mask ^ (1u << selected_layer));
+    if (b & ((1u << BTN_SEL) | (1u << BTN_PLAY) | (1u << BTN_ARP)))
+        panel_show();
+    GrooveEdit *edit = &groove_edits[active_city];
+    if (page != PAGE_GLO) {
+        if (direction && !tempo_direction) {
+            tempo_direction = direction;
+            tempo_start = edit->bpm;
+            tempo_at = fm1_ms;
+        }
+        if (tempo_direction) {
+            const uint32_t elapsed = fm1_ms - tempo_at;
+            const unsigned button = tempo_direction > 0 ? BTN_OCT_UP : BTN_OCT_DOWN;
+            int bpm = edit->bpm;
+            if (released & (1u << button)) {
+                bpm = elapsed < 250u ? tempo_start + tempo_direction :
+                      tempo_manual[active_city] ? bpm : tempo_start;
+                tempo_direction = 0;
+            } else if (elapsed >= 250u) {
+                const int progress = elapsed >= 3250u ? 3000 : (int)elapsed - 250;
+                const int end = tempo_direction > 0 ? 240 : 60;
+                bpm = tempo_start + (end - tempo_start) * progress / 3000;
+            }
+            bpm = groove_adjust(0, bpm, 60, 240);
+            if (edit->bpm != bpm) {
+                edit->bpm = (uint8_t)bpm;
+                groove_publish();
+                panel_show();
+            }
+        }
+        return false;
+    }
+    tempo_direction = 0;
+    if (!direction) return false;
+    panel_global_press(direction);
+    return false;
+}
diff --git a/firmware/src/mdma_qa.c b/firmware/src/mdma_qa.c
new file mode 100644
index 0000000..e2ecbcb
--- /dev/null
+++ b/firmware/src/mdma_qa.c
@@ -0,0 +1,204 @@
+static int32_t lead_sin(uint32_t phase);
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* Lab controls, clock handoff and bounded stereo echo. */
+static volatile unsigned qa_source, qa_running;
+static volatile uint32_t qa_ticks, qa_start_serial, qa_external_bpm = 132;
+static unsigned qa_ready_mask = 63;
+static uint32_t qa_last_clock, qa_beat_clock;
+static unsigned qa_beat_count;
+static bool qa_clock_seen, qa_save_pending;
+typedef struct {
+    unsigned phase;
+    int32_t phase_state[2][4];
+    int32_t phase_coeff;
+    unsigned phase_count;
+    bool phase_active; /* resets at zero wet */
+} LayerEffects;
+
+static LayerEffects layer_effects[LAYER_COUNT] __attribute__((section(".pool")));
+
+static int32_t mix_delay_send,mix_room_send;
+enum { MIX_VOL, MIX_PAN, MIX_FLT, MIX_RES, MIX_CONTROLS };
+enum { FX_REV, FX_DLY, FX_PHS, FX_SAT, FX_CONTROLS };
+static uint8_t panel_mix[CITY_COUNT][6][4], panel_fx[CITY_COUNT][LAYER_COUNT][FX_CONTROLS];
+static volatile uint16_t panel_kick[CITY_COUNT][32], panel_drum[CITY_COUNT][5][32];
+
+static uint16_t drum_edit_mask(unsigned city, unsigned lane, unsigned slot)
+{
+    return lane == 0 ? panel_kick[city][slot] : panel_drum[city][lane - 1u][slot];
+}
+static volatile uint32_t mix_controls[6], fx_controls[LAYER_COUNT];
+
+static uint32_t pack_controls(const uint8_t *v)
+{
+    return v[0] | (uint32_t)v[1]<<8 | (uint32_t)v[2]<<16 | (uint32_t)v[3]<<24;
+}
+
+static void panel_publish(void)
+{
+    for (unsigned layer = 0; layer < LAYER_COUNT; ++layer) {
+        mix_controls[layer] = pack_controls(panel_mix[active_city][layer]);
+        fx_controls[layer] = pack_controls(panel_fx[active_city][layer]);
+    }
+}
+static void panel_defaults(void)
+{
+    for(unsigned city=0;city<CITY_COUNT;city++) {
+        for(unsigned layer=0;layer<6;layer++){
+            panel_mix[city][layer][MIX_VOL]=102;
+            panel_mix[city][layer][MIX_PAN]=64;
+            panel_mix[city][layer][MIX_FLT]=64;
+            panel_mix[city][layer][MIX_RES]=64;
+        }
+        memset(panel_fx[city], 0, sizeof panel_fx[city]);
+    }
+    panel_publish();
+}
+
+#include "mdma_mix_tables.h"
+static volatile bool stage_enabled;
+static uint32_t stage_mix[LAYER_COUNT], stage_fx[LAYER_COUNT];
+static volatile unsigned listen_mask=63;
+static uint32_t heard_mix[6],heard_fx[6];
+static bool slew_ready;
+static void mixer_slew(void)
+{
+    static uint32_t state[6][8],previous[6][2];
+    static bool moving[6];
+    for(unsigned l=0;l<6;++l){
+        uint32_t target[]={stage_enabled?stage_mix[l]:mix_controls[l],stage_enabled?stage_fx[l]:fx_controls[l]};
+        if(!(listen_mask&(1u<<l)))target[0]&=~255u;
+        if(slew_ready && !moving[l] && previous[l][0]==target[0] && previous[l][1]==target[1])continue;
+        previous[l][0]=target[0];previous[l][1]=target[1];moving[l]=false;
+        uint32_t result[2]={0};
+        for(unsigned k=0;k<8;++k){
+            unsigned shift=(k&3u)*8u, goal=((target[k>>2]>>shift)&127u)<<12;
+            int diff=(int)goal-(int)state[l][k];
+            if(!slew_ready || (diff<32 && diff> -32))state[l][k]=goal;
+            else {state[l][k]+=diff*977/32768;moving[l]=true;}
+            result[k>>2]|=((state[l][k]+2048u)>>12)<<shift;
+        }
+        heard_mix[l]=result[0];heard_fx[l]=result[1];
+    }
+    slew_ready=true;
+}
+static unsigned stage_spark_len, stage_spark_remaining;
+static int stage_spark_side = 1;
+
+typedef struct {
+    int32_t s1[2], s2[2];
+    int32_t a1, a2, a3;
+    unsigned key;
+} MixFilter;
+static MixFilter mix_filter[LAYER_COUNT];
+static int32_t qa_filter(int32_t input, unsigned filter, unsigned resonance, MixFilter *m, unsigned ch)
+{
+    if (filter == 64) {
+        m->s1[ch]=m->s2[ch]=0;
+        return input;
+    }
+    const unsigned key = 1u + filter + (resonance<<8);
+    if (key != m->key) {
+        const int32_t g=mix_g[filter], k=mix_damp[resonance];
+        const int32_t denom=65536+(int32_t)(((int64_t)g*(g+k))>>16);
+        m->a1=(int32_t)(2147483647u/(unsigned)denom);
+        m->a2=(int32_t)(((int64_t)g*m->a1)>>16);
+        m->a3=(int32_t)(((int64_t)g*m->a2)>>16);
+        m->key=key;
+    }
+    const int32_t v3=input*256-m->s2[ch];
+    const int32_t band=(int32_t)(((int64_t)m->a1*m->s1[ch]+(int64_t)m->a2*v3)>>15);
+    const int32_t low=m->s2[ch]+(int32_t)(((int64_t)m->a2*m->s1[ch]+(int64_t)m->a3*v3)>>15);
+    m->s1[ch]=2*band-m->s1[ch];
+    m->s2[ch]=2*low-m->s2[ch];
+    const int32_t filtered=filter<64?low/256:input-low/256-(int32_t)(((int64_t)mix_damp[resonance]*band)>>24);
+    return input+(int32_t)(((int64_t)(filtered-input)*mix_wet[filter])>>15);
+}
+#ifdef MDMA_PANEL_LCD
+static volatile bool panel_meter_active;
+static unsigned meter_peaks[LAYER_COUNT];
+static volatile unsigned panel_pcm_peaks[LAYER_COUNT];
+static volatile unsigned panel_drum_position = ~0u;
+#endif
+
+static void qa_effects(LayerEffects *fx, uint32_t effects, int32_t *left, int32_t *right);
+
+static void qa_layer(unsigned layer, int32_t l, int32_t r, int32_t *left, int32_t *right)
+{
+    const uint32_t values=slew_ready?heard_mix[layer]:mix_controls[layer];
+    const unsigned vol=values&127u, pan=(values>>8)&127u, filter=(values>>16)&127u, res=values>>24;
+    l=qa_filter(l,filter,res,&mix_filter[layer],0);
+    r=qa_filter(r,filter,res,&mix_filter[layer],1);
+    l=l*(int32_t)vol/127;
+    r=r*(int32_t)vol/127;
+    const uint32_t effects = slew_ready?heard_fx[layer]:fx_controls[layer];
+    if ((effects || layer_effects[layer].phase_active) && ((groove_enabled & (1u<<layer)) || l || r || layer_effects[layer].phase_active))
+        qa_effects(&layer_effects[layer],effects,&l,&r);
+    static const int base_r[]={0,14,25,30,35,23},base_d[]={0,20,45,20,0,0};
+    const int32_t mono=layer==5?(l+r)*181/256:(l+r)/2;
+    mix_room_send+=mono*(base_r[layer]*127+65*(int32_t)(effects&127))/12700;
+    mix_delay_send+=mono*(base_d[layer]*127+65*(int32_t)(effects>>8&127))/12700;
+    if(pan>64){
+        if(layer==5) r+=l*(int32_t)(pan-64)*181/(63*256);
+        l=l*(127-(int32_t)pan)/63;
+    }
+    if(pan<64){
+        if(layer==5) l+=r*(64-(int32_t)pan)*181/(64*256);
+        r=r*(int32_t)pan/64;
+    }
+#ifdef MDMA_PANEL_LCD
+    if (panel_meter_active) {
+        const unsigned magnitude_l = (unsigned)(l < 0 ? -l : l);
+        const unsigned magnitude_r = (unsigned)(r < 0 ? -r : r);
+        const unsigned peak = magnitude_l > magnitude_r ? magnitude_l : magnitude_r;
+        if (peak > meter_peaks[layer]) meter_peaks[layer] = peak;
+    }
+#endif
+    *left += l;
+    *right += r;
+}
+
+static int16_t qa_clip16(int32_t value)
+{
+    return (int16_t)(value>32767?32767:value< -32768?-32768:value);
+}
+static void qa_effects(LayerEffects *fx, uint32_t effects, int32_t *left, int32_t *right)
+{
+    const unsigned phs=(effects>>16)&127u, sat=effects>>24;
+    if(phs){
+        if(!fx->phase_active){
+            static const uint32_t initial[]={0,715827883u,2147483648u,2863311531u,1431655765u,3579139413u};
+            fx->phase=initial[fx-layer_effects];
+            fx->phase_count=0;
+            fx->phase_active=true;
+        }
+        if(!(fx->phase_count++ & 15u)){
+            fx->phase_coeff=mix_phaser[(unsigned)(32768+lead_sin(fx->phase))>>9];
+            fx->phase+=436314u;
+        }
+        int32_t *channels[]={left,right};
+        for(unsigned c=0;c<2;c++){
+            int32_t x=*channels[c];
+            for(unsigned i=0;i<4;i++){
+                const int32_t y=fx->phase_state[c][i]+(int32_t)(((int64_t)x*fx->phase_coeff)>>15);
+                fx->phase_state[c][i]=x-(int32_t)(((int64_t)y*fx->phase_coeff)>>15);
+                x=y;
+            }
+            *channels[c]+=(x-*channels[c])*(int32_t)phs/254;
+        }
+    } else if(fx->phase_active){
+        memset(fx->phase_state,0,sizeof fx->phase_state);
+        fx->phase_active=false;
+    }
+    if(sat){
+        int32_t *channels[]={left,right};
+        for(unsigned c=0;c<2;c++){
+            const int32_t x=*channels[c];
+            const int32_t driven=x + x*(int32_t)sat*2/127;
+            const unsigned mag=(unsigned)(driven<0?-driven:driven);
+            const unsigned index=mag/768u, rem=mag%768u;
+            const int32_t curve=index>=128u?32767:mix_tanh[index]+(mix_tanh[index+1]-mix_tanh[index])*(int32_t)rem/768;
+            *channels[c]+=((driven<0?-curve:curve)-x)*(int32_t)sat/127;
+        }
+    }
+}
diff --git a/firmware/src/mdma_returns.c b/firmware/src/mdma_returns.c
new file mode 100644
index 0000000..04caec7
--- /dev/null
+++ b/firmware/src/mdma_returns.c
@@ -0,0 +1,94 @@
+/* Stereo Freeverb topology and dotted-eighth return at the FM-1 sample rate. */
+static int16_t delay_line[33077] __attribute__((section(".pool")));
+enum { ROOM_SAMPLES=1116+1188+1277+1356+1422+1491+1557+1617+556+441+341+225 };
+static int16_t room_lines[2*ROOM_SAMPLES+12*23] __attribute__((section(".pool")));
+static unsigned room_index[2][12], delay_index;
+static int32_t room_damp[2][8];
+static VoiceFilter return_lp[2],master_hp[2],master_shelf[2];
+static int32_t comp_envelope[3];
+static int32_t comp_gain(unsigned kind,int32_t l,int32_t r)
+{
+    static const int32_t attack[]={2432020,6069730,12105530}, release[]={97387,152163,243451};
+    static const int32_t *const table[]={mix_comp0,mix_comp1,mix_comp2};
+    int32_t pk=l<0?-l:l, rp=r<0?-r:r;
+    if(rp>pk) pk=rp;
+    int32_t delta=pk*256-comp_envelope[kind];
+    comp_envelope[kind]+=(int32_t)(((int64_t)delta*(delta>0?attack[kind]:release[kind]))>>30);
+    unsigned x=(unsigned)comp_envelope[kind]>>8, i=x>>7;
+    if(i>=1024)return table[kind][1024];
+    return table[kind][i]+((table[kind][i+1]-table[kind][i])*(int32_t)(x&127)>>7);
+}
+static int32_t room_run(unsigned ch,int32_t input)
+{
+    static const uint16_t lengths[]={1116,1188,1277,1356,1422,1491,1557,1617,556,441,341,225};
+    unsigned offset=ch*ROOM_SAMPLES;
+    int32_t sum=0;
+    for(unsigned k=0;k<12;++k){
+        unsigned idx=room_index[ch][k], n=lengths[k]+ch*23;
+        int16_t *cell=&room_lines[offset+idx];
+        int32_t y=*cell;
+        if(k<8){
+            int32_t f=(3*y+room_damp[ch][k])/4;
+            room_damp[ch][k]=f;
+            *cell=qa_clip16(input+f*89/100);
+            sum+=y;
+        }else{
+            *cell=qa_clip16(sum+y/2);
+            sum=y-sum;
+        }
+        room_index[ch][k]=idx+1==n?0:idx+1;
+        offset+=n;
+    }
+    return sum;
+}
+static int32_t signed_tanh(int32_t x)
+{
+    const unsigned mag=(unsigned)(x<0?-x:x), i=mag/768u;
+    const int32_t v=i>=128?32767:mix_tanh[i]+(mix_tanh[i+1]-mix_tanh[i])*(int32_t)(mag%768)/768;
+    return x<0?-v:v;
+}
+static void master_mix(unsigned city,unsigned delay_frames,int32_t drums[2],int32_t bass[2],int32_t synth[2],int32_t *out)
+{
+    /* An empty network has no output. Skip it from boot and after the taps have decayed. */
+    static unsigned tail_frames;
+    if(drums[0]||drums[1]||bass[0]||bass[1]||synth[0]||synth[1]||mix_room_send||mix_delay_send)
+        tail_frames=12u*44100u;
+    else if(tail_frames)--tail_frames;
+    else return;
+    static unsigned previous=~0u;
+    const unsigned profile=city_pattern_bank(city);
+    const CityTimbre *p=&city_timbres[profile];
+    if(previous!=profile){
+        voice_filter_set(&return_lp[0],0,2200,29205);
+        voice_filter_set(&return_lp[1],0,p->rvLp>>16,29205);
+        for(unsigned c=0;c<2;++c){
+            voice_filter_set(&master_hp[c],1,28,32768);
+            master_shelf[c]=(VoiceFilter){.b0=SHELF_B0,.b1=SHELF_B1,.b2=SHELF_B2,.a1=SHELF_A1,.a2=SHELF_A2};
+        }
+        previous=profile;
+    }
+    unsigned rd=delay_index+33077u-delay_frames;
+    if(rd>=33077u)rd-=33077u;
+    const int32_t wet=voice_filter(&return_lp[0],delay_line[rd]);
+    delay_line[delay_index]=qa_clip16(mix_delay_send+(int32_t)((int64_t)wet*p->dlFb>>16));
+    if(++delay_index==33077u)delay_index=0;
+    const int32_t rin=voice_filter(&return_lp[1],mix_room_send)*6/100;
+    int32_t dyn=comp_gain(0,synth[0],synth[1]);
+    int32_t pair[2];
+    for(unsigned c=0;c<2;++c){
+        int32_t rv=(int32_t)((int64_t)room_run(c,rin)*p->rvLvl*6>>16);
+        int32_t dry=drums[c]+(bass[c]+(int32_t)((int64_t)wet*p->dlLvl>>16)+rv+(int32_t)((int64_t)synth[c]*dyn/40960))*7/10;
+        dry=signed_tanh(qa_clip16(dry)/2)*32768/15143;
+        pair[c]=voice_filter(&master_hp[c],voice_filter(&master_shelf[c],dry));
+    }
+    for(unsigned k=1;k<=2;++k){
+        dyn=comp_gain(k,pair[0],pair[1]);
+        for(unsigned c=0;c<2;++c)pair[c]=(int32_t)((int64_t)pair[c]*dyn>>15);
+    }
+    for(unsigned c=0;c<2;++c){
+        int32_t x=(int32_t)((int64_t)pair[c]*p->master>>16);
+        const int32_t mag=x<0?-x:x;
+        if(mag>26214){const int32_t y=26214+signed_tanh((mag-26214)*5)/5;x=x<0?-y:y;}
+        out[c]+=x;
+    }
+}
diff --git a/firmware/src/mdma_save_probe.c b/firmware/src/mdma_save_probe.c
new file mode 100644
index 0000000..6a73c90
--- /dev/null
+++ b/firmware/src/mdma_save_probe.c
@@ -0,0 +1,433 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#define MDMA_STORAGE_UNITY
+#include "storage.c"
+
+#define GROOVE_BASE 0xB1000u
+#define GROOVE_SECTOR 4096u
+#define GROOVE_END (GROOVE_BASE + 2u * GROOVE_SECTOR)
+#define GROOVE_LEGACY 22u
+#define GROOVE_V2 (GROOVE_LEGACY + 2u * 92u)
+#define GROOVE_V3_CITY (115u + 5u * 32u * 2u + LAYER_COUNT * FX_CONTROLS)
+#define GROOVE_V3 (8u + FACTORY_COUNT * GROOVE_V3_CITY)
+#define GROOVE_V4_CITY (GROOVE_V3_CITY + 16u)
+#define GROOVE_V4 (8u + FACTORY_COUNT * GROOVE_V4_CITY)
+#define GROOVE_V5_CITY (GROOVE_V4_CITY + 1u)
+#define GROOVE_V5 (8u + CITY_COUNT * GROOVE_V5_CITY)
+#define GROOVE_CITY_BYTES (GROOVE_V5_CITY + 5u*4u)
+#define SHAPE_START (8u + CITY_COUNT * GROOVE_CITY_BYTES)
+#define GROOVE_RECORD (SHAPE_START + sizeof step_shapes)
+_Static_assert(GROOVE_RECORD <= GROOVE_SECTOR - MDMA_STORE_HEADER - 4u, "city records exceed SAVE slot");
+_Static_assert(FL_GUARD(GROOVE_BASE, 2u * GROOVE_SECTOR), "groove pair outside app store");
+static MdmaStore groove_store;
+static bool groove_save_ready,background_save;
+#define POINT_BASE 0xF4000u
+_Static_assert(FL_GUARD(POINT_BASE,8u*GROOVE_SECTOR),"return points outside store");
+static unsigned save_row,save_action,save_kind;
+static bool point_available[5],point_present[5];
+static unsigned point_physical(uint32_t a)
+{
+    return a<GROOVE_END?a:POINT_BASE+(a-GROOVE_END);
+}
+static uint8_t tempo_manual[CITY_COUNT];
+
+static bool groove_read(void *ctx, uint32_t a, void *p, uint32_t n)
+{
+    (void)ctx;
+    return FL_IN(a,n,GROOVE_BASE,GROOVE_BASE+10u*GROOVE_SECTOR) && st_read(point_physical(a),p,n)==0;
+}
+static bool groove_write(void *ctx, uint32_t a, const void *p, uint32_t n)
+{
+    (void)ctx;
+    return FL_IN(a,n,GROOVE_BASE,GROOVE_BASE+10u*GROOVE_SECTOR) && fl_write(point_physical(a),p,n)==0;
+}
+static void groove_encode(uint8_t *p)
+{
+    memset(p, 0, GROOVE_RECORD);
+    put32(p, 0x3652474Du); /* MGR6 */
+    p[4] = active_city;
+    p[5] = city_count;
+    memcpy(p+SHAPE_START,step_shapes,sizeof step_shapes);
+    for (unsigned city = 0; city < city_count; ++city) {
+        const GrooveEdit *e = &groove_edits[city];
+        uint8_t *record = p + 8u + city * GROOVE_CITY_BYTES;
+        unsigned pos=GROOVE_V5_CITY;
+        for(unsigned l=0;l<LAYER_COUNT;++l) if(l!=3){put32(record+pos,city_voice_edit[city][l]);pos+=4;}
+        record[0] = e->bpm; record[1] = e->scene; record[2] = layer_variation[city][0];
+        record[3] = e->drum; record[4] = e->bass; record[5] = e->tone; record[6] = e->lead;
+        memcpy(record + 7, panel_mix[city], 24);
+        memset(record + 31, 0, 4);
+        record[31] = city_lead_alien[city];
+        record[32] = city_bass_alien[city];
+        record[33] = city_ghost_grid[city];
+        record[GROOVE_V4_CITY] = city_recipe[city];
+        memcpy(record + GROOVE_V3_CITY - LAYER_COUNT * FX_CONTROLS,
+               panel_fx[city], sizeof panel_fx[city]);
+        for (unsigned slot = 0; slot < 32; ++slot) {
+            const uint16_t mask = panel_kick[city][slot];
+            record[35 + 2 * slot] = (uint8_t)mask;
+            record[36 + 2 * slot] = (uint8_t)(mask >> 8);
+        }
+        memcpy(record + 99, layer_variation[city], LAYER_COUNT);
+        memcpy(record + 105, layer_origin[city], LAYER_COUNT);
+        record[111] = city_tonic[city];
+        record[112] = city_major[city];
+        record[113] = city_swing[city];
+        record[114] = tempo_manual[city];
+        put32(record + GROOVE_V3_CITY, city_lead_home[city]);
+        put32(record + GROOVE_V3_CITY + 4u, city_lead_borrowed[city]);
+        put32(record + GROOVE_V3_CITY + 8u, city_ghost_time_q12[city]);
+        put32(record + GROOVE_V3_CITY + 12u, (uint32_t)city_ghost_offset[city]);
+        for (unsigned lane = 0; lane < 5; ++lane) {
+            for (unsigned slot = 0; slot < 32; ++slot) {
+                const unsigned offset = 115u + 2u * (lane * 32u + slot);
+                const uint16_t mask = panel_drum[city][lane][slot];
+                record[offset] = (uint8_t)mask;
+                record[offset + 1] = (uint8_t)(mask >> 8);
+            }
+        }
+    }
+}
+
+static bool valid_lead_edits(uint32_t value)
+{
+    if (value >> 28) return false;
+    for (unsigned parameter = 0; parameter < LEAD_EDIT_COUNT; ++parameter) {
+        const int32_t detent = lead_edit_detent(value, parameter);
+        if (detent < -20 || detent > 20) return false;
+    }
+    return true;
+}
+
+static bool groove_decode(const uint8_t *p, uint32_t n, bool apply)
+{
+    if (n != GROOVE_LEGACY && n != GROOVE_V2 && n != GROOVE_V3 && n != GROOVE_V4 && n != GROOVE_V5 && n != GROOVE_RECORD) return false;
+    const unsigned version = n == GROOVE_RECORD ? 6u : n == GROOVE_V5 ? 5u : n == GROOVE_V4 ? 4u : n == GROOVE_V3 ? 3u : n == GROOVE_V2 ? 2u : 1u;
+    const unsigned cities = version >= 5u ? p[5] : version >= 3u ? FACTORY_COUNT : 2u;
+    const unsigned city_bytes = version == 6u ? GROOVE_CITY_BYTES : version == 5u ? GROOVE_V5_CITY : version == 4u ? GROOVE_V4_CITY
+                                               : version == 3u ? GROOVE_V3_CITY : 7u;
+    if (get32(p) != (0x3052474Du | version << 24) || p[4] >= cities || p[6] || p[7]) return false;
+    if (version >= 5u ? (cities < FACTORY_COUNT || cities > CITY_COUNT) : p[5] > (version == 1u)) return false;
+    uint32_t used_recipes = 0;
+
+    for (unsigned city = 0; city < cities; ++city) {
+        const uint8_t *e = p + 8u + city * city_bytes;
+        if (e[0] < 60 || e[0] > 240 || e[1] > 3 || e[2] > 7 ||
+            e[3] > 100 || e[4] > 100 || e[5] > 100 || e[6] > LEAD_CUTOFF_LAST) return false;
+        if (version != 1u) {
+            const uint8_t *ext = version >= 3u ? e + 7 : p + GROOVE_LEGACY + city * 92u;
+            for (unsigned k = 0; k < 28; ++k)
+                if (ext[k] > 127) return false;
+        }
+        if (version >= 3u) {
+            if (e[111] > 11 || e[112] > 1 || e[113] > 40 || e[114] > 1 || e[31] > 1) return false;
+            for (unsigned i = GROOVE_V3_CITY - LAYER_COUNT * FX_CONTROLS; i < GROOVE_V3_CITY; ++i)
+                if (e[i] > 127) return false;
+        }
+        if (version >= 5u) {
+            const unsigned recipe = e[GROOVE_V4_CITY];
+            if (e[32] > 1 || recipe > RECIPE_COUNT ||
+                ((city < FACTORY_COUNT) != (recipe == 0)) ||
+                (recipe && (used_recipes & (1u << recipe)))) return false;
+            if (recipe) used_recipes |= 1u << recipe;
+        }
+        if(version==6u && e[33]>1)return false;
+        if(version==6u) for(unsigned k=0;k<5;++k)
+            if(!valid_lead_edits(get32(e+GROOVE_V5_CITY+4u*k))) return false;
+        if (version >= 4u) {
+            const int32_t offset = (int32_t)get32(e + GROOVE_V3_CITY + 12u);
+            if (offset < -32768 || offset > 32768 ||
+                !valid_lead_edits(get32(e + GROOVE_V3_CITY)) ||
+                !valid_lead_edits(get32(e + GROOVE_V3_CITY + 4u))) return false;
+        }
+        if (version >= 3u)
+            for (unsigned layer = 0; layer < LAYER_COUNT; ++layer)
+                if (e[99 + layer] > 7 || e[105 + layer] >= cities) return false;
+    }
+    if(version==6u){
+        for(unsigned i=0;i<SHAPE_CAP;++i){
+            const uint8_t *e=p+SHAPE_START+i*6u;
+            const unsigned key=e[0]+256u*e[1];
+            if(key>cities*32u*6u*16u)return false;
+            for(unsigned j=0;j<4;++j)if((int8_t)e[2+j]<-10||(int8_t)e[2+j]>10)return false;
+            for(unsigned j=0;key && j<i;++j){
+                const uint8_t *other=p+SHAPE_START+j*6;
+                if(other[0]==e[0] && other[1]==e[1])return false;
+            }
+        }
+    }
+    if (!apply) return true;
+    if(version==6u)memcpy(step_shapes,p+SHAPE_START,sizeof step_shapes);
+    else memset(step_shapes,0,sizeof step_shapes);
+    draft.ready=draft.preview=false;
+
+    active_city = p[4];
+    city_count = cities < FACTORY_COUNT ? FACTORY_COUNT : (uint8_t)cities;
+    for (unsigned city = 0; city < cities; ++city) {
+        const uint8_t *e = p + 8u + city * city_bytes;
+        groove_edits[city] = (GrooveEdit){e[0], e[1], e[2], e[3], e[4], e[5], e[6]};
+        for (unsigned layer = 0; layer < LAYER_COUNT; ++layer) {
+            layer_variation[city][layer] = version >= 3u ? e[99 + layer] : e[2];
+            layer_origin[city][layer] = version >= 3u ? e[105 + layer] : (uint8_t)city;
+        }
+        unsigned pos=GROOVE_V5_CITY;
+        for(unsigned l=0;l<LAYER_COUNT;++l) if(l!=3){
+            city_voice_edit[city][l]=version==6u?get32(e+pos):0;pos+=4;
+        }
+        city_tonic[city] = version >= 3u ? e[111] : 0;
+        city_major[city] = version >= 3u ? e[112] : 0;
+        city_swing[city] = version >= 3u ? e[113] : 10;
+        tempo_manual[city] = version >= 3u ? e[114] : 0;
+        city_lead_alien[city] = version >= 3u ? e[31] : 0;
+        city_ghost_grid[city]=version==6u?e[33]:0;
+        city_bass_alien[city] = version >= 5u ? e[32] : 0;
+        city_recipe[city] = version >= 5u ? e[GROOVE_V4_CITY] : 0;
+        const uint32_t legacy_cutoff = (uint32_t)((int32_t)e[6] - LEAD_CUTOFF_DEFAULT) & 63u;
+        city_lead_home[city] = version >= 4u ? get32(e + GROOVE_V3_CITY) : legacy_cutoff;
+        city_lead_borrowed[city] = version >= 4u ? get32(e + GROOVE_V3_CITY + 4u) : legacy_cutoff;
+        city_ghost_time_q12[city] = version >= 4u ? get32(e + GROOVE_V3_CITY + 8u) : 0;
+        city_ghost_offset[city] = version >= 4u ? (int32_t)get32(e + GROOVE_V3_CITY + 12u) : 0;
+        for (unsigned lane = 0; lane < 5; ++lane) {
+            for (unsigned slot = 0; slot < 32; ++slot) {
+                const unsigned offset = 115u + 2u * (lane * 32u + slot);
+                panel_drum[city][lane][slot] = version >= 3u
+                    ? (uint16_t)(e[offset] | (uint16_t)e[offset + 1] << 8) : 0;
+            }
+        }
+        if (version == 1u) {
+            memset(panel_fx[city], 0, sizeof panel_fx[city]);
+            for (unsigned layer = 0; layer < LAYER_COUNT; ++layer)
+                panel_fx[city][layer][FX_DLY] = p[5] ? 127 : 0;
+        } else {
+            const uint8_t *ext = version >= 3u ? e + 7 : p + GROOVE_LEGACY + city * 92u;
+            memcpy(panel_mix[city], ext, 24);
+            if (version >= 3u) {
+                memcpy(panel_fx[city], e + GROOVE_V3_CITY - LAYER_COUNT * FX_CONTROLS,
+                       sizeof panel_fx[city]);
+            } else {
+                for (unsigned layer = 0; layer < LAYER_COUNT; ++layer)
+                    memcpy(panel_fx[city][layer], ext + 24, FX_CONTROLS);
+            }
+            for (unsigned slot = 0; slot < 32; ++slot)
+                panel_kick[city][slot] = (uint16_t)(ext[28 + 2 * slot] | (uint16_t)ext[29 + 2 * slot] << 8);
+        }
+    }
+    groove_tone = groove_edits[active_city].tone;
+    lead_cutoff_turn((int32_t)groove_edits[active_city].lead - lead_cutoff_position);
+    groove_publish();
+    panel_publish();
+    ++lead_recall_serial;
+    return true;
+}
+enum { FLASH_UNKNOWN, FLASH_BLANK, FLASH_OWNED };
+static unsigned groove_slot(unsigned slot, uint8_t *payload, uint32_t *sequence, uint32_t *length)
+{
+    const uint32_t a=GROOVE_BASE+slot*GROOVE_SECTOR;
+    uint32_t n=0;
+    *sequence=check_slot(&groove_store,(uint8_t)(slot/2),(uint8_t)(slot&1),&n);
+    if(*sequence && (n==GROOVE_RECORD || n==GROOVE_V5 || n==GROOVE_V4 || n==GROOVE_V3 || n==GROOVE_V2 || n==GROOVE_LEGACY) && groove_read(0,a+MDMA_STORE_HEADER,payload,n) &&
+       groove_decode(payload,n,false)) {if(length) *length=n;return FLASH_OWNED;}
+    if(slot>=2 && *sequence && n==1 && groove_read(0,a+MDMA_STORE_HEADER,payload,1) && !payload[0]) {if(length)*length=1;return FLASH_OWNED;}
+    *sequence=0;
+    uint8_t part[128];
+    for(unsigned i=0;i<GROOVE_SECTOR;i+=sizeof part) {
+        if(!groove_read(0,a+i,part,sizeof part)) return FLASH_UNKNOWN;
+        for(unsigned j=0;j<sizeof part;j++) if(part[j]!=255) return FLASH_UNKNOWN;
+    }
+    return FLASH_BLANK;
+}
+static bool groove_erase(void *ctx,uint32_t addr)
+{
+    (void)ctx;
+    if(!FL_IN(addr,GROOVE_SECTOR,GROOVE_BASE,GROOVE_BASE+10u*GROOVE_SECTOR) || (addr&4095u))return false;
+    uint8_t p[GROOVE_RECORD];
+    uint32_t seq,ticks;
+    return groove_slot((addr-GROOVE_BASE)/GROOVE_SECTOR,p,&seq,0)!=FLASH_UNKNOWN &&
+           fl_erase4k(point_physical(addr),&ticks)==0;
+}
+#ifdef MDMA_PANEL_LCD
+static void panel_set_notice(const char *text);
+static void groove_show(const char *text)
+{
+    panel_set_notice(text);
+}
+#else
+static void groove_show(const char *text)
+{
+    draw_text_box(0,196,240,&FONT_S,text,C_OFF,1);
+}
+#endif
+static void groove_show_settings(void)
+{
+#ifndef MDMA_PANEL_LCD
+    const GrooveEdit *e=&groove_edits[active_city];
+    char line[]="BUZIOS S1 V1 BPM 132";
+    const CityRecipe *recipe = city_get_recipe(active_city);
+    const char *city = recipe ? recipe->name : city_label[active_city];
+    unsigned length = 0;
+    while (city[length] && length < 6u) { line[length] = city[length]; ++length; }
+    while (length < 6) line[length++] = ' ';
+    line[8]=(char)('1'+e->scene);
+    line[11]=(char)('1'+layer_variation[active_city][0]);
+    line[17]=(char)('0'+e->bpm/100);
+    line[18]=(char)('0'+e->bpm/10%10);
+    line[19]=(char)('0'+e->bpm%10);
+    groove_show(line);
+#endif
+}
+static void save_probe_boot(void)
+{
+    const MdmaFlash f={groove_read,groove_write,groove_erase,0,GROOVE_BASE,GROOVE_SECTOR};
+    if(!flash_ok || !mdma_store_init(&groove_store,&f)) {
+        groove_show("SAVE UNAVAILABLE");return;
+    }
+    uint8_t a[GROOVE_RECORD],b[GROOVE_RECORD];
+    uint32_t sa,sb,na=0,nb=0;
+    const unsigned va=groove_slot(0,a,&sa,&na),vb=groove_slot(1,b,&sb,&nb);
+    groove_save_ready=va!=FLASH_UNKNOWN && vb!=FLASH_UNKNOWN;
+    for(unsigned k=1;k<=4;++k){
+        uint32_t x,y,nx=0,ny=0;
+        unsigned first=groove_slot(k*2,a,&x,&nx), second=groove_slot(k*2+1,b,&y,&ny);
+        point_available[k]=first!=FLASH_UNKNOWN && second!=FLASH_UNKNOWN;
+        point_present[k]=(x>y?nx:ny)>1;
+    }
+    if(sa)groove_slot(0,a,&sa,&na);
+    if(sb)groove_slot(1,b,&sb,&nb);
+    if(sa||sb) {
+        groove_decode(sa>=sb?a:b,sa>=sb?na:nb,true);
+        groove_show_settings();
+    } else groove_show(groove_save_ready?"NO GROOVE SAVE":"SAVE AREA USED");
+}
+static void city_select(unsigned city, bool preserve_performance)
+{
+    if(mdma_store_pending(&groove_store)) return;
+    groove_edits[active_city].lead=(uint8_t)lead_cutoff_position;
+    const unsigned old = active_city;
+    if (preserve_performance) {
+        groove_edits[city].bpm = groove_edits[old].bpm;
+        groove_edits[city].scene = groove_edits[old].scene;
+        city_tonic[city] = city_tonic[old];
+        city_major[city] = city_major[old];
+        memcpy(layer_variation[city], layer_variation[old], LAYER_COUNT);
+    }
+    active_city = (uint8_t)city;
+    const GrooveEdit *e=&groove_edits[active_city];
+    lead_cutoff_turn((int32_t)e->lead-lead_cutoff_position);
+    groove_tone=e->tone;
+    groove_publish();
+    panel_publish();
+    groove_show_settings();
+}
+static bool point_restore(unsigned kind)
+{
+    static uint8_t current[GROOVE_RECORD],saved[GROOVE_RECORD];
+    uint32_t n;
+    if(!mdma_store_load(&groove_store,kind,saved,sizeof saved,&n)||n!=GROOVE_RECORD||
+       !groove_decode(saved,n,false))return false;
+    groove_encode(current);
+    unsigned from=saved[4], to=from;
+    uint8_t *row=saved+8u+from*GROOVE_CITY_BYTES;
+    if(from>=FACTORY_COUNT){
+        for(to=FACTORY_COUNT;to<city_count && city_recipe[to]!=row[GROOVE_V4_CITY];++to){}
+        if(to==city_count)return false;
+    }
+    for(unsigned l=0;l<LAYER_COUNT;++l){
+        unsigned origin=row[105+l];
+        if(origin>=FACTORY_COUNT){
+            unsigned id=saved[8+origin*GROOVE_CITY_BYTES+GROOVE_V4_CITY];
+            for(origin=FACTORY_COUNT;origin<city_count && city_recipe[origin]!=id;++origin){}
+            if(origin==city_count)origin=to;
+        }
+        row[105+l]=(uint8_t)origin;
+    }
+    StepShape merged[SHAPE_CAP];
+    memset(merged,0,sizeof merged);
+    unsigned count=0;
+    for(unsigned i=0;i<SHAPE_CAP;++i)
+        if(step_shapes[i].key && (step_shapes[i].key-1u)/3072u!=to)merged[count++]=step_shapes[i];
+    for(unsigned i=0;i<SHAPE_CAP;++i){
+        StepShape copy;
+        memcpy(&copy,saved+SHAPE_START+i*6,6);
+        if(!copy.key || (copy.key-1u)/3072u!=from)continue;
+        if(count==SHAPE_CAP)return false;
+        copy.key=(uint16_t)(1u+to*3072u+(copy.key-1u)%3072u);merged[count++]=copy;
+    }
+    memcpy(current+SHAPE_START,merged,sizeof merged);
+    memcpy(current+8+to*GROOVE_CITY_BYTES,row,GROOVE_CITY_BYTES);
+    current[4]=(uint8_t)to;
+    queued_city=CITY_COUNT;
+    return groove_decode(current,sizeof current,true);
+}
+static void save_probe_poll(bool pressed)
+{
+    if(!mdma_store_pending(&groove_store))background_save=false;
+    if(pressed && save_kind && save_action==1){
+        groove_show(point_restore(save_kind)?"POINT LOADED":"POINT UNAVAILABLE");return;
+    }
+    if(pressed && (save_kind?!point_available[save_kind]:!groove_save_ready)) {groove_show("SAVE BLOCKED");return;}
+    if(pressed && !mdma_store_pending(&groove_store)){
+        uint8_t p[GROOVE_RECORD];
+        groove_edits[active_city].lead=(uint8_t)lead_cutoff_position;
+        groove_encode(p);
+        if(save_kind && save_action==2)p[0]=0;
+        if(!mdma_store_request(&groove_store,save_kind,p,save_kind&&save_action==2?1:sizeof p)) {groove_show("SAVE FAIL");return;}
+        groove_enabled=0;
+        groove_show("STOPPING FOR SAVE");
+        return;
+    }
+    if(!groove_save_ready && !mdma_store_pending(&groove_store)) return;
+    const MdmaStoreStep status=mdma_store_service(&groove_store,quiet()&&!fm1_in.notes);
+    if(status==MDMA_STORE_DONE){
+        uint8_t record[GROOVE_RECORD];
+        uint32_t n;
+        const unsigned kind=groove_store.kind;
+        bool ok=mdma_store_load(&groove_store,kind,record,sizeof record,&n) && n==groove_store.stage_len && ((kind && n==1 && record[0]==0)||groove_decode(record,n,false));
+        for(unsigned i=0;ok&&i<n;i++) if(record[i]!=groove_store.stage[i]) ok=false;
+        if(ok && kind)point_present[kind]=n>1;
+        groove_show(ok?(kind?(n==1?"POINT DELETED":"POINT SAVED"):"GROOVE SAVED"):"SAVE VERIFY FAIL");
+    } else if(status==MDMA_STORE_FAILED) {
+        if(groove_store.kind)point_available[groove_store.kind]=false;else groove_save_ready=false;
+        groove_show("SAVE FAIL");
+    }
+}
+
+static uint8_t groove_adjust(uint8_t value, int32_t delta, int lo, int hi)
+{
+    const int32_t next = (int32_t)value + delta;
+    return (uint8_t)(next < lo ? lo : next > hi ? hi : next);
+}
+
+
+#if defined(MDMA_PANEL_LCD) || defined(TEST_AUTOSAVE)
+enum { AUTOSAVE_SILENCE_MS=33000u };
+static uint32_t autosave_hash,autosave_quiet_at,autosave_serial,autosave_check;
+static bool autosave_done_check;
+
+static uint32_t autosave_fingerprint(uint8_t *work)
+{
+    groove_encode(work);
+    for(unsigned i=0;i<city_count;++i)put32(work+8+i*GROOVE_CITY_BYTES+GROOVE_V3_CITY+8,0);
+    return mdma_crc32(work,GROOVE_RECORD);
+}
+static void groove_autosave_boot(void)
+{
+    uint8_t work[GROOVE_RECORD];
+    autosave_hash=autosave_fingerprint(work);
+    autosave_quiet_at=fm1_ms;autosave_serial=audio_activity_serial;
+    autosave_done_check=false;
+}
+static void groove_autosave(void)
+{
+    const uint32_t now=fm1_ms, activity=audio_activity_serial;
+    if(!quiet() || fm1_in.notes || qa_running || activity!=autosave_serial){
+        autosave_quiet_at=now;autosave_serial=activity;autosave_done_check=false;return;
+    }
+    if(now-autosave_quiet_at<AUTOSAVE_SILENCE_MS || !groove_save_ready || qa_save_pending ||
+       mdma_store_pending(&groove_store) || (autosave_done_check && now-autosave_check<1000u))return;
+    autosave_check=now;autosave_done_check=true;
+    static uint8_t work[GROOVE_RECORD];
+    uint32_t hash=autosave_fingerprint(work);
+    if(hash==autosave_hash)return;
+    groove_encode(work);
+    if(mdma_store_request(&groove_store,0,work,sizeof work)){autosave_hash=hash;background_save=true;}
+}
+#endif
