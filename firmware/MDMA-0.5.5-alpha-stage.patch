diff --git a/tools/mdma_lead_tables.py b/tools/mdma_lead_tables.py
new file mode 100644
index 0000000..757df50
--- /dev/null
+++ b/tools/mdma_lead_tables.py
@@ -0,0 +1,63 @@
+"""Generate fixed-point tables for the stable-v0.5 lead at 44.1 kHz."""
+import math
+from pathlib import Path
+
+RATE = 44100
+TABLE = Path(__file__).resolve().parents[1] / "firmware/src/mdma_lead_tables.h"
+Q = 1 << 28
+
+
+def lowpass(frequency, resonance):
+    angle = math.tau * frequency / RATE
+    cosine = math.cos(angle)
+    alpha = math.sin(angle) / (2 * 10 ** (resonance / 20))
+    a0 = 1 + alpha
+    return tuple(round(Q * value / a0) for value in ((1 - cosine) / 2, -2 * cosine, 1 - alpha))
+
+
+def lines(values, width=8):
+    return "\n".join("    " + ", ".join(map(str, values[i:i + width])) + ","
+                     for i in range(0, len(values), width))
+
+
+def main():
+    profiles = (.22, .25, .30)  # Buzios, Rio, Ibiza
+    output = [
+        "/* Generated by tools/mdma_lead_tables.py. */",
+        "#define LEAD_FILTER_MAX 12000u",
+        "static const int16_t lead_sine[257] = {",
+        lines([round(32767 * math.sin(math.tau * i / 256)) for i in range(257)]),
+        "};",
+        "static const uint32_t lead_brightness[129] = {",
+        lines([round(256 * 400 * 2 ** (3.2 * i / 128)) for i in range(129)]),
+        "};",
+        "static const LeadCoefficients lead_lowpass[3][241] = {",
+    ]
+    for macro in profiles:
+        output.append("  {")
+        output.extend("    {" + ", ".join(map(str, lowpass(max(10, i * 50), 1 + 9 * macro))) + "},"
+                      for i in range(241))
+        output.append("  },")
+    output.append("};")
+    output.append("static const uint32_t lead_edit_gain[129] = {")
+    output.append(lines([round(65536 * 2 ** (i / 32 - 2)) for i in range(129)]))
+    output.append("};")
+    output.append("static const uint32_t lead_res_inverse[3][4][41] = {")
+    for macro in profiles:
+        output.append("  {")
+        for mode in range(4):
+            values = []
+            for i in range(41):
+                resonance = (1 + 9 * macro) * 2 ** ((i - 20) / 10) * (.62 if mode & 1 else 1)
+                ratio = resonance if mode & 2 else 10 ** (resonance / 20)
+                values.append(round((1 << 24) / (2 * ratio)))
+            output.append("   {")
+            output.append(lines(values))
+            output.append("   },")
+        output.append("  },")
+    output.append("};")
+    TABLE.write_text("\n".join(output) + "\n", encoding="utf-8")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/mdma_mix_tables.py b/tools/mdma_mix_tables.py
new file mode 100644
index 0000000..977f650
--- /dev/null
+++ b/tools/mdma_mix_tables.py
@@ -0,0 +1,59 @@
+"""44.1 kHz fixed-point control curves from stable-v0.5."""
+import math
+from pathlib import Path
+
+tables = {}
+g, wet, damping = [], [], []
+for i in range(128):
+    x = i / 128 if i <= 64 else .5 + (i-64)/126
+    sweep = 2 * abs(x-.5)
+    high = 44100 * .45
+    cutoff = high * (18/high)**sweep if x < .5 else 18*(high/18)**sweep
+    g.append(round(65536 * math.tan(math.pi*cutoff/44100)))
+    blend = min(1, sweep/.10)
+    wet.append(round(32768*blend**2*(3-2*blend)))
+    bias = 2*x-1
+    damping.append(round(65536/(math.sqrt(.5)+(.35*bias if bias<0 else 3.3*bias*bias))))
+tables.update(mix_g=g, mix_wet=wet, mix_damp=damping,
+              mix_tanh=[round(32767*math.tanh(i*3/128)) for i in range(129)],
+              mix_phaser=[round(32768*(v-1)/(v+1)) for i in range(129)
+                          for v in [math.tan(math.pi*180*14**(i/128)/44100)]])
+dest = Path(__file__).resolve().parents[1]/'firmware/src/mdma_mix_tables.h'
+with dest.open('w') as f:
+    f.write('/* Generated by tools/mdma_mix_tables.py. */\n')
+    for name, values in tables.items():
+        f.write(f'static const int32_t {name}[] = {{\n')
+        for i in range(0,len(values),12):
+            f.write('    '+', '.join(map(str,values[i:i+12]))+',\n')
+        f.write('};\n')
+with dest.open('a') as f:
+    for name, vals in [('octave_ratio',[round(65536*2**(i/256)) for i in range(257)]),
+                       ('log_fraction',[round(65536*math.log2(1+i/256)) for i in range(257)])]:
+        f.write(f'static const uint32_t {name}[] = {{\n')
+        for i in range(0,len(vals),12):
+            f.write('    '+', '.join(map(str,vals[i:i+12]))+',\n')
+        f.write('};\n')
+def compressor(th, knee, ratio, amp):
+    def reduction(level):
+        o = level-th
+        if knee and abs(o)*2<=knee:
+            return (1/ratio-1)*(o+knee/2)**2/(2*knee)
+        return (1/ratio-1)*max(0,o)
+    return 10**((reduction(20*math.log10(max(1e-9,amp)))-.6*reduction(0))/20)
+with dest.open('a') as f:
+    for i, spec in enumerate([(-20,10,3),(-12,30,3),(-3,0,20)]):
+        f.write(f'static const int32_t mix_comp{i}[] = {{\n')
