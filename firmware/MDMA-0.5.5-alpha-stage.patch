+    uint32_t start_inc,goal_inc,glide_age,glide_len,env_age,env_len;
+    int32_t pitch_log,cut_log,cut_delta;
+    unsigned base,top,res100,attack,gate_len,gain,target_gain,release;
+    bool held;
+} Acid;
+static Acid acid;
+static void acid_note(unsigned inc,unsigned base,unsigned top,unsigned decay,unsigned res,bool fresh,
+                      unsigned glide,unsigned attack,unsigned level,unsigned duration)
+{
+    if(fresh || inc!=acid.goal_inc){
+        acid.start_inc=fresh&&acid.held?inc*2u:(bass_inc?bass_inc:inc);
+        acid.goal_inc=inc;acid.glide_age=0;acid.glide_len=glide;
+        acid.pitch_log=voice_log(inc)-voice_log(acid.start_inc);
+    }
+    acid.base=base;acid.top=top;acid.cut_log=voice_log(base)-voice_log(top);
+    acid.env_age=0;acid.env_len=decay>750?decay:750;
+    acid.res100=res;acid.gate_len=duration;
+    if(fresh){acid.gain=0;acid.attack=attack;acid.target_gain=level;}
+    acid.release=acid.held?3528:1323;
+}
+static unsigned acid_tick,duck_left,synth_duck_left;
+static int32_t acid_render(bool enabled)
+{
+    if(!enabled){acid.held=false;acid.gate_len=0;acid.attack=0;}
+    if(acid.attack && enabled){
+        acid.gain+=(acid.target_gain-acid.gain)/acid.attack;
+        --acid.attack;
+    }else if(!(enabled&&acid.held)&&!acid.gate_len){
+        unsigned loss=acid.gain/(acid.release?acid.release:1323);
+        acid.gain=acid.gain>loss+1?acid.gain-loss-1:0;
+    }
+    if(acid.gate_len)--acid.gate_len;
+    if(!acid.gain)return 0;
+    if(acid.glide_age<acid.glide_len){
+        unsigned u=acid.glide_age++*65536u/acid.glide_len;
+        bass_inc=voice_scale(acid.start_inc,voice_exp((int32_t)((int64_t)acid.pitch_log*u>>16)));
+    }else bass_inc=acid.goal_inc;
+    unsigned age=acid.env_age>>8;
+    if(!(acid_tick++&7u)){
+        int32_t cut=acid.base;
+        if(age<529)cut+=(int32_t)(acid.top-acid.base)*(int32_t)age/529;
+        else if(age<acid.env_len){
+            unsigned u=(age-529)*65536u/(acid.env_len-529);
+            cut=(int32_t)voice_scale(acid.top,voice_exp((int32_t)((int64_t)acid.cut_log*u>>16)));
+        }
+        const unsigned mode=voice_mode[1];
+        int32_t delta=(int32_t)((int64_t)(cut-(int32_t)acid.base)*voice_gain[1][2]>>16);
+        cut=(int32_t)acid.base+((mode&4)?-3*delta/4:delta);
+        cut=(int32_t)voice_scale(cut<20?20u:(unsigned)cut,voice_gain[1][0]);
+        const unsigned q=voice_inv_q(acid.res100,voice_gain[1][1],mode&2,mode&1);
+        voice_filter_set(&acid.first,(mode&1)?2:0,(unsigned)cut,q);
+        voice_filter_set(&acid.second,0,(unsigned)cut,voice_inv_q(acid.res100,voice_gain[1][1],mode&2,false));
+        if(!acid.hp.b0)voice_filter_set(&acid.hp,1,110,32768);
+    }
+    if(age<acid.env_len)acid.env_age+=((voice_mode[1]&8)?27682406u:16777216u)/voice_gain[1][3];
+    const unsigned lo=bass_inc-voice_scale(bass_inc,227),hi=bass_inc+voice_scale(bass_inc,228);
+    bass_phase+=lo;bass_phase2+=hi;bass_sub_phase+=bass_inc;
+    int32_t x=(lead_saw(bass_phase,lo)+lead_saw(bass_phase2,hi))*32/100;
+    x=voice_filter(&acid.second,voice_filter(&acid.first,x));
+    x=signed_tanh(qa_clip16(x)*11/10)*32768/26231;
+    x=voice_filter(&acid.hp,x)+lead_sin(bass_sub_phase)*3/10;
+    unsigned gain=acid.gain>>9;
+    if(duck_left)gain=gain*(32768u-duck_left*25559u/9702u)>>15;
+    return (int32_t)(((int64_t)x*gain*city_timbres[voice_bank[1]].acidLvl)>>31);
+}
diff --git a/firmware/src/mdma_backup.c b/firmware/src/mdma_backup.c
new file mode 100644
index 0000000..561ab08
--- /dev/null
+++ b/firmware/src/mdma_backup.c
@@ -0,0 +1,49 @@
+/* USB MIDI System Exclusive, noncommercial ID. Transfers are staged in RAM. */
+static int mdma_backup_service(void)
+{
+    const uint8_t *msg;
+    uint32_t n;
+    if(!ota_frame_get(&msg,&n)||n<6||msg[0]!=0x7d||msg[1]!=77||msg[2]!=68||msg[3]!=77||msg[4]!=65)return false;
+    static uint8_t snapshot[GROOVE_RECORD];
+    static unsigned offset,last_ms,session;
+    if(fm1_ms-last_ms>30000)session=0;
+    const unsigned op=msg[5];
+    unsigned at=n>=8?(unsigned)msg[6]+((unsigned)msg[7]<<7):0;
+    uint8_t reply[160]={0xf0,0x7d,77,68,77,65,0,0,0,0};
+    unsigned size=10,status=0;
+    reply[6]=(uint8_t)op;reply[8]=at&127;reply[9]=(at>>7)&127;
+    if(op==1 && n==6){
+        groove_encode(snapshot);session=1;
+        reply[size++]=GROOVE_RECORD&127;reply[size++]=(GROOVE_RECORD>>7)&127;
+        uint32_t crc=mdma_crc32(snapshot,GROOVE_RECORD);
+        for(unsigned k=0;k<5;++k)reply[size++]=(crc>>(7*k))&127;
+    }else if(op==2 && n==8 && session==1 && at<GROOVE_RECORD){
+        unsigned len=GROOVE_RECORD-at;if(len>64)len=64;
+        for(unsigned k=0;k<len;k++){
+            reply[size++]=snapshot[at+k]&127;
+            reply[size++]=snapshot[at+k]>>7;
+        }
+    }else if(op==3 && n==6 && !qa_save_pending && quiet()){
+        session=2;offset=0;
+    }else if(op==4 && n>8 && n<=136 && !((n-8)&1) && session==2 && at==offset && at+(n-8)/2<=GROOVE_RECORD){
+        for(unsigned k=8;k<n;k+=2)if(msg[k+1]>1)status=1;
+        if(!status)for(unsigned k=8;k<n;k+=2)snapshot[offset++]=msg[k]|(msg[k+1]<<7);
+    }else if(op==5 && n==11 && session==2 && offset==GROOVE_RECORD){
+        uint32_t crc=0;
+        for(unsigned k=0;k<5;++k)crc|=(uint32_t)msg[6+k]<<(7*k);
+        if(!groove_save_ready||!quiet()||mdma_store_pending(&groove_store)||mdma_crc32(snapshot,offset)!=crc||
+           !groove_decode(snapshot,offset,false))status=1;
+        else if(mdma_store_request(&groove_store,0,snapshot,offset)){
+            groove_decode(snapshot,offset,true);queued_city=CITY_COUNT;
+            qa_save_pending=true;panel_show();session=0;
+        }else status=1;
+    }else if(op==6 && n==6){
+        if(mdma_store_pending(&groove_store))status=2;
+        else if(!groove_save_ready)status=1;
+    }else status=1;
+    last_ms=fm1_ms;
+    ota_frame_done();
+    reply[7]=(uint8_t)status;reply[size++]=0xf7;
+    ota_wire_send(reply,size);
+    return true;
+}
