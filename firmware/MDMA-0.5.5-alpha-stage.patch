+    if (buttons & (1u << BTN_FX)) mask ^= GROOVE_DRUMS;
+    if (buttons & (1u << BTN_SEQ)) mask ^= GROOVE_BASS;
+    if (buttons & (1u << BTN_EDIT)) mask ^= GROOVE_PLUCK;
+    if (buttons & (1u << BTN_LFO)) mask ^= GROOVE_LEAD;
+    if (buttons & (1u << BTN_ENV)) mask ^= GROOVE_AMB;
