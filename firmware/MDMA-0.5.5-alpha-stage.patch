--- /dev/null
+++ b/firmware/src/mdma_lead.c
@@ -0,0 +1,303 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* stable-v0.5 HAND/GHOST: polyBLEP saws, RBJ low-pass and exponential glide. */
+typedef struct { int32_t b0, a1, a2; } LeadCoefficients;
+#include "mdma_lead_tables.h"
+
+enum { LEAD_ONE = 1 << 24, LEAD_SILENCE = 1678, GHOST_CONTROL_FRAMES = 480 };
+
+typedef struct {
+    uint32_t phase[3], increment[3];
+    int32_t pitch, cutoff, gain, z1, z2;
+    int32_t target_pitch, target_cutoff;
+    uint32_t pitch_remainder, cutoff_remainder, gain_remainder;
+    LeadCoefficients filter;
+    int32_t linear_target, linear_step, linear_error, linear_fraction;
+    unsigned update, linear_remaining, linear_length;
+    bool bandpass;
+} LeadVoice;
+
+static LeadVoice lead_ghost = {.pitch = 21426141, .cutoff = 800 * 256};
+static LeadVoice lead_hand = {.pitch = 21426141, .cutoff = 800 * 256};
+enum { LEAD_EDIT_CUTOFF, LEAD_EDIT_RES, LEAD_EDIT_GLIDE, LEAD_EDIT_RATE, LEAD_EDIT_COUNT };
+static volatile uint32_t lead_edits; /* four signed detents, then four mode bits */
+static uint32_t lead_modes;
+static int32_t lead_edit_state[LEAD_EDIT_COUNT];
+static uint32_t lead_edit_gains[LEAD_EDIT_COUNT] = {65536u,65536u,65536u,65536u};
+static uint32_t lead_glide_ghost = 81157u, lead_glide_hand = 347771u;
+static unsigned lead_edit_frames, ghost_frames, ghost_degree;
+static unsigned lead_step, lead_alien_mix = 32768u;
+static unsigned ghost_sync_slot = ~0u;
+static uint64_t ghost_time_q24;
+static uint32_t ghost_time_remainder;
+static volatile uint32_t ghost_auto_q15 = 16384u;
+static volatile int32_t lead_macro_offset; /* relative to the live automatic brightness, as in stable */
+static int32_t lead_profile_brightness = -1;
+static uint32_t lead_profile_speed;
+static bool lead_alien,ghost_grid;
+static uint32_t lead_hand_pitch, lead_hand_previous_pitch;
+static bool lead_hand_previous_gate;
+static int32_t lead_hand_brightness;
+
+static int32_t lead_edit_detent(uint32_t packed, unsigned parameter)
+{
+    const int32_t code = (int32_t)(packed >> (parameter * 6u) & 63u);
+    return code >= 32 ? code - 64 : code;
+}
+
+static int32_t lead_sin(uint32_t phase)
+{
+    const unsigned index = phase >> 24;
+    const unsigned fraction = (phase >> 16) & 255u;
+    return lead_sine[index] +
+           ((lead_sine[index + 1] - lead_sine[index]) * (int32_t)fraction >> 8);
+}
+
+static int32_t lead_cutoff(unsigned brightness)
+{
+    if (brightness >= 32768u) return (int32_t)lead_brightness[128];
+    const unsigned index = brightness >> 8, fraction = brightness & 255u;
+    return (int32_t)(lead_brightness[index] +
+                    ((lead_brightness[index + 1] - lead_brightness[index]) * fraction >> 8));
+}
+
+static unsigned lead_scale_degree(unsigned degree, unsigned config)
+{
+    static const uint8_t scale[2][7] = {{0,2,3,5,7,8,10}, {0,2,4,5,7,9,11}};
+    return 33u + 12u * (degree / 7u) + scale[(config >> 4) & 1u][degree % 7u] + (config & 15u);
+}
+
+static unsigned lead_unit_q15(int32_t value)
+{
+    return value < 0 ? 0u : value > 32768 ? 32768u : (unsigned)value;
+}
+
+static uint32_t lead_gain_at(int32_t value)
+{
+    const unsigned position = lead_unit_q15((value + 32768) / 2);
+    const unsigned index = position >> 8;
+    if (index >= 128u) return lead_edit_gain[128];
+    return lead_edit_gain[index] +
+           ((lead_edit_gain[index + 1] - lead_edit_gain[index]) * (position & 255u) >> 8);
+}
+
+static void lead_update_edits(void)
+{
+    if (!lead_edit_frames) {
+        const uint32_t packed = lead_edits;
+        lead_modes = packed >> 24;
+        for (unsigned i = 0; i < LEAD_EDIT_COUNT; ++i) {
+            const int32_t target = lead_edit_detent(packed, i) * 8192 / 5; /* 0.05 in Q15 */
+            const int32_t distance = target - lead_edit_state[i];
+            if (!distance) continue;
+            const int32_t change = distance * 950 / 32768;
+            lead_edit_state[i] += change ? change : (distance > 0 ? 1 : -1);
+            lead_edit_gains[i] = lead_gain_at(lead_edit_state[i]);
+        }
+        const uint32_t inverse = lead_gain_at(-lead_edit_state[LEAD_EDIT_GLIDE]);
+        lead_glide_ghost = (uint32_t)(((uint64_t)81157u * inverse) >> 16);
+        lead_glide_hand = (uint32_t)(((uint64_t)347771u * inverse) >> 16);
+        lead_edit_frames = 32;
+    }
+    --lead_edit_frames;
+}
+
+static void lead_ghost_advance(unsigned frames, unsigned profile, unsigned tuning)
+{
+    static const uint32_t speed_q24[] = {15916265u,17858343u,20037390u};
+    const uint32_t speed = (uint32_t)(((uint64_t)(lead_profile_speed ? lead_profile_speed : speed_q24[profile]) * lead_edit_gains[LEAD_EDIT_RATE]) >> 16);
+    const uint32_t scaled = speed / 44100u;
+    const uint32_t fraction = frames * (speed - scaled * 44100u) + ghost_time_remainder;
+    const uint32_t carry = fraction / 44100u;
+    ghost_time_remainder = fraction - carry * 44100u;
+    ghost_time_q24 += frames * scaled + carry;
+    /* Radians to a full phase turn. Q16 slope times seconds Q24. */
+    const uint32_t x_phase = (uint32_t)(ghost_time_q24 * 293719u >> 16);
+    const uint32_t x_offset = (uint32_t)(ghost_time_q24 * 133509u >> 16);
+    const uint32_t y_phase = (uint32_t)(ghost_time_q24 * 213614u >> 16);
+    const int32_t movement = lead_sin(x_phase) * lead_sin(x_offset + 1757307100u) >> 15;
+    const unsigned x = (unsigned)(16384 + (movement * 14746 >> 15));
+    unsigned candidate = (unsigned)(((uint64_t)x * 1833697u) >> 32);
+    if(ghost_grid){
+        candidate=candidate*9u/13u;
+        if(!(lead_step&3u)){
+            static const uint8_t chord[]={0,0,2,2,4,4,7,7,7,9};
+            candidate=chord[candidate];
+        }
+    }
+    if (ghost_grid || (lead_modes & (1u << LEAD_EDIT_RATE))) {
+        const unsigned shift = (unsigned)((81920 - 2 * lead_edit_state[LEAD_EDIT_RATE]) >> 15);
+        const unsigned slot = lead_step >> shift;
+        if (slot != ghost_sync_slot) ghost_degree = candidate;
+        ghost_sync_slot = slot;
+    } else {
+        ghost_degree = candidate;
+        ghost_sync_slot = ~0u;
+    }
+    ghost_auto_q15 = (unsigned)(16384 + (lead_sin(y_phase + 1367130551u) * 12452 >> 15));
+    const unsigned brightness = lead_unit_q15((int32_t)ghost_auto_q15 + lead_macro_offset);
+    lead_alien_mix = 32768u;
+    lead_ghost.target_cutoff = lead_cutoff(brightness);
+    if (lead_alien) {
+        static const uint8_t phrase[] = {0, 4, 6, 4, 2, 4, 7, 6};
+        static const unsigned accent[] = {32768, 19005, 27197, 7209};
+        const unsigned pulse = (lead_step - 1u) & 31u;
+        const unsigned position = pulse / 4u;
+        ghost_degree = phrase[position] + ((lead_step / 32u & 3u) == 3u && position == 6u ? 2u : 0u);
+        lead_alien_mix = accent[pulse & 3u];
+        const int32_t colour = 21299 + (int32_t)(lead_alien_mix * 14746u >> 15);
+        lead_ghost.target_cutoff = (int32_t)(((int64_t)lead_ghost.target_cutoff * colour) >> 15);
+    }
+    lead_ghost.target_pitch = (int32_t)groove_inc(lead_scale_degree(ghost_degree, tuning));
+}
+
+static int32_t lead_smooth(int32_t current, int32_t target, unsigned coefficient,
+                           uint32_t *remainder)
+{
+    const int64_t delta = (int64_t)(target - current) * coefficient + *remainder;
+    *remainder = (uint32_t)delta & ((1u << 30) - 1u);
+    return current + (int32_t)(delta >> 30);
+}
+
+static int32_t lead_coeff_lerp(int32_t a, int32_t b, unsigned fraction)
+{
+    return a + (int32_t)(((int64_t)(b - a) * fraction) >> 8);
+}
+
+static int32_t lead_biquad_multiply(int32_t signal, int32_t coefficient)
+{
+    return (int32_t)(((int64_t)signal * coefficient) >> 28);
+}
+
+static void lead_voice_coefficients(LeadVoice *v, unsigned profile)
+{
+    const uint32_t cutoff = (uint32_t)(((uint64_t)v->cutoff * lead_edit_gains[LEAD_EDIT_CUTOFF]) >> 16);
+    const bool band = lead_modes & (1u << LEAD_EDIT_CUTOFF);
+    v->bandpass = band;
+    const bool soft = lead_modes & (1u << LEAD_EDIT_RES);
+    const int32_t position = lead_edit_state[LEAD_EDIT_RES] * 10 + 20 * 16384;
+    const unsigned index = (unsigned)position >> 14;
+    const unsigned fraction = (unsigned)position & 16383u;
+    if (!band && !soft && !lead_edit_state[LEAD_EDIT_RES] && cutoff <= LEAD_FILTER_MAX * 256u) {
+        const unsigned bin = (cutoff / 50u) >> 8;
+        const LeadCoefficients *a = &lead_lowpass[profile][bin];
+        const LeadCoefficients *b = bin < LEAD_FILTER_MAX / 50u ? a + 1 : a;
+        const unsigned blend = cutoff / 50u & 255u;
+        v->filter = (LeadCoefficients){lead_coeff_lerp(a->b0, b->b0, blend),
+                                     lead_coeff_lerp(a->a1, b->a1, blend),
+                                     lead_coeff_lerp(a->a2, b->a2, blend)};
+        return;
+    }
+
+    const uint32_t limited = cutoff > 21609u * 256u ? 21609u * 256u : cutoff < 2560u ? 2560u : cutoff;
+    const uint32_t angle = (uint32_t)(((uint64_t)limited * 389566u) >> 10);
+    const int32_t half_sine = lead_sin(angle >> 1);
+    const int32_t sin_squared = half_sine * half_sine >> 2; /* Q28 */
+    const uint32_t *coeff = lead_res_inverse[profile][(band ? 2u : 0u) | soft];
+    const int32_t a = (int32_t)coeff[index], b = (int32_t)coeff[index < 40u ? index + 1u : index];
+    const int32_t inv_q = a + (int32_t)(((int64_t)(b - a) * fraction) >> 14);
+    const int32_t alpha = (int32_t)(((int64_t)lead_sin(angle) * inv_q) >> 11);
+    const int32_t one = 1 << 28, a0 = one + alpha;
+    int32_t reciprocal = one / 2;
+    for (unsigned i = 0; i < 5; ++i)
+        reciprocal = lead_biquad_multiply(reciprocal, 2 * one - lead_biquad_multiply(a0, reciprocal));
+    v->filter = (LeadCoefficients){lead_biquad_multiply(band ? alpha : sin_squared, reciprocal),
+        lead_biquad_multiply(4 * sin_squared - 2 * one, reciprocal),
+        lead_biquad_multiply(one - alpha, reciprocal)};
+}
+
+static int32_t lead_saw(uint32_t phase, uint32_t increment)
+{
+    int32_t signal = (int32_t)(phase >> 16) - 32768;
+    const uint32_t distance = phase < increment ? phase : 0u - phase;
+    if (distance < increment && increment >= 65536u) {
+        const unsigned t = (distance >> 4) / (increment >> 16);
+        const int32_t remaining = t < 4096u ? 4096 - (int32_t)t : 0;
+        const int32_t correction = remaining * remaining >> 9;
+        signal += phase < increment ? correction : -correction;
+    }
+    return signal;
+}
+
+static int32_t lead_voice_run(LeadVoice *v, unsigned profile, int32_t gain, unsigned pitch_glide,
+                              unsigned cutoff_glide, unsigned envelope, unsigned default_glide)
+{
+    if (!gain && v->gain < LEAD_SILENCE) {
+        v->gain = 0;
+        return 0;
+    }
+    if (lead_modes & (1u << LEAD_EDIT_GLIDE)) {
+        if (v->linear_target != v->target_pitch) {
+            v->linear_target = v->target_pitch;
+            v->linear_remaining = (default_glide * lead_edit_gains[LEAD_EDIT_GLIDE] + 32768u) >> 16;
+            if (!v->linear_remaining) v->linear_remaining = 1;
+            v->linear_length = v->linear_remaining;
+            const int32_t delta = v->target_pitch - v->pitch;
+            v->linear_step = delta / (int32_t)v->linear_length;
+            v->linear_fraction = delta - v->linear_step * (int32_t)v->linear_length;
+            v->linear_error = 0;
+        }
+        if (v->linear_remaining > 1) {
+            v->pitch += v->linear_step;
+            v->linear_error += v->linear_fraction;
+            const int32_t length = (int32_t)v->linear_length;
+            if (v->linear_error >= length) { ++v->pitch; v->linear_error -= length; }
+            else if (v->linear_error <= -length) { --v->pitch; v->linear_error += length; }
+            --v->linear_remaining;
+        } else {
+            v->pitch = v->target_pitch;
+        }
+    } else {
+        v->linear_target = -1;
+        v->pitch = lead_smooth(v->pitch, v->target_pitch, pitch_glide, &v->pitch_remainder);
+    }
+    v->cutoff = lead_smooth(v->cutoff, v->target_cutoff, cutoff_glide, &v->cutoff_remainder);
+    v->gain = lead_smooth(v->gain, gain, envelope, &v->gain_remainder);
+    if ((v->update++ & 7u) == 0) lead_voice_coefficients(v, profile);
+    const uint32_t pitch = (uint32_t)v->pitch;
+    v->increment[0] = pitch - (uint32_t)(((uint64_t)pitch * 16925u) >> 22);
+    v->increment[1] = pitch;
+    v->increment[2] = pitch + (uint32_t)(((uint64_t)pitch * 16993u) >> 22);
+    int32_t sum = 0;
+    for (unsigned oscillator = 0; oscillator < 3; ++oscillator) {
+        v->phase[oscillator] += v->increment[oscillator];
+        sum += lead_saw(v->phase[oscillator], v->increment[oscillator]);
+    }
+    const int32_t input = (sum * 1966) >> 5; /* 0.12 per oscillator, Q24 from Q15 */
+    const int32_t weighted = lead_biquad_multiply(input, v->filter.b0);
+    const int32_t output = weighted + v->z1;
+    v->z1 = (v->bandpass ? 0 : weighted * 2) - lead_biquad_multiply(output, v->filter.a1) + v->z2;
+    v->z2 = (v->bandpass ? -weighted : weighted) - lead_biquad_multiply(output, v->filter.a2);
+    return (int32_t)(((int64_t)output * v->gain) >> 33);
+}
+
+static int32_t lead_render(bool automatic, bool manual, unsigned profile, unsigned tuning)
+{
+    static const int32_t brightness[3] = {18022, 19661, 21299};
+    lead_update_edits();
+    if (ghost_frames == 0) {
+        lead_ghost_advance(GHOST_CONTROL_FRAMES, profile, tuning);
+        ghost_frames = GHOST_CONTROL_FRAMES;
+    }
+    --ghost_frames;
+    const int32_t target = automatic
+        ? (int32_t)(((int64_t)(manual ? 671089 : 3355443) * lead_alien_mix) >> 15) : 0;
+    if (manual && lead_hand_pitch) {
+        lead_hand.target_pitch = (int32_t)lead_hand_pitch;
+        const int32_t adjusted = (lead_profile_brightness < 0 ? brightness[profile] : lead_profile_brightness) + lead_hand_brightness;
+        lead_hand.target_cutoff = lead_cutoff((unsigned)(adjusted < 0 ? 0 : adjusted));
+        if ((!lead_hand_previous_gate || lead_hand_pitch != lead_hand_previous_pitch) &&
+            lead_hand.gain <= 838861) {
+            lead_hand.pitch = lead_hand.target_pitch;
+            lead_hand.cutoff = lead_hand.target_cutoff;
+            lead_hand.update = 0;
+        }
+    }
+    const int32_t ghost = lead_voice_run(&lead_ghost, profile, target, ghost_grid?lead_glide_ghost*6u:lead_glide_ghost, 121733,
+                                         automatic ? 60868 : 48695, ghost_grid?2205u:13230u);
+    const bool hand_on = manual && lead_hand_pitch;
+    lead_hand_previous_gate = hand_on;
+    lead_hand_previous_pitch = lead_hand_pitch;
+    const int32_t hand = lead_voice_run(&lead_hand, profile, hand_on ? 9227469 : 0,
+                                        lead_glide_hand, 304305, hand_on ? 405721 : 54105, 3087u);
+    return ghost + hand;
+}
