+++ b/firmware/src/mdma_drums.c
@@ -0,0 +1,123 @@
+/* Voices own their envelopes so overlapping claps, hats and percussion retain their tails. */
+typedef struct {
+    unsigned wait,age,len,stop,inc,target,phase;
+    int32_t volume,amp_log,start_log,freq_log;
+    unsigned transition,attack,release,gain,kind,q,send_r,send_d;
+    VoiceFilter filter;
+} DrumVoice;
+static DrumVoice drum_pool[36];
+static unsigned drum_live;
+static int32_t drum_send_r,drum_send_d;
+static int drum_shape[4]; /* signed tenths around the neutral setting */
+static int32_t drum_drive(int32_t x,unsigned gain)
+{
+    const int32_t norm=signed_tanh((int32_t)gain);
+    return norm?(int32_t)((int64_t)signed_tanh((int32_t)((int64_t)x*gain>>15))*32768/norm):x;
+}
+static void drum_start(unsigned kind,unsigned f,unsigned end,unsigned q,unsigned ms,unsigned stop,
+                       unsigned amp,unsigned delay,unsigned sweep,unsigned rev,unsigned echo)
+{
+    const unsigned lo=kind<3?0:24,hi=kind<3?24:36;
+    unsigned j=lo;
+    for(unsigned i=lo;i<hi;++i){
+        if(!drum_pool[i].len){j=i;break;}
+        if(drum_pool[i].age>drum_pool[j].age)j=i;
+    }
+    DrumVoice *v=&drum_pool[j];
+    if(!v->len)++drum_live;
+    const unsigned len=ms*441/10;
+    *v=(DrumVoice){.kind=kind,.inc=f*97392u,.target=end,.len=len,.stop=stop*441/10,.q=q,
+        .volume=(int32_t)(amp*32768/1000),.wait=delay,.transition=sweep*441/10,
+        .release=voice_exp(drum_shape[3]*65536/10),.attack=drum_shape[2]>0?(unsigned)drum_shape[2]*80:0,
+        .gain=(unsigned)(100+8*drum_shape[0]),.send_r=rev,.send_d=echo};
+    if(!v->volume)v->volume=1;
+    v->amp_log=voice_log(33)-voice_log((unsigned)v->volume);
+    v->start_log=voice_log(f);
+    v->freq_log=end?voice_log(end)-v->start_log:0;
+    if(kind<3)voice_filter_set(&v->filter,kind,f,voice_inv_q(q,65536,false,kind==2));
+}
+static void drum_hit(unsigned lane,unsigned step,unsigned delay,unsigned velocity)
+{
+    const bool kit=voice_bank[0]!=0;
+    const unsigned root=groove_inc(9+(harmonic_controls&15))/97392;
+    const unsigned k=root>=82?root/2:root;
+    switch(lane){
+    case 0:
+        drum_start(3,kit?190:125,k,0,kit?450:360,kit?460:380,kit?1100:950,delay,kit?350:300,0,0);
+        drum_start(kit?1:2,kit?2500:1800,0,70,kit?12:10,kit?32:30,kit?500:140,delay,0,0,0);
+        duck_left=kit?9702:8820;synth_duck_left=11025;
+        break;
+    case 1: case 2:{
+        const bool open=lane==2||step==14;
+        const unsigned hz=kit?7500:lane==2?6200:6500;
+        unsigned ms=open?(kit||lane==1?200:260):40;
+        drum_start(1,hz,0,70,ms,ms+20,(kit?280:lane==2?200:220)*velocity/1000,delay,0,open?10:0,0);
+        if(lane==2 && !kit)drum_start(2,10500,0,160,70,90,130*velocity/1000,delay,0,8,0);
+        break;}
+    case 3:
+        for(unsigned i=0;i<3;++i) drum_start(2,1500,0,90,20,40,kit?500:360,delay+485*i,0,0,0);
+        drum_start(2,1300,0,90,200,220,kit?450:300,delay+1323,0,0,25);
+        break;
+    case 4:{
+        static const unsigned freq[]={190,250,320,215,380};
+        unsigned n=step*37%5,f=kit?300+n*120:freq[n];
+        drum_start(3,kit?f:f*13/10,f,0,kit?120:200,kit?130:220,kit?180:380,delay,35,15,25);
+        drum_start(3,kit?f*159/100:f*247/100,kit?f*159/100:f*19/10,0,kit?120:70,kit?130:90,kit?180:100,delay,35,15,25);
+        drum_start(2,kit?f*5:f*7,0,kit?1000:150,kit?70:35,kit?90:55,kit?500:200,delay,0,10,15);
+        break;}
+    case 5: drum_start(2,400,5000,kit?600:300,300,320,kit?400:280,delay,300,30,20);break;
+    }
+}
+static int32_t drum_sample_run(void)
+{
+    drum_send_r=drum_send_d=0;
+    if(!drum_live)return 0;
+    int32_t sum=0;
+    for(unsigned i=0;i<36;++i){
+        DrumVoice *v=&drum_pool[i];
+        if(!v->len)continue;
+        if(v->wait){--v->wait;continue;}
+        unsigned age=v->age>>8;
+        if(age>=v->stop){v->len=0;--drum_live;continue;}
+        unsigned u=age>=v->len?65536u:age*65536u/v->len;
+        unsigned amp=voice_scale((unsigned)v->volume,voice_exp((int32_t)((int64_t)v->amp_log*u>>16)));
+        unsigned hz=v->inc/97392u;
+        if(v->target && !(age&7u)){
+            unsigned t=age>=v->transition?65536u:age*65536u/v->transition;
+            hz=voice_exp(v->start_log-16*65536+(int32_t)((int64_t)v->freq_log*t>>16));
+            if(v->kind<3)voice_filter_set(&v->filter,v->kind,hz,voice_inv_q(v->q,65536,false,v->kind==2));
+            else v->inc=hz*97392u;
+        }
+        int32_t wave;
+        if(v->kind==3){v->phase+=v->inc;wave=lead_sin(v->phase);}
+        else wave=voice_filter(&v->filter,(int32_t)melody_random()-32768);
+        int32_t val=(int32_t)((int64_t)wave*amp*v->gain/100>>15);
+        unsigned window=(voice_mode[0]&4)?265:1102;
+        if(age<window){
+            int punch=lead_edit_detent(city_voice_edit[playing_city][0],2);
+            val+=((val*punch/20)*(int)(window-age)/(int)window)*((voice_mode[0]&4)?13:8)/10;
+        }
+        if(v->attack && age<v->attack)val=val*(int32_t)age/(int32_t)v->attack;
+        if(voice_mode[0]&2){
+            unsigned stop=v->len*68/100,tail=v->len*12/100+1;
+            if(age>=stop)val=0;
+            else if(stop-age<tail)val=val*(int32_t)(stop-age)/(int32_t)tail;
+        }
+        sum+=val;drum_send_r+=val*(int)v->send_r/100;drum_send_d+=val*(int)v->send_d/100;
+        unsigned rate=voice_scale(voice_gain[0][1],v->release);
+        v->age+=16777216u/rate;
+    }
+    static VoiceFilter tone;
+    static uint32_t previous=~0u;
+    uint32_t edits=city_voice_edit[playing_city][0];
+    if(lead_edit_detent(edits,0)){
+        if(previous!=edits){voice_filter_set(&tone,voice_mode[0]&1,voice_scale(1600,voice_gain[0][0]),32768);previous=edits;}
+        sum=voice_filter(&tone,sum);
+    }
+    unsigned gain=(unsigned)city_timbres[voice_bank[0]].drv/2;
+    if(gain)sum=drum_drive(sum,gain);
+    int drive=lead_edit_detent(edits,3);
+    if(drive<0)sum=(int32_t)((int64_t)sum*voice_gain[0][3]>>16);
+    if(drive>0)sum=(voice_mode[0]&8)?qa_clip16((int32_t)((int64_t)sum*voice_gain[0][3]>>16)):drum_drive(sum,voice_gain[0][3]/2);
+    return sum;
+}
