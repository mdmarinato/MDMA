+A=10**(-3/40)
+angle=math.tau*7000/44100
+c,s=math.cos(angle),math.sin(angle)
+sq=2*math.sqrt(A)*s/math.sqrt(2)
+den=A+1-(A-1)*c+sq
+shelf=[A*(A+1+(A-1)*c+sq), -2*A*(A-1+(A+1)*c), A*(A+1+(A-1)*c-sq),
+       2*(A-1-(A+1)*c), A+1-(A-1)*c-sq]
+with dest.open('a') as f:
+    for name,v in zip(['B0','B1','B2','A1','A2'],shelf):
