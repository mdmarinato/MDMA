diff --git a/tools/mdma_lead_tables.py b/tools/mdma_lead_tables.py
new file mode 100644
index 0000000..fcaddd5
--- /dev/null
+++ b/tools/mdma_lead_tables.py
@@ -0,0 +1,46 @@
+"""Generate fixed-point tables for the stable-v0.5 lead at 44.1 kHz."""
+import math
+from pathlib import Path
+
+RATE = 44100
+TABLE = Path(__file__).resolve().parents[1] / "firmware/src/mdma_lead_tables.h"
+Q = 1 << 28
+
+
+def lowpass(frequency, resonance):
+    angle = math.tau * frequency / RATE
+    cosine = math.cos(angle)
+    alpha = math.sin(angle) / (2 * 10 ** (resonance / 20))
+    a0 = 1 + alpha
+    return tuple(round(Q * value / a0) for value in ((1 - cosine) / 2, -2 * cosine, 1 - alpha))
+
+
+def lines(values, width=8):
+    return "\n".join("    " + ", ".join(map(str, values[i:i + width])) + ","
+                     for i in range(0, len(values), width))
+
+
+def main():
+    profiles = (.22, .25, .30)  # Buzios, Rio, Ibiza
+    output = [
+        "/* Generated by tools/mdma_lead_tables.py. */",
+        "#define LEAD_FILTER_MAX 12000u",
+        "static const int16_t lead_sine[257] = {",
+        lines([round(32767 * math.sin(math.tau * i / 256)) for i in range(257)]),
+        "};",
+        "static const uint32_t lead_brightness[129] = {",
+        lines([round(256 * 400 * 2 ** (3.2 * i / 128)) for i in range(129)]),
+        "};",
+        "static const LeadCoefficients lead_lowpass[3][241] = {",
+    ]
+    for macro in profiles:
+        output.append("  {")
+        output.extend("    {" + ", ".join(map(str, lowpass(max(10, i * 50), 1 + 9 * macro))) + "},"
+                      for i in range(241))
+        output.append("  },")
+    output.append("};")
+    TABLE.write_text("\n".join(output) + "\n", encoding="utf-8")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/mdma_patterns.cjs b/tools/mdma_patterns.cjs
new file mode 100644
index 0000000..d88f29d
--- /dev/null
+++ b/tools/mdma_patterns.cjs
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+const fs = require('node:fs');
+const vm = require('node:vm');
+
+const html = fs.readFileSync(process.argv[2], 'utf8');
+const engine = html.match(/<script[^>]+id="eng"[^>]*>([\s\S]*?)<\/script>/)[1];
+const marker = '  function build(b, v) {';
+if (!engine.includes(marker)) throw new Error('Gerador da stable-v0.5 não encontrado');
+const moduleBox = {exports: {}};
+const source = engine.replace(marker, '  return { buildFull, seed: P.seed };\n' + marker);
+vm.runInThisContext('(function(module){' + source + '\n})')(moduleBox);
+const {buildFull, seed} = moduleBox.exports(44100);
+const rows = ['kick', 'hat', 'open', 'clap', 'perc', 'noise'];
+const mask = values => values.reduce((bits, value, step) => bits | (value ? 1 << step : 0), 0);
+const literal = values => '{' + values.join(', ') + '}';
+const table = (name, type, row) => {
+  const cities = Array.from({length: 3}, (_, city) => {
+    const scenes = Array.from({length: 4}, (_, scene) => {
+      const variations = Array.from({length: 8}, (_, variation) =>
+        '            ' + row(layer => buildFull(scene, variation, [0, 2, 1][city], layer, seed)));
+      return '        {\n' + variations.join(',\n') + '\n        }';
+    });
+    return '    {\n' + scenes.join(',\n') + '\n    }';
+  });
+  return 'static const ' + type + ' ' + name + '[3][4][8] = {\n' + cities.join(',\n') + '\n};\n';
+};
+const header = '/* Generated from stable-v0.5.html by tools/mdma_patterns.cjs. */\n';
+const drums = table('groove_patterns', 'GroovePattern', get => {
+  const drum = get(0), bass = get(1);
+  const notes = bass.bass_notes.map((note, i) => note < 0 ? note : note + bass.bass_octave[i] * 12);
+  return literal([literal(rows.map(row => mask(drum[row]))), literal(notes),
+    mask(bass.bass_accent), mask(bass.bass_slide)]);
+});
+const melody = table('melody_patterns', 'MelodyPattern', get => {
+  const pluck = get(2), lead = get(3), amb = get(4), sparks = get(5);
+  return literal([pluck.pluck_notes, pluck.pluck_density, lead.lead_notes, lead.lead_timbre,
+    amb.amb_mode, amb.amb_br, sparks.spk_pitch, sparks.spk_density, sparks.spk_pan].map(literal));
+});
+fs.writeFileSync('firmware/src/mdma_groove_patterns.h', header + drums);
+fs.writeFileSync('firmware/src/mdma_melody_patterns.h', header + melody);
