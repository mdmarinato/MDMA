+                    ++city_switch_serial;
+                }
+                pattern_city = playing_city;
+                if (pattern_city != active_city) {
+                    for (unsigned layer = 0; layer < LAYER_COUNT; ++layer) {
+                        patterns &= ~(3u << (18 + 2 * layer));
+                        patterns |= (uint32_t)layer_origin[pattern_city][layer] << (18 + 2 * layer);
