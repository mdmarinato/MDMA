+static int tempo_direction, tempo_start;
+static uint32_t tempo_at;
+
+static unsigned city_turn(unsigned city, int32_t direction)
+{
+    static const unsigned order[] = {0, 2, 1};
+    return order[(order[city] + direction % (int32_t)CITY_COUNT + CITY_COUNT) % CITY_COUNT];
+}
+
+static void panel_city_poll(void)
+{
+    if (queued_city >= CITY_COUNT) return;
+    if (city_switch_serial != observed_city_switch || (!groove_enabled && !qa_running)) {
+        observed_city_switch = city_switch_serial;
+        city_select(playing_city == queued_city ? playing_city : queued_city, true);
+        queued_city = CITY_COUNT;
+        panel_dirty = true;
+    }
+}
+
+static unsigned before_break = GROOVE_ALL;
+
+static void panel_set_layers(unsigned mask)
+{
+    qa_ready_mask = mask;
+    groove_enabled = !qa_source || qa_running ? mask : 0;
+}
+
+static void panel_all_layers(void)
+{
+    if (qa_ready_mask) {
+        before_break = qa_ready_mask;
+        panel_set_layers(0);
+    } else {
+        panel_set_layers(before_break);
+        before_break = GROOVE_ALL;
+    }
+}
+
+static void panel_show(void)
+{
+    panel_dirty = true;
+}
+
+static void panel_render(void)
+{
+    if (drawn_fill != fill_active) {
+        drawn_fill = fill_active;
+        if (page == PAGE_HOME) panel_dirty = true;
+    }
+    if (!panel_dirty) return;
+    panel_dirty = false;
+    groove_show_settings();
+
+    cv_begin(240, 56, C_BLACK);
+    cv_text(4, 2, &FONT_S, page_label[page], C_ACC);
+    if (page <= PAGE_SEQ) {
+        cv_text(70, 2, &FONT_S, page == PAGE_SEQ ? layer_label[seq_layer] : layer_label[selected_layer], C_WHITE);
+        if (page != PAGE_SEQ && (qa_ready_mask & (1u << selected_layer)))
+            cv_rect(222, 8, 8, 8, C_ACC);
+    }
+    if (page == PAGE_SCL) {
+        static const char *const notes[] = {"C","C#","D","D#","E","F","F#","G","G#","A","A#","B"};
+        cv_text(4, 22, &FONT_S, "TOM", C_WHITE);
+        cv_text(52, 22, &FONT_S, notes[city_tonic[active_city]], C_ACC);
+        cv_text(96, 22, &FONT_S, city_major[active_city] ? "MAJOR" : "MINOR", C_ACC);
+    } else if (page == PAGE_STAGE) {
+        static const char *const tag[] = {"DRM","BSS","PLK","LED","AMB","SPK"};
+        static const uint8_t order[] = {0,1,3,4,2,5};
+        cv_line(4, 36, 235, 36, C_OFF);
+        cv_line(119, 17, 119, 55, C_OFF);
+        cv_text(3, 16, &FONT_S, "HPF", C_OFF);
+        cv_text(209, 16, &FONT_S, "HPF", C_OFF);
+        cv_text(3, 41, &FONT_S, "LPF", C_OFF);
+        cv_text(209, 41, &FONT_S, "LPF", C_OFF);
+        cv_text(122, 15, &FONT_S, "Y", C_WHITE);
+        cv_text(228, 29, &FONT_S, "X", C_WHITE);
+        for (unsigned layer = 0; layer < LAYER_COUNT; ++layer) {
+            const uint8_t *mix = panel_mix[active_city][layer];
+            const int neutral = 44 + order[layer] * 28;
+            const int pan = (int)mix[MIX_PAN] - 64;
+            const int x = neutral + pan * (pan < 0 ? neutral - 33 : 207 - neutral) / 64;
+            const int y = 36 - ((int)mix[MIX_FLT] - 64) * 14 / 64;
+            const bool on = (qa_ready_mask & (1u << layer)) != 0;
+            const uint16_t colour = layer == selected_layer ? C_ACC : on ? C_WHITE : C_OFF;
+            cv_text(x - 10, y - 11, &FONT_S, tag[layer], colour);
+            const int width = on ? mix[MIX_VOL] * 17 / 127 : 0;
+            if (width) cv_rect(x - 8, y + 6, width, 2, colour);
+        }
+    } else if (page == PAGE_HOME || page == PAGE_FX) {
+        const uint8_t *values = page == PAGE_HOME
+            ? panel_mix[active_city][selected_layer] : panel_fx[active_city][selected_layer];
+        const char *const *labels = page == PAGE_HOME ? mix_label : fx_label;
+        for (unsigned knob = 0; knob < 4; ++knob) {
+            const int x = 4 + 60 * (int)knob;
+            const int end = x + (50 * values[knob] + 63) / 127;
+            const bool centered = page == PAGE_HOME && knob != MIX_VOL;
+            const int origin = centered ? x + 25 : x;
+            cv_text(x, 20, &FONT_S, labels[knob], C_WHITE);
+            cv_rect(x, 44, 51, 3, C_OFF);
+            cv_rect(end < origin ? end : origin, 44,
+                    end < origin ? origin - end + 1 : end - origin + 1, 3, C_ACC);
+            if (centered) cv_line(origin, 40, origin, 49, C_WHITE);
+        }
+    } else if (page == PAGE_SEQ) {
+        const GrooveEdit *edit = &groove_edits[active_city];
+        const unsigned variation = layer_variation[active_city][seq_layer];
+        const unsigned origin = layer_origin[active_city][seq_layer];
+        const unsigned slot = edit->scene + 4u * variation;
+        const GroovePattern *groove = &groove_patterns[origin][edit->scene][variation];
+        const MelodyPattern *melody = &melody_patterns[origin][edit->scene][variation];
+        char info[] = "V1";
+        info[1] = (char)('1' + variation);
+        static const char *const lanes[] = {"KICK", "HAT", "OPEN", "CLAP", "PERC", "NOISE"};
+        if (!seq_layer) cv_text(4, 19, &FONT_S, lanes[drum_lane], C_WHITE);
+        cv_text(70, 19, &FONT_S, info, C_ACC);
+        for (unsigned step = 0; step < 16; ++step) {
+            bool hit;
+            switch (seq_layer) {
+            case 0: hit = ((groove->hit[drum_lane] ^ drum_edit_mask(active_city, drum_lane, slot)) >> step) & 1u; break;
+            case 1: hit = groove->note[step] >= 0; break;
+            case 2: hit = melody->pluck[step] >= 0; break;
+            case 3: hit = melody->lead[step] >= 0; break;
+            case 4: hit = melody->amb_bright[step] > 0; break;
+            default: hit = melody->sparks_density[step] > 0; break;
+            }
+            cv_rect(2 + 15 * step, 39, 12, 11, hit ? C_ACC : C_OFF);
+        }
+    } else if (page == PAGE_SAVE) {
+        cv_text(4, 22, &FONT_S, "SAVE GROOVE", C_WHITE);
+        cv_text(4, 39, &FONT_S, save_confirm ? "CONFIRM OCT+ / CANCEL OCT-" : "OCT+ TO CONFIRM", C_ACC);
+    } else if (page == PAGE_GLO) {
+        static const char *const labels[] = {"CITY", "BPM", "CLOCK", "CHAIN", "SWING", "BPM RELEASE", "LEAD MODE"};
+        static const char *const sources[] = {"INTERNAL", "USB", "TRS"};
+        cv_text(4, 23, &FONT_S, labels[global_row], C_WHITE);
+        if (global_row == 2) cv_text(64, 23, &FONT_S, sources[qa_source], C_ACC);
+        if (global_row == 3) cv_text(64, 23, &FONT_S, qa_chain ? "ON" : "OFF", C_ACC);
+        if (global_row == 5)
+            cv_text(112, 23, &FONT_S, tempo_manual[active_city] ? "MANUAL" : "AUTO", C_ACC);
+        if (global_row == 6)
+            cv_text(96, 23, &FONT_S, city_lead_alien[active_city] ? "ALIEN" : "HOLD", C_ACC);
+        if (global_row == 4) {
+            const unsigned swing = city_swing[active_city];
+            char value[] = {(char)('0' + swing / 10), (char)('0' + swing % 10), '%', 0};
+            cv_text(64, 23, &FONT_S, value, C_ACC);
+        }
+    } else {
+        cv_text(4, 20, &FONT_S, "LEAD DRUM BASS TONE", C_WHITE);
+        const unsigned origin = layer_origin[active_city][selected_layer];
+        if (origin != active_city) cv_text(4, 39, &FONT_S, city_label[origin], C_ACC);
+    }
+    if (page == PAGE_HOME && drawn_fill) cv_text(140, 2, &FONT_S, "FILL IN", C_ACC);
+    cv_blit(0, 136);
+}
+
+/* The reference maps the eleven raised keys, left to right, to four
+ * scenes, six layers and ALL LAYERS. Internal layer indices follow MIDI. */
+static int panel_key(unsigned key)
+{
+    static const uint8_t raised[] = {1, 3, 5, 8, 10, 13, 15, 17, 20, 22, 25};
+    static const uint8_t layers[] = {0, 1, 4, 2, 3, 5};
+    for (unsigned i = 0; i < sizeof raised; ++i) {
+        if (raised[i] != key) continue;
+        if (i < 4) {
+            groove_edits[active_city].scene = (uint8_t)i;
+            groove_publish();
+        } else if (i < 10) {
+            if (page != PAGE_SEQ) selected_layer = layers[i - 4];
+            if (page != PAGE_EDIT)
+                panel_set_layers(qa_ready_mask ^ (1u << layers[i - 4]));
+        } else {
+            panel_all_layers();
+        }
+        panel_show();
+        return 1;
+    }
+    return 0;
+}
+
+static void panel_clock(int direction)
+{
+    qa_source = (qa_source + (direction < 0 ? 2u : 1u)) % 3u;
+    qa_running=groove_enabled=qa_ticks=0;
+    qa_clock_count=qa_beat_count=0;
+    qa_clock_seen=false;
+    ++qa_start_serial;
+    panel_set_layers(qa_ready_mask);
+}
+
+static void panel_scan_knobs(void)
+{
+    const int32_t select=fm1_enc_take(ENC_SELECT);
+    if (select && page == PAGE_GLO) {
+        global_row = (unsigned)((int32_t)global_row + select % 7 + 7) % 7u;
+        panel_show();
+    } else if (select && page == PAGE_SCL) {
+        city_tonic[active_city] = (uint8_t)((city_tonic[active_city] + select % 12 + 12) % 12);
+        groove_publish();
+        panel_show();
+    } else if (select && page != PAGE_SAVE) {
+        unsigned *layer = page == PAGE_SEQ ? &seq_layer : &selected_layer;
+        *layer = (unsigned)((int32_t)*layer + select % 6 + 6) % 6u;
+        panel_show();
+    }
+    GrooveEdit *edit=&groove_edits[active_city];
+    const int32_t variation = fm1_enc_take(ENC_ALGORITHM);
+    const int32_t preset = fm1_enc_take(ENC_PRESETS);
+    if (page != PAGE_GLO && page != PAGE_SAVE) {
+        if (variation && page == PAGE_SCL) {
+            city_major[active_city] ^= (unsigned)variation & 1u;
+            groove_publish();
+            panel_show();
+        } else if (variation) {
+            const unsigned layer = page == PAGE_SEQ ? seq_layer : selected_layer;
+            uint8_t *value = &layer_variation[active_city][layer];
+            *value = (uint8_t)((*value + (uint32_t)variation) & 7u);
+            groove_publish();
+            panel_show();
+        }
+        if (preset && edit_held && page == PAGE_HOME) {
+            edit_used = true;
+            if (fm1_ms - edit_at >= 120u) {
+                uint8_t *origin = &layer_origin[active_city][selected_layer];
+                *origin = (uint8_t)city_turn(*origin, preset);
+                groove_publish();
+                panel_show();
+            }
+        } else if (preset) {
+            const unsigned city = city_turn(queued_city < CITY_COUNT ? queued_city : active_city, preset);
+            if (groove_enabled || qa_running)
+                queued_city = city == active_city ? CITY_COUNT : city;
+            else {
+                city_select(city, true);
+                panel_show();
+            }
+        }
+    }
+    for(unsigned knob=0;knob<4;knob++){
+        const int32_t motion=fm1_enc_take(ENC_KNOB1+knob);
+        if(!motion) continue;
+        if (page == PAGE_SEQ && seq_layer == 0 && knob == 0) {
+            drum_lane = (unsigned)((int32_t)drum_lane + motion % 6 + 6) % 6u;
+            panel_show();
+        } else if(page==PAGE_HOME||page==PAGE_STAGE||page==PAGE_FX){
+            uint8_t *value=page==PAGE_FX?panel_fx[active_city][selected_layer]:panel_mix[active_city][selected_layer];
+            value[knob]=groove_adjust(value[knob],motion,0,127);
+            panel_publish();
+            panel_show();
+        } else if(page==PAGE_EDIT){
+            switch(knob){
+            case 0: lead_cutoff_turn(motion); break;
+            case 1: edit->drum=groove_adjust(edit->drum,motion,0,100);break;
+            case 2: edit->bass=groove_adjust(edit->bass,motion,0,100);break;
+            case 3: edit->tone=groove_adjust(edit->tone,motion,0,100);groove_tone=edit->tone;break;
+            }
+            groove_publish();
+            panel_show();
+        }
+    }
+}
+
+static bool panel_buttons(uint32_t b, uint32_t released)
+{
+    if (b & (1u << BTN_SAVE)) {
+        page = PAGE_SAVE;
+        save_confirm = false;
+        tempo_direction = 0;
+        panel_show();
+        return false;
+    }
+    if (b & (1u << BTN_HOME)) {
+        page = page == PAGE_HOME ? PAGE_STAGE : PAGE_HOME;
+        panel_show();
+    }
+    if (b & (1u << BTN_FX)) {page = page == PAGE_FX ? PAGE_HOME : PAGE_FX; panel_show();}
+    if (b & (1u << BTN_EDIT)) {
+        edit_held = true;
+        edit_used = false;
+        edit_at = fm1_ms;
+    }
+    if (released & (1u << BTN_EDIT)) {
+        if (edit_held && !edit_used && (page != PAGE_HOME || fm1_ms - edit_at < 120u)) {
+            page = page == PAGE_EDIT ? PAGE_HOME : PAGE_EDIT;
+            panel_show();
+        }
+        edit_held = false;
+    }
+    if (b & (1u << BTN_SEQ)) {
+        seq_held = true;
+        seq_fill_gesture = page == PAGE_HOME;
+        seq_fired = false;
+        seq_at = fm1_ms;
+    }
+    if (seq_held && seq_fill_gesture && !seq_fired &&
+        (page == PAGE_HOME) && fm1_ms - seq_at >= 350u) {
+        if ((groove_enabled & GROOVE_DRUMS) && !fill_active) fill_queued = !fill_queued;
+        seq_fired = true;
+    }
+    if (released & (1u << BTN_SEQ)) {
+        if (seq_held && !seq_fired) {
+            page = page == PAGE_SEQ ? PAGE_HOME : PAGE_SEQ;
+            panel_show();
+        }
+        seq_held = false;
+    }
+    if(b & (1u<<BTN_GLO)) {page=PAGE_GLO;panel_show();}
+    const int direction = b & (1u << BTN_OCT_UP) ? 1 :
+                          b & (1u << BTN_OCT_DOWN) ? -1 : 0;
+    if (page == PAGE_SAVE) {
+        if (direction < 0) {
+            if (!save_confirm) page = PAGE_HOME;
+            save_confirm = false;
+        } else if (direction > 0) {
+            if (save_confirm) {
+                save_confirm = false;
+                panel_show();
+                return true;
+            }
+            save_confirm = true;
+        }
+        if (direction) panel_show();
+        return false;
+    }
+    if (b & (1u << BTN_SEL)) {
+        page = page == PAGE_SCL ? PAGE_HOME : PAGE_SCL;
+        panel_show();
+    }
+    if (b & (1u << BTN_PLAY)) panel_set_layers(qa_ready_mask ^ (GROOVE_DRUMS | GROOVE_BASS));
+    if (b & (1u << BTN_ARP)) panel_set_layers(qa_ready_mask ^ (1u << selected_layer));
+    if (b & (1u << BTN_REC)) qa_chain ^= 1u;
+    if (b & ((1u << BTN_SEL) | (1u << BTN_PLAY) | (1u << BTN_ARP) | (1u << BTN_REC)))
+        panel_show();
+    GrooveEdit *edit = &groove_edits[active_city];
+    if (page != PAGE_GLO) {
+        if (direction && !tempo_direction) {
+            tempo_direction = direction;
+            tempo_start = edit->bpm;
+            tempo_at = fm1_ms;
+        }
+        if (tempo_direction) {
+            const uint32_t elapsed = fm1_ms - tempo_at;
+            const unsigned button = tempo_direction > 0 ? BTN_OCT_UP : BTN_OCT_DOWN;
+            int bpm = edit->bpm;
+            if (released & (1u << button)) {
+                bpm = elapsed < 250u ? tempo_start + tempo_direction :
+                      tempo_manual[active_city] ? bpm : tempo_start;
+                tempo_direction = 0;
+            } else if (elapsed >= 250u) {
+                const int progress = elapsed >= 3250u ? 3000 : (int)elapsed - 250;
+                const int end = tempo_direction > 0 ? 240 : 60;
+                bpm = tempo_start + (end - tempo_start) * progress / 3000;
+            }
+            bpm = groove_adjust(0, bpm, 60, 240);
+            if (edit->bpm != bpm) {
+                edit->bpm = (uint8_t)bpm;
+                groove_publish();
+                panel_show();
+            }
+        }
+        return false;
+    }
+    tempo_direction = 0;
+    if (!direction) return false;
+    if (global_row == 1) {
+        edit->bpm = groove_adjust(edit->bpm, direction, 60, 240);
+        groove_publish();
+    } else if (global_row == 0) {
+        city_select(city_turn(active_city, direction), true);
+    } else if (global_row == 2) {
+        panel_clock(direction);
+    } else if (global_row == 3) {
+        qa_chain ^= 1u;
+    } else if (global_row == 4) {
+        city_swing[active_city] = groove_adjust(city_swing[active_city], direction, 0, 40);
+        groove_publish();
+    } else if (global_row == 5) {
+        tempo_manual[active_city] ^= 1u;
+    } else {
+        city_lead_alien[active_city] ^= 1u;
+    }
+    panel_show();
+    return false;
+}
diff --git a/firmware/src/mdma_qa.c b/firmware/src/mdma_qa.c
new file mode 100644
index 0000000..480b29d
--- /dev/null
+++ b/firmware/src/mdma_qa.c
@@ -0,0 +1,145 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* Lab controls, clock handoff and bounded stereo echo. */
+static volatile unsigned qa_source, qa_running, qa_chain;
+static volatile uint32_t qa_ticks, qa_start_serial, qa_external_bpm = 132;
+static unsigned qa_ready_mask = 63;
+static uint32_t qa_last_clock, qa_beat_clock;
+static unsigned qa_beat_count;
+static bool qa_clock_seen, qa_save_pending;
+typedef struct {
+    int16_t echo_l[4096], echo_r[4096], room_l[1493], room_r[1877];
+    unsigned echo_pos, room_pos_l, room_pos_r, phase;
+    int32_t phase_state[2][2];
+} LayerEffects;
+
+static LayerEffects layer_effects[LAYER_COUNT] __attribute__((section(".pool")));
+
+static void qa_echo(LayerEffects *fx, int32_t *left, int32_t *right)
+{
+    const unsigned pos = fx->echo_pos;
+    const int32_t old_l = fx->echo_l[pos], old_r = fx->echo_r[pos];
+    fx->echo_l[pos] = (int16_t)((*left >> 2) + (old_r >> 1));
+    fx->echo_r[pos] = (int16_t)((*right >> 2) + (old_l >> 1));
+    fx->echo_pos = (pos + 1u) & 4095u;
+    *left += old_l >> 1;
+    *right += old_r >> 1;
+}
+
+enum { MIX_VOL, MIX_PAN, MIX_FLT, MIX_RES, MIX_CONTROLS };
+enum { FX_REV, FX_DLY, FX_PHS, FX_SAT, FX_CONTROLS };
+static uint8_t panel_mix[CITY_COUNT][6][4], panel_fx[CITY_COUNT][LAYER_COUNT][FX_CONTROLS];
+static volatile uint16_t panel_kick[CITY_COUNT][32], panel_drum[CITY_COUNT][5][32];
+
+static uint16_t drum_edit_mask(unsigned city, unsigned lane, unsigned slot)
+{
+    return lane == 0 ? panel_kick[city][slot] : panel_drum[city][lane - 1u][slot];
+}
+static volatile uint32_t mix_controls[6], fx_controls[LAYER_COUNT];
+
+static uint32_t pack_controls(const uint8_t *v)
+{
+    return v[0] | (uint32_t)v[1]<<8 | (uint32_t)v[2]<<16 | (uint32_t)v[3]<<24;
+}
+
+static void panel_publish(void)
+{
+    for (unsigned layer = 0; layer < LAYER_COUNT; ++layer) {
+        mix_controls[layer] = pack_controls(panel_mix[active_city][layer]);
+        fx_controls[layer] = pack_controls(panel_fx[active_city][layer]);
+    }
+}
+static void panel_defaults(void)
+{
+    for(unsigned city=0;city<CITY_COUNT;city++) {
+        for(unsigned layer=0;layer<6;layer++){
+            panel_mix[city][layer][MIX_VOL]=127;
+            panel_mix[city][layer][MIX_PAN]=64;
+            panel_mix[city][layer][MIX_FLT]=64;
+            panel_mix[city][layer][MIX_RES]=0;
+        }
+        memset(panel_fx[city], 0, sizeof panel_fx[city]);
+    }
+    panel_publish();
+}
+
+typedef struct { int32_t low, prev; } MixFilter;
+static MixFilter mix_filter[6][2];
+static int32_t qa_filter(int32_t input, unsigned filter, unsigned resonance, MixFilter *m)
+{
+    const unsigned amount=filter<64?64-filter:filter-64;
+    if(!amount) {m->low=input;m->prev=input;return input;}
+    const unsigned rate=filter<64?256u-amount*4u:amount*4u;
+    const int32_t coefficient=(int32_t)(rate*rate/256u+2u);
+    const int32_t distance=input-m->low;
+    const int32_t step=distance*coefficient/256;
+    m->low+=step?step:(distance>0)-(distance<0);
+    int32_t output=filter<64?m->low:input-m->low;
+    output+=(m->low-m->prev)*(int32_t)resonance/128;
+    m->prev=m->low;
+    return output;
+}
+static void qa_effects(LayerEffects *fx, uint32_t effects, int32_t *left, int32_t *right);
+
+static void qa_layer(unsigned layer, int32_t l, int32_t r, int32_t *left, int32_t *right)
+{
+    const uint32_t values=mix_controls[layer];
+    const unsigned vol=values&127u, pan=(values>>8)&127u, filter=(values>>16)&127u, res=values>>24;
+    l=qa_filter(l,filter,res,&mix_filter[layer][0]);
+    r=qa_filter(r,filter,res,&mix_filter[layer][1]);
+    l=l*(int32_t)vol/127;
+    r=r*(int32_t)vol/127;
+    if(pan>64) l=l*(127-(int32_t)pan)/63;
+    if(pan<64) r=r*(int32_t)pan/64;
+    const uint32_t effects = fx_controls[layer];
+    if (effects && ((groove_enabled & (1u << layer)) || l || r))
+        qa_effects(&layer_effects[layer], effects, &l, &r);
+    *left += l;
+    *right += r;
+}
+
+static int16_t qa_clip16(int32_t value)
+{
+    return (int16_t)(value>32767?32767:value< -32768?-32768:value);
+}
+static void qa_effects(LayerEffects *fx, uint32_t effects, int32_t *left, int32_t *right)
+{
+    const unsigned rev=effects&127u, dly=(effects>>8)&127u, phs=(effects>>16)&127u, sat=effects>>24;
+    if(rev){
+        const int32_t l=fx->room_l[fx->room_pos_l],r=fx->room_r[fx->room_pos_r];
+        fx->room_l[fx->room_pos_l]=qa_clip16((*left>>2)+l/2+r/8);
+        fx->room_r[fx->room_pos_r]=qa_clip16((*right>>2)+r/2+l/8);
+        if(++fx->room_pos_l==1493) fx->room_pos_l=0;
+        if(++fx->room_pos_r==1877) fx->room_pos_r=0;
+        *left+=l*(int32_t)rev/127;
+        *right+=r*(int32_t)rev/127;
+    }
+    if(dly){
+        int32_t l=*left,r=*right;
+        qa_echo(fx, &l, &r);
+        *left+=(l-*left)*(int32_t)dly/127;
+        *right+=(r-*right)*(int32_t)dly/127;
+    }
+    if(phs){
+        fx->phase+=120000u;
+        const int32_t coeff=groove_triangle(fx->phase)/512;
+        int32_t *channels[]={left,right};
+        for(unsigned c=0;c<2;c++){
+            int32_t x=*channels[c];
+            for(unsigned i=0;i<2;i++){
+                const int32_t y=fx->phase_state[c][i]-x*coeff/128;
+                fx->phase_state[c][i]=x+y*coeff/128;
+                x=y;
+            }
+            *channels[c]+=(x-*channels[c])*(int32_t)phs/256;
+        }
+    }
+    if(sat){
+        int32_t *channels[]={left,right};
+        for(unsigned c=0;c<2;c++){
+            const int32_t x=*channels[c]+*channels[c]*(int32_t)sat/127;
+            const int32_t mag=x<0?-x:x;
+            const int32_t shaped=x*16000/(16000+mag);
+            *channels[c]+=(shaped-*channels[c])*(int32_t)sat/127;
+        }
+    }
+}
diff --git a/firmware/src/mdma_save_probe.c b/firmware/src/mdma_save_probe.c
new file mode 100644
index 0000000..b59cad2
--- /dev/null
+++ b/firmware/src/mdma_save_probe.c
@@ -0,0 +1,245 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#define MDMA_STORAGE_UNITY
+#include "storage.c"
+
+#define GROOVE_BASE 0xB1000u
+#define GROOVE_SECTOR 4096u
+#define GROOVE_END (GROOVE_BASE + 2u * GROOVE_SECTOR)
+#define GROOVE_LEGACY 22u
+#define GROOVE_V2 (GROOVE_LEGACY + 2u * 92u)
+#define GROOVE_CITY_BYTES (115u + 5u * 32u * 2u + LAYER_COUNT * FX_CONTROLS)
+#define GROOVE_RECORD (8u + CITY_COUNT * GROOVE_CITY_BYTES)
+_Static_assert(FL_GUARD(GROOVE_BASE, 2u * GROOVE_SECTOR), "groove pair outside app store");
+static MdmaStore groove_store;
+static bool groove_save_ready;
+static uint8_t tempo_manual[CITY_COUNT];
+
+static bool groove_read(void *ctx, uint32_t a, void *p, uint32_t n)
+{
+    (void)ctx;
+    return FL_IN(a,n,GROOVE_BASE,GROOVE_END) && st_read(a,p,n)==0;
+}
+static bool groove_write(void *ctx, uint32_t a, const void *p, uint32_t n)
+{
+    (void)ctx;
+    return FL_IN(a,n,GROOVE_BASE,GROOVE_END) && fl_write(a,p,n)==0;
+}
+static void groove_encode(uint8_t *p)
+{
+    put32(p, 0x3352474Du); /* MGR3 */
+    p[4] = active_city;
+    p[5] = p[6] = p[7] = 0;
+    for (unsigned city = 0; city < CITY_COUNT; ++city) {
+        const GrooveEdit *e = &groove_edits[city];
+        uint8_t *record = p + 8u + city * GROOVE_CITY_BYTES;
+        record[0] = e->bpm; record[1] = e->scene; record[2] = layer_variation[city][0];
+        record[3] = e->drum; record[4] = e->bass; record[5] = e->tone; record[6] = e->lead;
+        memcpy(record + 7, panel_mix[city], 24);
+        memset(record + 31, 0, 4);
+        record[31] = city_lead_alien[city];
+        memcpy(record + GROOVE_CITY_BYTES - LAYER_COUNT * FX_CONTROLS,
+               panel_fx[city], sizeof panel_fx[city]);
+        for (unsigned slot = 0; slot < 32; ++slot) {
+            const uint16_t mask = panel_kick[city][slot];
+            record[35 + 2 * slot] = (uint8_t)mask;
+            record[36 + 2 * slot] = (uint8_t)(mask >> 8);
+        }
+        memcpy(record + 99, layer_variation[city], LAYER_COUNT);
+        memcpy(record + 105, layer_origin[city], LAYER_COUNT);
+        record[111] = city_tonic[city];
+        record[112] = city_major[city];
+        record[113] = city_swing[city];
+        record[114] = tempo_manual[city];
+        for (unsigned lane = 0; lane < 5; ++lane) {
+            for (unsigned slot = 0; slot < 32; ++slot) {
+                const unsigned offset = 115u + 2u * (lane * 32u + slot);
+                const uint16_t mask = panel_drum[city][lane][slot];
+                record[offset] = (uint8_t)mask;
+                record[offset + 1] = (uint8_t)(mask >> 8);
+            }
+        }
+    }
+}
+
+static bool groove_decode(const uint8_t *p, uint32_t n, bool apply)
+{
+    if (n != GROOVE_LEGACY && n != GROOVE_V2 && n != GROOVE_RECORD) return false;
+    const unsigned version = n == GROOVE_RECORD ? 3u : n == GROOVE_V2 ? 2u : 1u;
+    const unsigned cities = version == 3u ? CITY_COUNT : 2u;
+    if (get32(p) != (0x3052474Du | version << 24) || p[4] >= cities ||
+        p[5] > (version == 1u) || p[6] || p[7]) return false;
+
+    for (unsigned city = 0; city < cities; ++city) {
+        const uint8_t *e = p + 8u + city * (version == 3u ? GROOVE_CITY_BYTES : 7u);
+        if (e[0] < 60 || e[0] > 240 || e[1] > 3 || e[2] > 7 ||
+            e[3] > 100 || e[4] > 100 || e[5] > 100 || e[6] > LEAD_CUTOFF_LAST) return false;
+        if (version != 1u) {
+            const uint8_t *ext = version == 3u ? e + 7 : p + GROOVE_LEGACY + city * 92u;
+            for (unsigned k = 0; k < 28; ++k)
+                if (ext[k] > 127) return false;
+        }
+        if (version == 3u) {
+            if (e[111] > 11 || e[112] > 1 || e[113] > 40 || e[114] > 1 || e[31] > 1) return false;
+            for (unsigned i = GROOVE_CITY_BYTES - LAYER_COUNT * FX_CONTROLS; i < GROOVE_CITY_BYTES; ++i)
+                if (e[i] > 127) return false;
+        }
+        if (version == 3u)
+            for (unsigned layer = 0; layer < LAYER_COUNT; ++layer)
+                if (e[99 + layer] > 7 || e[105 + layer] >= CITY_COUNT) return false;
+    }
+    if (!apply) return true;
+
+    active_city = p[4];
+    for (unsigned city = 0; city < cities; ++city) {
+        const uint8_t *e = p + 8u + city * (version == 3u ? GROOVE_CITY_BYTES : 7u);
+        groove_edits[city] = (GrooveEdit){e[0], e[1], e[2], e[3], e[4], e[5], e[6]};
+        for (unsigned layer = 0; layer < LAYER_COUNT; ++layer) {
+            layer_variation[city][layer] = version == 3u ? e[99 + layer] : e[2];
+            layer_origin[city][layer] = version == 3u ? e[105 + layer] : (uint8_t)city;
+        }
+        city_tonic[city] = version == 3u ? e[111] : 0;
+        city_major[city] = version == 3u ? e[112] : 0;
+        city_swing[city] = version == 3u ? e[113] : 10;
+        tempo_manual[city] = version == 3u ? e[114] : 0;
+        city_lead_alien[city] = version == 3u ? e[31] : 0;
+        for (unsigned lane = 0; lane < 5; ++lane) {
+            for (unsigned slot = 0; slot < 32; ++slot) {
+                const unsigned offset = 115u + 2u * (lane * 32u + slot);
+                panel_drum[city][lane][slot] = version == 3u
+                    ? (uint16_t)(e[offset] | (uint16_t)e[offset + 1] << 8) : 0;
+            }
+        }
+        if (version == 1u) {
+            memset(panel_fx[city], 0, sizeof panel_fx[city]);
+            for (unsigned layer = 0; layer < LAYER_COUNT; ++layer)
+                panel_fx[city][layer][FX_DLY] = p[5] ? 127 : 0;
+        } else {
+            const uint8_t *ext = version == 3u ? e + 7 : p + GROOVE_LEGACY + city * 92u;
+            memcpy(panel_mix[city], ext, 24);
+            if (version == 3u) {
+                memcpy(panel_fx[city], e + GROOVE_CITY_BYTES - LAYER_COUNT * FX_CONTROLS,
+                       sizeof panel_fx[city]);
+            } else {
+                for (unsigned layer = 0; layer < LAYER_COUNT; ++layer)
+                    memcpy(panel_fx[city][layer], ext + 24, FX_CONTROLS);
+            }
+            for (unsigned slot = 0; slot < 32; ++slot)
+                panel_kick[city][slot] = (uint16_t)(ext[28 + 2 * slot] | (uint16_t)ext[29 + 2 * slot] << 8);
+        }
+    }
+    groove_tone = groove_edits[active_city].tone;
+    lead_cutoff_turn((int32_t)groove_edits[active_city].lead - lead_cutoff_position);
+    groove_publish();
+    panel_publish();
+    return true;
+}
+enum { FLASH_UNKNOWN, FLASH_BLANK, FLASH_OWNED };
+static unsigned groove_slot(unsigned slot, uint8_t *payload, uint32_t *sequence, uint32_t *length)
+{
+    const uint32_t a=GROOVE_BASE+slot*GROOVE_SECTOR;
+    uint32_t n=0;
+    *sequence=check_slot(&groove_store,0,(uint8_t)slot,&n);
+    if(*sequence && (n==GROOVE_RECORD || n==GROOVE_V2 || n==GROOVE_LEGACY) && groove_read(0,a+MDMA_STORE_HEADER,payload,n) &&
+       groove_decode(payload,n,false)) {if(length) *length=n;return FLASH_OWNED;}
+    *sequence=0;
+    uint8_t part[128];
+    for(unsigned i=0;i<GROOVE_SECTOR;i+=sizeof part) {
+        if(!groove_read(0,a+i,part,sizeof part)) return FLASH_UNKNOWN;
+        for(unsigned j=0;j<sizeof part;j++) if(part[j]!=255) return FLASH_UNKNOWN;
+    }
+    return FLASH_BLANK;
+}
+static bool groove_erase(void *ctx,uint32_t addr)
+{
+    (void)ctx;
+    if(addr!=GROOVE_BASE && addr!=GROOVE_BASE+GROOVE_SECTOR) return false;
+    uint8_t p[GROOVE_RECORD];
+    uint32_t seq,ticks;
+    return groove_slot((addr-GROOVE_BASE)/GROOVE_SECTOR,p,&seq,0)!=FLASH_UNKNOWN &&
+           fl_erase4k(addr,&ticks)==0;
+}
+static void groove_show(const char *text)
+{
+    draw_text_box(0,196,240,&FONT_S,text,C_OFF,1);
+}
+static void groove_show_settings(void)
+{
+    const GrooveEdit *e=&groove_edits[active_city];
+    char line[]="BUZIOS S1 V1 BPM 132";
+    const char *city = city_label[active_city];
+    unsigned length = 0;
+    while (city[length]) { line[length] = city[length]; ++length; }
+    while (length < 6) line[length++] = ' ';
+    line[8]=(char)('1'+e->scene);
+    line[11]=(char)('1'+layer_variation[active_city][0]);
+    line[17]=(char)('0'+e->bpm/100);
+    line[18]=(char)('0'+e->bpm/10%10);
+    line[19]=(char)('0'+e->bpm%10);
+    groove_show(line);
+}
+static void save_probe_boot(void)
+{
+    const MdmaFlash f={groove_read,groove_write,groove_erase,0,GROOVE_BASE,GROOVE_SECTOR};
+    if(!flash_ok || !mdma_store_init(&groove_store,&f)) {
+        groove_show("SAVE UNAVAILABLE");return;
+    }
+    uint8_t a[GROOVE_RECORD],b[GROOVE_RECORD];
+    uint32_t sa,sb,na=0,nb=0;
+    const unsigned va=groove_slot(0,a,&sa,&na),vb=groove_slot(1,b,&sb,&nb);
+    groove_save_ready=va!=FLASH_UNKNOWN && vb!=FLASH_UNKNOWN;
+    if(sa||sb) {
+        groove_decode(sa>=sb?a:b,sa>=sb?na:nb,true);
+        groove_show_settings();
+    } else groove_show(groove_save_ready?"NO GROOVE SAVE":"SAVE AREA USED");
+}
+static void city_select(unsigned city, bool preserve_performance)
+{
+    if(mdma_store_pending(&groove_store)) return;
+    groove_edits[active_city].lead=(uint8_t)lead_cutoff_position;
+    const unsigned old = active_city;
+    if (preserve_performance) {
+        groove_edits[city].bpm = groove_edits[old].bpm;
+        groove_edits[city].scene = groove_edits[old].scene;
+        city_tonic[city] = city_tonic[old];
+        city_major[city] = city_major[old];
+        memcpy(layer_variation[city], layer_variation[old], LAYER_COUNT);
+    }
+    active_city = (uint8_t)city;
+    const GrooveEdit *e=&groove_edits[active_city];
+    lead_cutoff_turn((int32_t)e->lead-lead_cutoff_position);
+    groove_tone=e->tone;
+    groove_publish();
+    panel_publish();
+    groove_show_settings();
+}
+static void save_probe_poll(bool pressed)
+{
+    if(pressed && !groove_save_ready) {groove_show("SAVE BLOCKED");return;}
+    if(pressed && !mdma_store_pending(&groove_store)){
+        uint8_t p[GROOVE_RECORD];
+        groove_edits[active_city].lead=(uint8_t)lead_cutoff_position;
+        groove_encode(p);
+        if(!mdma_store_request(&groove_store,0,p,sizeof p)) {groove_show("SAVE FAIL");return;}
+        groove_enabled=0;
+        groove_show("STOPPING FOR SAVE");
+        return;
+    }
+    if(!groove_save_ready) return;
+    const MdmaStoreStep status=mdma_store_service(&groove_store,quiet()&&!fm1_in.notes);
+    if(status==MDMA_STORE_DONE){
+        uint8_t record[GROOVE_RECORD];
+        uint32_t n;
+        bool ok=mdma_store_load(&groove_store,0,record,sizeof record,&n)&&groove_decode(record,n,false);
+        for(unsigned i=0;ok&&i<GROOVE_RECORD;i++) if(record[i]!=groove_store.stage[i]) ok=false;
+        groove_show(ok?"GROOVE SAVED":"SAVE VERIFY FAIL");
+    } else if(status==MDMA_STORE_FAILED) {
+        groove_save_ready=false;
+        groove_show("SAVE FAIL");
+    }
+}
+
+static uint8_t groove_adjust(uint8_t value, int32_t delta, int lo, int hi)
+{
+    const int32_t next = (int32_t)value + delta;
+    return (uint8_t)(next < lo ? lo : next > hi ? hi : next);
+}
