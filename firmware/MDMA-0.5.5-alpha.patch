+        if (drum_env[0]) {
+            kick_inc -= (kick_inc - 4900000u) >> 8;
+            kick_phase += kick_inc;
+            drums += (groove_triangle(kick_phase) * drum_env[0]) >> 14;
+            drum_env[0] -= 1 + (drum_env[0] >> 10);
