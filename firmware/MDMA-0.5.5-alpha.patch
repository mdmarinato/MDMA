+static void groove_buttons(uint32_t buttons)
+{
+    static unsigned before_break = GROOVE_ALL;
+    if (buttons & (1u << BTN_HOME)) {
+        if (groove_enabled) {before_break = groove_enabled; groove_enabled = 0;}
+        else groove_enabled = before_break;
+        return;
+    }
+    unsigned mask = groove_enabled;
+    if (buttons & (1u << BTN_PLAY)) mask ^= GROOVE_DRUMS | GROOVE_BASS;
+    if (buttons & (1u << BTN_FX)) mask ^= GROOVE_DRUMS;
+    if (buttons & (1u << BTN_SEQ)) mask ^= GROOVE_BASS;
+    if (buttons & (1u << BTN_EDIT)) mask ^= GROOVE_PLUCK;
+    if (buttons & (1u << BTN_LFO)) mask ^= GROOVE_LEAD;
+    if (buttons & (1u << BTN_ENV)) mask ^= GROOVE_AMB;
+    if (buttons & (1u << BTN_ARP)) mask ^= GROOVE_SPARKS;
+    groove_enabled = mask;
+}
